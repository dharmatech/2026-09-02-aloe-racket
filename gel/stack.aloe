;; Gel v0 stack. Every slot is a Mirror, so the underlying List stays
;; homogeneous even as Gel moves between unrelated Aloe value types.

(load "menu.aloe")

(define-class GelStack
  (fields
    (items (List Mirror)))
  (methods
    (tos () Mirror
      ((self items) first))

    (push (value Mirror) GelStack
      (GelStack new
        ((self items) cons value)))

    (push (type T)
      (value T)
      GelStack
      (self push (Mirror of value)))

    (invoke-zero
      (row GelRow)
      GelStack
      (self push
        ((self tos) invoke (row signature))))

    (invoke-one
      (row GelRow)
      (arg Mirror)
      GelStack
      (self push
        ((self tos) invoke
          (row signature)
          (arg subject))))

    (invoke-one (type T)
      (row GelRow)
      (arg T)
      GelStack
      (self push
        ((self tos) invoke
          (row signature)
          arg)))))
