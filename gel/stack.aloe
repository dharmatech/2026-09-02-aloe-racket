;; Gel v0 stack. Every slot is a Mirror, so the underlying List stays
;; homogeneous even as Gel moves between unrelated Aloe value types.

(load "menu.aloe")

(define-class GelStack
  (fields
    (items (List Mirror)))
  (methods
    (tos () Mirror
      ((self items) first))

    (push (value Mirror) GelStack
      (GelStack new
        ((self items) cons value)))

    (push (type T)
      (value T)
      GelStack
      (self push (Mirror of value)))))

(define-class GelInvokeZero
  (fields)
  (methods
    (call (stack GelStack) (row GelRow) GelStack
      (stack push
        ((stack tos) invoke (row signature))))))

(define gel-invoke-zero (GelInvokeZero new))

(define-class GelInvokeOne
  (fields)
  (methods
    (call
      (stack GelStack)
      (row GelRow)
      (arg Mirror)
      GelStack
      (stack push
        ((stack tos) invoke (row signature) (arg subject))))

    (call (type T)
      (stack GelStack)
      (row GelRow)
      (arg T)
      GelStack
      (stack push
        ((stack tos) invoke (row signature) arg)))))

(define gel-invoke-one (GelInvokeOne new))
