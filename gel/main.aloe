;; Gel's interactive loop. The host only injects `term` and starts this call.

(load "loop.aloe")

(define-class GelMain
  (fields)
  (methods
    (call
      (stack (List Mirror))
      (List Mirror)
      (self loop
        (GelStep new stack #f (List empty) 0 #f)))

    (loop
      (state GelStep)
      (List Mirror)
      (let ((tos-written
             (term write-line
               (gel-tos-text call (state stack)))))
        (let ((menu-written
               (term write-line
                 (gel-menu-text call state))))
          (let ((key (term read-key)))
            (let ((step (gel-handle-key call state key)))
              (if (step quit)
                  (step stack)
                  (self loop step)))))))))

(define gel-main (GelMain new))
