;; Gel's interactive loop. The host only injects `term` and starts this call.

(load "loop.aloe")

(define-class GelMain
  (fields)
  (methods
    (call
      (stack GelStack)
      GelStack
      (self loop
        (GelStep new stack #f (List empty) 0 #f)))

    (start (type T)
      (value T)
      GelStack
      (self call
        (gel-empty-stack push value)))

    (loop
      (state GelStep)
      GelStack
      (let ((tos-written
             (term write-line
               (gel-text tos (state stack)))))
        (let ((menu-written
               (term write-line
                 (gel-text menu state))))
          (let ((key (term read-key)))
            (let ((echoed
                   (term write-line ("key " append key))))
              (let ((step (state handle-key key)))
                (if (step quit)
                    (step stack)
                    (self loop step))))))))))

(define gel-main (GelMain new))
