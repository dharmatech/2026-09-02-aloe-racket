;; Gel's focused live Directory surface. The disk vocabulary and generic Gel
;; application must already be loaded by the owning application and runner.

(define-class GelDirectoryBuild
  (fields
    (labels (List String))
    (rows (List GelValueRow)))
  (methods))

(define-class GelDirectoryRows
  (fields)
  (methods
    (row (type H)
      (item (Item H))
      (index Int)
      (label String)
      GelValueRow
      (item case
        (File (file)
          (GelValueRow new index (Mirror of file) label))
        (Directory (directory)
          (GelValueRow new index (Mirror of directory) label))
        (SymbolicLink (link)
          (GelValueRow new index (Mirror of link) label))
        (Other (thing)
          (GelValueRow new index (Mirror of thing) label))))

    (of (type H)
      (items (List (Item H)))
      (labels (List String))
      GelValueRows
      (let ((built
             (items fold
               (GelDirectoryBuild new labels (List empty))
               (fn (build item)
                 (GelDirectoryBuild new
                   ((build labels) rest)
                   ((build rows) cons
                     (self row
                       item
                       (((build rows) len) + 1)
                       ((build labels) first))))))))
        (GelValueRows new ((built rows) reverse))))))

(define gel-directory-rows (GelDirectoryRows new))

(define-class (GelDirectoryListing H)
  (fields
    (items (List (Item H))))
  (methods
    (name (item (Item H)) String
      (item case
        (File (file) (file name))
        (Directory (directory) (directory name))
        (SymbolicLink (link) (link name))
        (Other (thing) (thing name))))

    (label (item (Item H)) String
      (item case
        (File (file) (file name))
        (Directory (directory)
          (let ((name (directory name)))
            (if (name = "") "/" (name append "/"))))
        (SymbolicLink (link)
          ((link name) append "@"))
        (Other (thing) (thing name))))

    (values (show-hidden Bool) GelValueRows
      (let ((visible-items
             (((self items) fold
                (List empty)
                (fn (visible item)
                  (if show-hidden
                      (visible cons item)
                      (if ((self name item) starts-with? ".")
                          visible
                          (visible cons item)))))
              reverse)))
        (gel-directory-rows of
          visible-items
          (visible-items map
            (fn (item)
              (self label item))))))))

(define-methods Directory
  (methods
    (gel-tos-text () String
      (("#<Directory " append ((Mirror of (self text)) raw)) append ">"))

    (gel-directory-values () GelValueRows
      ((GelDirectoryListing new (self entries)) values #f))

    (gel-directory-all-values () GelValueRows
      ((GelDirectoryListing new (self entries)) values #t))

    (gel-up () GelUp
      ((self parent) case
        (None () (GelUp NoParent))
        (Some (parent)
          (GelUp Parent (Mirror of parent)))))))

(define-methods File
  (methods
    (gel-tos-text () String
      (("#<File " append ((Mirror of (self text)) raw)) append ">"))))

(define-methods SymbolicLink
  (methods
    (gel-tos-text () String
      (("#<SymbolicLink " append ((Mirror of (self text)) raw)) append ">"))))

(define-methods Other
  (methods
    (gel-tos-text () String
      (("#<Other " append ((Mirror of (self text)) raw)) append ">"))))
