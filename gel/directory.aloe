;; Gel's focused live Directory surface. The disk vocabulary and generic Gel
;; application must already be loaded by the owning application and runner.

(define-class GelDirectoryBuild
  (fields
    (labels (List String))
    (rows (List GelValueRow)))
  (methods))

(define-class GelDirectoryRows
  (fields)
  (methods
    (of (type H)
      (items (List (Item H)))
      (labels (List String))
      GelValueRows
      (let ((built
             (items fold
               (GelDirectoryBuild new labels (List empty))
               (fn (build item)
                 (if (((build rows) len) < (gel-item-keys len))
                     (GelDirectoryBuild new
                       ((build labels) rest)
                       ((build rows) cons
                         (let ((index (((build rows) len) + 1))
                               (label ((build labels) first)))
                           (item case
                             (File (file)
                               (GelValueRow new
                                 index
                                 (Mirror of file)
                                 label))
                             (Directory (directory)
                               (GelValueRow new
                                 index
                                 (Mirror of directory)
                                 label))
                             (SymbolicLink (link)
                               (GelValueRow new
                                 index
                                 (Mirror of link)
                                 label))
                             (Other (thing)
                               (GelValueRow new
                                 index
                                 (Mirror of thing)
                                 label))))))
                     build)))))
        (GelValueRows new ((built rows) reverse))))))

(define gel-directory-rows (GelDirectoryRows new))

(define-methods Directory
  (methods
    (gel-tos-text () String
      (("#<Directory " append ((Mirror of (self text)) raw)) append ">"))

    (gel-directory-values () GelValueRows
      (let ((items (self entries)))
        (gel-directory-rows of
          items
          (items map
            (fn (item)
              (item case
                (File (file) (file name))
                (Directory (directory)
                  (let ((name (directory name)))
                    (if (name = "") "/" (name append "/"))))
                (SymbolicLink (link)
                  ((link name) append "@"))
                (Other (thing) (thing name))))))))

    (gel-up () GelUp
      ((self parent) case
        (None () (GelUp NoParent))
        (Some (parent)
          (GelUp Parent (Mirror of parent)))))))

(define-methods File
  (methods
    (gel-tos-text () String
      (("#<File " append ((Mirror of (self text)) raw)) append ">"))))

(define-methods SymbolicLink
  (methods
    (gel-tos-text () String
      (("#<SymbolicLink " append ((Mirror of (self text)) raw)) append ">"))))

(define-methods Other
  (methods
    (gel-tos-text () String
      (("#<Other " append ((Mirror of (self text)) raw)) append ">"))))
