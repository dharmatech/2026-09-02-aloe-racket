;; Gel's pure key step. Terminal input is a skin that supplies a String.

(load "stack.aloe")

(define-class GelStep
  (fields
    (stack (List Mirror))
    (quit Bool)
    (pending (List GelRow)))
  (methods))

(define-class GelStart
  (fields)
  (methods
    (call (type T)
      (value T)
      (List Mirror)
      (gel-push call (List empty) value))))

(define gel-start (GelStart new))

(define-class GelStartTwo
  (fields)
  (methods
    (call (type Under Tos)
      (under Under)
      (tos Tos)
      (List Mirror)
      (gel-push call
        (gel-push call (List empty) under)
        tos))))

(define gel-start-two (GelStartTwo new))

(define-class GelKeyIndex
  (fields)
  (methods
    (call (key String) Int
      (cond ((key = "1") 1)
            ((key = "2") 2)
            ((key = "3") 3)
            ((key = "4") 4)
            ((key = "5") 5)
            ((key = "6") 6)
            ((key = "7") 7)
            ((key = "8") 8)
            ((key = "9") 9)
            (else 0)))))

(define gel-key-index (GelKeyIndex new))

(define-class GelSelectRow
  (fields)
  (methods
    (call
      (rows (List GelRow))
      (index Int)
      GelRow
      (let ((row
             (rows fold
               (rows first)
               (fn (found candidate)
                 (if ((candidate index) = index)
                     candidate
                     found)))))
        (if ((row index) = index)
            row
            ((List empty) first))))))

(define gel-select-row (GelSelectRow new))

;; A stack slot is already the mirror whose signatures Gel needs. Building
;; rows directly avoids wrapping that Mirror or guessing its subject's type.
(define-class GelRowsFromMirror
  (fields)
  (methods
    (call
      (mirror Mirror)
      (List GelRow)
      (((mirror signatures) fold
         (List empty)
         (fn (rows signature)
           (rows cons
             (GelRow new
               ((rows len) + 1)
               (signature selector)
               ((signature params) len)
               signature))))
       reverse))))

(define gel-rows-from-mirror (GelRowsFromMirror new))

(define-class GelPick
  (fields
    (index Int)
    (mirror Mirror))
  (methods))

(define-class GelMatchingPicks
  (fields)
  (methods
    (call
      (stack (List Mirror))
      (row GelRow)
      (List GelPick)
      ((stack fold
          (List empty)
          (fn (picks candidate)
            (if ((row signature) accepts? candidate)
                (picks cons
                  (GelPick new
                    ((picks len) + 1)
                    candidate))
                picks)))
        reverse))))

(define gel-matching-picks (GelMatchingPicks new))

(define-class GelSelectPick
  (fields)
  (methods
    (call
      (picks (List GelPick))
      (index Int)
      GelPick
      (picks fold
        (picks first)
        (fn (found candidate)
          (if ((candidate index) = index)
              candidate
              found))))))

(define gel-select-pick (GelSelectPick new))

(define-class GelMenuText
  (fields)
  (methods
    (line (row GelRow) String
      (let ((index-text ((row index) text))
            (selector-text ((row selector) name))
            (arity-text ((row arity) text)))
        (((((index-text append "  ") append selector-text)
           append "  ")
          append arity-text)
         append "\r\n")))

    (rows-text (rows (List GelRow)) String
      (rows fold ""
        (fn (text row)
          (text append (self line row)))))

    (pick-line (pick GelPick) String
      (((((pick index) text) append "  ") append
         ((pick mirror) raw))
       append "\r\n"))

    (picks-text (picks (List GelPick)) String
      (picks fold ""
        (fn (text pick)
          (text append (self pick-line pick)))))

    (pending-text (state GelStep) String
      (let ((row ((state pending) first)))
        (let ((selector-text ((row selector) name))
              (expected-text
               ((Mirror of (((row signature) params) first)) raw))
              (picks
               (gel-matching-picks call (state stack) row)))
          (let ((header
                 (((("pending " append selector-text)
                    append "  ")
                   append expected-text)
                  append "\r\n")))
            (header append (self picks-text picks))))))

    ;; A stack TOS is already a Mirror. Its rows describe the subject, not
    ;; the Mirror reflection API itself.
    (call (value Mirror) String
      (self rows-text (gel-rows-from-mirror call value)))

    (call (state GelStep) String
      (if ((state pending) empty?)
          (self call (gel-tos call (state stack)))
          (self pending-text state)))

    (call (type T)
      (value T)
      String
      (self rows-text (gel-rows call value)))))

(define gel-menu-text (GelMenuText new))

(define-class GelTosText
  (fields)
  (methods
    (call
      (stack (List Mirror))
      String
      (let ((tos (gel-tos call stack)))
        ("TOS: " append (tos raw))))))

(define gel-tos-text (GelTosText new))

(define-class GelHandleKey
  (fields)
  (methods
    (idle
      (stack (List Mirror))
      (key String)
      GelStep
      (if (key = "q")
          (GelStep new stack #t (List empty))
          (let ((rows
                 (gel-rows-from-mirror call
                   (gel-tos call stack)))
                (index (gel-key-index call key)))
            (if (index = 0)
                (GelStep new stack #f (List empty))
                (let ((row (gel-select-row call rows index)))
                  (if ((row arity) = 0)
                      (GelStep new
                        (gel-invoke-zero call stack row)
                        #f
                        (List empty))
                      (if ((row arity) = 1)
                          (GelStep new stack #f (List of row))
                          (GelStep new stack #f (List empty)))))))))

    (handle-pending
      (state GelStep)
      (key String)
      GelStep
      (if (key = "q")
          (GelStep new (state stack) #f (List empty))
          (let ((index (gel-key-index call key)))
            (if (index = 0)
                state
                (let ((row ((state pending) first)))
                  (let ((picks
                         (gel-matching-picks call
                           (state stack)
                           row)))
                    (if (index > (picks len))
                        state
                        (let ((pick
                               (gel-select-pick call picks index)))
                          (GelStep new
                            (gel-invoke-one call
                              (state stack)
                              row
                              (pick mirror))
                            #f
                            (List empty))))))))))

    (call
      (stack (List Mirror))
      (key String)
      GelStep
      (self idle stack key))

    (call
      (state GelStep)
      (key String)
      GelStep
      (if ((state pending) empty?)
          (self idle (state stack) key)
          (self handle-pending state key)))))

(define gel-handle-key (GelHandleKey new))
