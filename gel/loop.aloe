;; Gel's pure key step. Terminal input is a skin that supplies a String.

(load "stack.aloe")

(define-class GelStep
  (fields
    (stack GelStack)
    (quit Bool)
    (pending (List GelRow))
    (int-input Int)
    (has-digits Bool))
  (methods))

(define-class GelKey
  (fields
    (text String))
  (methods
    (digit-value () Int
      (cond (((self text) = "0") 0)
            (((self text) = "1") 1)
            (((self text) = "2") 2)
            (((self text) = "3") 3)
            (((self text) = "4") 4)
            (((self text) = "5") 5)
            (((self text) = "6") 6)
            (((self text) = "7") 7)
            (((self text) = "8") 8)
            (((self text) = "9") 9)
            (else -1)))

    (menu-index () Int
      (let ((digit (self digit-value)))
        (if (digit > 0) digit 0)))

    (quit? () Bool
      ((self text) = "q"))

    (return? () Bool
      ((self text) = "return"))))

(define-class GelIntHole
  (fields)
  (methods
    (call (row GelRow) Bool
      (((Mirror of (((row signature) params) first)) raw)
       = "#<Symbol Int>"))))

(define gel-int-hole? (GelIntHole new))

(define-class GelSelectRow
  (fields)
  (methods
    (call
      (rows (List GelRow))
      (index Int)
      GelRow
      (let ((row
             (rows fold
               (rows first)
               (fn (found candidate)
                 (if ((candidate index) = index)
                     candidate
                     found)))))
        (if ((row index) = index)
            row
            ((List empty) first))))))

(define gel-select-row (GelSelectRow new))

;; A stack slot is already the mirror whose signatures Gel needs. Building
;; rows directly avoids wrapping that Mirror or guessing its subject's type.
(define-class GelRowsFromMirror
  (fields)
  (methods
    (call
      (mirror Mirror)
      (List GelRow)
      (((mirror signatures) fold
         (List empty)
         (fn (rows signature)
           (rows cons
             (GelRow new
               ((rows len) + 1)
               (signature selector)
               ((signature params) len)
               signature))))
       reverse))))

(define gel-rows-from-mirror (GelRowsFromMirror new))

(define-class GelPick
  (fields
    (index Int)
    (mirror Mirror))
  (methods))

(define-class GelMatchingPicks
  (fields)
  (methods
    (call
      (stack GelStack)
      (row GelRow)
      (List GelPick)
      (((stack items) fold
          (List empty)
          (fn (picks candidate)
            (if ((row signature) accepts? candidate)
                (picks cons
                  (GelPick new
                    ((picks len) + 1)
                    candidate))
                picks)))
        reverse))))

(define gel-matching-picks (GelMatchingPicks new))

(define-class GelSelectPick
  (fields)
  (methods
    (call
      (picks (List GelPick))
      (index Int)
      GelPick
      (picks fold
        (picks first)
        (fn (found candidate)
          (if ((candidate index) = index)
              candidate
              found))))))

(define gel-select-pick (GelSelectPick new))

(define-class GelMenuText
  (fields)
  (methods
    (line (row GelRow) String
      (let ((index-text ((row index) text))
            (selector-text ((row selector) name))
            (arity-text ((row arity) text)))
        (((((index-text append "  ") append selector-text)
           append "  ")
          append arity-text)
         append "\r\n")))

    (rows-text (rows (List GelRow)) String
      (rows fold ""
        (fn (text row)
          (text append (self line row)))))

    (pick-line (pick GelPick) String
      (((((pick index) text) append "  ") append
         ((pick mirror) raw))
       append "\r\n"))

    (picks-text (picks (List GelPick)) String
      (picks fold ""
        (fn (text pick)
          (text append (self pick-line pick)))))

    (pending-text (state GelStep) String
      (let ((row ((state pending) first)))
        (let ((selector-text ((row selector) name))
              (expected-text
               ((Mirror of (((row signature) params) first)) raw))
              (picks
               (gel-matching-picks call (state stack) row)))
          (if (gel-int-hole? call row)
              (let ((digits
                     (if (state has-digits)
                         ((state int-input) text)
                         "")))
                (((("pending " append selector-text)
                   append "  Int ")
                  append digits)
                 append "\r\n"))
              (let ((header
                     (((("pending " append selector-text)
                        append "  ")
                       append expected-text)
                      append "\r\n")))
                (header append (self picks-text picks)))))))

    ;; A stack TOS is already a Mirror. Its rows describe the subject, not
    ;; the Mirror reflection API itself.
    (call (value Mirror) String
      (self rows-text (gel-rows-from-mirror call value)))

    (call (state GelStep) String
      (if ((state pending) empty?)
          (self call ((state stack) tos))
          (self pending-text state)))

    (call (type T)
      (value T)
      String
      (self rows-text (gel-rows call value)))))

(define gel-menu-text (GelMenuText new))

(define-class GelTosText
  (fields)
  (methods
    (call
      (stack GelStack)
      String
      (let ((tos (stack tos)))
        ("TOS: " append (tos raw))))))

(define gel-tos-text (GelTosText new))

(define-methods GelStep
  (methods
    (handle-idle
      (key GelKey)
      GelStep
      (if (key quit?)
          (GelStep new (self stack) #t (List empty) 0 #f)
          (let ((rows
                 (gel-rows-from-mirror call
                   ((self stack) tos)))
                (index (key menu-index)))
            (if (index = 0)
                (GelStep new (self stack) #f (List empty) 0 #f)
                (let ((row (gel-select-row call rows index)))
                  (if ((row arity) = 0)
                      (GelStep new
                        ((self stack) invoke-zero row)
                        #f
                        (List empty)
                        0
                        #f)
                      (if ((row arity) = 1)
                          (GelStep new (self stack) #f (List of row) 0 #f)
                          (GelStep new (self stack) #f (List empty) 0 #f))))))))

    (handle-int
      (row GelRow)
      (key GelKey)
      GelStep
      (if (key return?)
          (if (self has-digits)
              (GelStep new
                ((self stack) invoke-one
                  row
                  (self int-input))
                #f
                (List empty)
                0
                #f)
              self)
          (let ((digit (key digit-value)))
            (if (digit < 0)
                self
                (GelStep new
                  (self stack)
                  #f
                  (self pending)
                  (((self int-input) * 10) + digit)
                  #t)))))

    (handle-pick
      (row GelRow)
      (key GelKey)
      GelStep
      (let ((index (key menu-index)))
        (if (index = 0)
            self
            (let ((picks
                   (gel-matching-picks call
                     (self stack)
                     row)))
              (if (index > (picks len))
                  self
                  (let ((pick
                         (gel-select-pick call picks index)))
                    (GelStep new
                      ((self stack) invoke-one
                        row
                        (pick mirror))
                      #f
                      (List empty)
                      0
                      #f)))))))

    (handle-pending
      (key GelKey)
      GelStep
      (if (key quit?)
          (GelStep new (self stack) #f (List empty) 0 #f)
          (let ((row ((self pending) first)))
            (if (gel-int-hole? call row)
                (self handle-int row key)
                (self handle-pick row key)))))

    (handle-key
      (text String)
      GelStep
      (let ((key (GelKey new text)))
        (if ((self pending) empty?)
            (self handle-idle key)
            (self handle-pending key))))))
