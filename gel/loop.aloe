;; Gel's pure key step. Terminal input is a skin that supplies a String.

(load "stack.aloe")

(define-class GelStep
  (fields
    (stack (List Mirror))
    (quit Bool))
  (methods))

(define-class GelStart
  (fields)
  (methods
    (call (type T)
      (value T)
      (List Mirror)
      (gel-push call (List empty) value))))

(define gel-start (GelStart new))

(define-class GelStartTwo
  (fields)
  (methods
    (call (type Under Tos)
      (under Under)
      (tos Tos)
      (List Mirror)
      (gel-push call
        (gel-push call (List empty) under)
        tos))))

(define gel-start-two (GelStartTwo new))

(define-class GelKeyIndex
  (fields)
  (methods
    (call (key String) Int
      (cond ((key = "1") 1)
            ((key = "2") 2)
            ((key = "3") 3)
            ((key = "4") 4)
            ((key = "5") 5)
            ((key = "6") 6)
            ((key = "7") 7)
            ((key = "8") 8)
            ((key = "9") 9)
            (else 0)))))

(define gel-key-index (GelKeyIndex new))

(define-class GelSelectRow
  (fields)
  (methods
    (call
      (rows (List GelRow))
      (index Int)
      GelRow
      (let ((row
             (rows fold
               (rows first)
               (fn (found candidate)
                 (if ((candidate index) = index)
                     candidate
                     found)))))
        (if ((row index) = index)
            row
            ((List empty) first))))))

(define gel-select-row (GelSelectRow new))

;; A stack slot is already the mirror whose signatures Gel needs. Building
;; rows directly avoids wrapping that Mirror or guessing its subject's type.
(define-class GelRowsFromMirror
  (fields)
  (methods
    (call
      (mirror Mirror)
      (List GelRow)
      (((mirror signatures) fold
         (List empty)
         (fn (rows signature)
           (rows cons
             (GelRow new
               ((rows len) + 1)
               (signature selector)
               ((signature params) len)
               signature))))
       reverse))))

(define gel-rows-from-mirror (GelRowsFromMirror new))

(define-class GelMenuText
  (fields)
  (methods
    (line (row GelRow) String
      (let ((index-text ((row index) text))
            (selector-text ((row selector) name))
            (arity-text ((row arity) text)))
        (((((index-text append "  ") append selector-text)
           append "  ")
          append arity-text)
         append "\r\n")))

    (rows-text (rows (List GelRow)) String
      (rows fold ""
        (fn (text row)
          (text append (self line row)))))

    ;; A stack TOS is already a Mirror. Its rows describe the subject, not
    ;; the Mirror reflection API itself.
    (call (value Mirror) String
      (self rows-text (gel-rows-from-mirror call value)))

    (call (type T)
      (value T)
      String
      (self rows-text (gel-rows call value)))))

(define gel-menu-text (GelMenuText new))

;; Prefer a subject's own zero-argument String presentation when reflection
;; exposes one. Values such as Point have no such message, so keep the TOS
;; visible with an honest generic fallback.
(define-class GelTosText
  (fields)
  (methods
    (call
      (stack (List Mirror))
      String
      (let ((tos (gel-tos call stack)))
        ((gel-rows-from-mirror call tos) fold
          "TOS: object"
          (fn (text row)
            (if ((row arity) = 0)
                (let ((selector-name ((row selector) name)))
                  (cond ((selector-name = "show")
                         ("TOS: " append
                           (tos invoke (row signature))))
                        ((selector-name = "text")
                         ("TOS: " append
                           (tos invoke (row signature))))
                        ((selector-name = "name")
                         ("TOS: " append
                           (tos invoke (row signature))))
                        (else text)))
                text)))))))

(define gel-tos-text (GelTosText new))

(define-class GelHandleKey
  (fields)
  (methods
    (call
      (stack (List Mirror))
      (key String)
      GelStep
      (if (key = "q")
          (GelStep new stack #t)
          (let ((rows
                 (gel-rows-from-mirror call
                   (gel-tos call stack)))
                (index (gel-key-index call key)))
            (if (index = 0)
                (GelStep new stack #f)
                (let ((row (gel-select-row call rows index)))
                  (if ((row arity) = 0)
                      (GelStep new
                        (gel-invoke-zero call stack row)
                        #f)
                      (if ((row arity) = 1)
                          (if ((stack len) >= 2)
                              ;; gel-invoke-one's Mirror overload unwraps the
                              ;; next stack slot with subject.
                              (GelStep new
                                (gel-invoke-one call stack row
                                  ((stack rest) first))
                                #f)
                              (GelStep new stack #f))
                          (GelStep new stack #f))))))))))

(define gel-handle-key (GelHandleKey new))
