;; Gel's pure key step. Terminal input is a skin that supplies a String.

(load "stack.aloe")

(define-class GelStep
  (fields
    (stack GelStack)
    (quit Bool)
    (pending (List GelRow))
    (int-input Int)
    (has-digits Bool)
    (show-hidden Bool)
    (page Int))
  (methods))

(define-class GelKey
  (fields
    (text String))
  (methods
    (digit-value () Int
      (cond (((self text) = "0") 0)
            (((self text) = "1") 1)
            (((self text) = "2") 2)
            (((self text) = "3") 3)
            (((self text) = "4") 4)
            (((self text) = "5") 5)
            (((self text) = "6") 6)
            (((self text) = "7") 7)
            (((self text) = "8") 8)
            (((self text) = "9") 9)
            (else -1)))

    (menu-index () Int
      (let ((digit (self digit-value)))
        (if (digit > 0) digit 0)))

    (item-index () Int
      (gel-item-keys index (self text)))

    (quit? () Bool
      ((self text) = "q"))

    (escape? () Bool
      ((self text) = "escape"))

    (u|p|? () Bool
      ((self text) = "u"))

    (hidden? () Bool
      ((self text) = "."))

    (next? () Bool
      ((self text) = "n"))

    (prev? () Bool
      ((self text) = "p"))

    (return? () Bool
      ((self text) = "return"))))

(define-class GelPick
  (fields
    (index Int)
    (mirror Mirror))
  (methods))

(define-class GelPicks
  (fields
    (items (List GelPick)))
  (methods
    (len () Int
      ((self items) len))

    (select
      (index Int)
      GelPick
      ((self items) fold
        ((self items) first)
        (fn (found candidate)
          (if ((candidate index) = index)
              candidate
              found))))))

(define-methods GelStack
  (methods
    (matching-picks
      (row GelRow)
      GelPicks
      (GelPicks new
        (((self items) fold
            (List empty)
            (fn (picks candidate)
              (if (row accepts? candidate)
                  (picks cons
                    (GelPick new
                      ((picks len) + 1)
                      candidate))
                  picks)))
          reverse)))))

(define-class GelText
  (fields)
  (methods
    (line (row GelRow) String
      (let ((index-text ((row index) text))
            (selector-text ((row selector) name))
            (arity-text ((row arity) text)))
        (((((index-text append "  ") append selector-text)
           append "  ")
          append arity-text)
         append "\r\n")))

    (message-rows
      (rows (List GelRow))
      (List GelRow)
      rows)

    (rows-text (rows (List GelRow)) String
      ((self message-rows rows) fold ""
        (fn (text row)
          (text append (self line row)))))

    (value-line (row GelValueRow) String
      ((((row key) append "  ") append
        (row label))
       append "\r\n"))

    (value-rows-text (rows GelValueRows) String
      ((rows items) fold ""
        (fn (text row)
          (text append (self value-line row)))))

    (directory-status
      (count Int)
      (page Int)
      String
      (let ((page-size (gel-item-keys len)))
        (let ((page-count
               ((count + (page-size - 1)) / page-size))
              (count-text
               (((count text) append " entries") append "\r\n")))
          (if (page-count > 1)
              (((((count-text append "page ") append
                   ((page + 1) text))
                  append " of ")
                 append (page-count text))
                append "\r\n")
              count-text))))

    (menu-text (value GelMenu) String
      (value case
        (Messages (rows)
          (self rows-text rows))
        (Values (rows)
          (self value-rows-text rows))))

    (pick-line (pick GelPick) String
      (((((pick index) text) append "  ") append
         ((pick mirror) raw))
       append "\r\n"))

    (picks-text (picks GelPicks) String
      ((picks items) fold ""
        (fn (text pick)
          (text append (self pick-line pick)))))

    (pending-text (state GelStep) String
      (let ((row ((state pending) first)))
        (let ((selector-text ((row selector) name))
              (expected-text (row expected-text))
              (picks
               ((state stack) matching-picks row)))
          (if (row int-hole?)
              (let ((digits
                     (if (state has-digits)
                         ((state int-input) text)
                         "")))
                (((("pending " append selector-text)
                   append "  Int ")
                  append digits)
                 append "\r\n"))
              (let ((header
                     (((("pending " append selector-text)
                        append "  ")
                       append expected-text)
                      append "\r\n")))
                (header append (self picks-text picks)))))))

    ;; A stack TOS is already a Mirror. Its rows describe the subject, not
    ;; the Mirror reflection API itself.
    (menu (value Mirror) String
      (self menu value #f 0))

    (menu
      (value Mirror)
      (show-hidden Bool)
      String
      (self menu value show-hidden 0))

    (menu
      (value Mirror)
      (show-hidden Bool)
      (page Int)
      String
      (if (gel-menus directory? value)
          (let ((rows (gel-menus directory-rows value show-hidden)))
            (let ((text
                   (self value-rows-text
                     (gel-menus window rows page)))
                  (status
                   (self directory-status (rows len) page))
                  (commands
                   (if show-hidden
                       "u  up\r\n.  hide hidden\r\nn  next\r\np  prev\r\n"
                       "u  up\r\n.  show hidden\r\nn  next\r\np  prev\r\n")))
              (((if (text = "")
                    text
                    (text append "\r\n"))
                append status)
               append commands)))
          (let ((text
                 (self menu-text
                   (gel-menus of value show-hidden page))))
            (if (gel-ups available? value)
                (let ((commands "u  up\r\n"))
                  (if (text = "")
                      commands
                      ((text append "\r\n") append commands)))
                text))))

    (menu (state GelStep) String
      (if ((state pending) empty?)
          (self menu
            ((state stack) tos)
            (state show-hidden)
            (state page))
          (self pending-text state)))

    (menu (type T)
      (value T)
      String
      (self menu (Mirror of value)))

    (tos-result
      (presentations Mirror)
      (top Mirror)
      (signature Signature)
      String
      (presentations inv|o|ke signature (top subject)))

    (tos-mirror
      (top Mirror)
      String
      (let ((matches
             (gel-menus directory-signatures top "tos-text")))
        (if (matches empty?)
            (top raw)
            (self tos-result
              (gel-menus directory-index)
              top
              ((matches reverse) first)))))

    (tos
      (stack GelStack)
      String
      (let ((top (stack tos)))
        ("TOS: " append (self tos-mirror top))))))

(define gel-text (GelText new))

(define-methods GelStep
  (methods
    (handle-messages
      (rows (List GelRow))
      (key GelKey)
      GelStep
      (let ((index (key menu-index)))
        (if (index = 0)
            (GelStep new
              (self stack) #f (List empty) 0 #f
              (self show-hidden) (self page))
            (let ((row (gel-rows select rows index)))
              (if ((row arity) = 0)
                  (GelStep new
                    ((self stack) invoke-zero row)
                    #f
                    (List empty)
                    0
                    #f
                    (self show-hidden)
                    0)
                  (if ((row arity) = 1)
                      (GelStep new
                        (self stack) #f (List of row) 0 #f
                        (self show-hidden) (self page))
                      (GelStep new
                        (self stack) #f (List empty) 0 #f
                        (self show-hidden) (self page))))))))

    (handle-values
      (rows GelValueRows)
      (key GelKey)
      GelStep
      (let ((index (key item-index)))
        (if (index = 0)
            self
            (if (index > (rows len))
                self
                (let ((row (rows select index)))
                  (GelStep new
                    ((self stack) push (row value))
                    #f
                    (List empty)
                    0
                    #f
                    (self show-hidden)
                    0))))))

    (handle-menu
      (menu GelMenu)
      (key GelKey)
      GelStep
      (menu case
        (Messages (rows)
          (self handle-messages (gel-text message-rows rows) key))
        (Values (rows)
          (self handle-values rows key))))

    (handle-up
      (result GelUp)
      GelStep
      (result case
        (Unavailable () self)
        (NoParent () self)
        (Parent (value)
          (GelStep new
            ((self stack) push value)
            #f
            (List empty)
            0
            #f
            (self show-hidden)
            0))))

    (handle-next
      (top Mirror)
      GelStep
      (if (gel-menus directory? top)
          (let ((next-page ((self page) + 1)))
            ((gel-menus of top (self show-hidden) next-page) case
              (Messages (rows) self)
              (Values (rows)
                (if ((rows len) = 0)
                    self
                    (GelStep new
                      (self stack)
                      #f
                      (List empty)
                      0
                      #f
                      (self show-hidden)
                      next-page)))))
          self))

    (handle-prev
      (top Mirror)
      GelStep
      (if (gel-menus directory? top)
          (if ((self page) > 0)
              (GelStep new
                (self stack)
                #f
                (List empty)
                0
                #f
                (self show-hidden)
                ((self page) - 1))
              self)
          self))

    (handle-idle
      (key GelKey)
      GelStep
      (if (key quit?)
          (GelStep new
            (self stack) #t (List empty) 0 #f
            (self show-hidden) (self page))
          (if (key escape?)
              (GelStep new
                ((self stack) pop)
                #f
                (List empty)
                0
                #f
                (self show-hidden)
                0)
              (if (key u|p|?)
                  (self handle-up
                    (gel-ups of ((self stack) tos)))
                  (if (key hidden?)
                      (if (gel-menus directory? ((self stack) tos))
                          (GelStep new
                            (self stack)
                            #f
                            (List empty)
                            0
                            #f
                            (if (self show-hidden) #f #t)
                            0)
                          self)
                      (if (key next?)
                          (self handle-next ((self stack) tos))
                          (if (key prev?)
                              (self handle-prev ((self stack) tos))
                              (self handle-menu
                                (gel-menus of
                                  ((self stack) tos)
                                  (self show-hidden)
                                  (self page))
                                key))))))))

    (handle-int
      (row GelRow)
      (key GelKey)
      GelStep
      (if (key return?)
          (if (self has-digits)
              (GelStep new
                ((self stack) invoke-one
                  row
                  (self int-input))
                #f
                (List empty)
                0
                #f
                (self show-hidden)
                0)
              self)
          (let ((digit (key digit-value)))
            (if (digit < 0)
                self
                (GelStep new
                  (self stack)
                  #f
                  (self pending)
                  (((self int-input) * 10) + digit)
                  #t
                  (self show-hidden)
                  (self page))))))

    (handle-pick
      (row GelRow)
      (key GelKey)
      GelStep
      (let ((index (key menu-index)))
        (if (index = 0)
            self
            (let ((picks
                   ((self stack) matching-picks row)))
              (if (index > (picks len))
                  self
                  (let ((pick
                         (picks select index)))
                    (GelStep new
                      ((self stack) invoke-one
                        row
                        (pick mirror))
                      #f
                      (List empty)
                      0
                      #f
                      (self show-hidden)
                      0)))))))

    (handle-pending
      (key GelKey)
      GelStep
      (if (key quit?)
          (GelStep new
            (self stack) #t (List empty) 0 #f
            (self show-hidden) (self page))
          (if (key escape?)
              (GelStep new
                (self stack) #f (List empty) 0 #f
                (self show-hidden) (self page))
              (let ((row ((self pending) first)))
                (if (row int-hole?)
                    (self handle-int row key)
                    (self handle-pick row key))))))

    (handle-key
      (text String)
      GelStep
      (let ((key (GelKey new text)))
        (if ((self pending) empty?)
            (self handle-idle key)
            (self handle-pending key))))))
