;; Gel v0 menu rows. This file is application code, not an Aloe library.

(define-class GelRow
  (fields
    (index Int)
    (selector Symbol)
    (arity Int)
    (signature Signature))
  (methods
    (label () String
      ((self selector) name))

    (expected-text () String
      ((Mirror of (((self signature) params) first)) raw))

    (int-hole? () Bool
      ((self expected-text) = "#<Symbol Int>"))

    (accepts? (candidate Mirror) Bool
      ((self signature) accepts? candidate))))

;; Top-level fn values are monomorphic in the current checker. A generic call
;; method keeps T fresh for each use while preserving the normal `call` send.
(define-class GelRows
  (fields)
  (methods
    (call
      (mirror Mirror)
      (List GelRow)
      (((mirror signatures) fold
         (List empty)
         (fn (rows signature)
           (rows cons
             (GelRow new
               ((rows len) + 1)
               (signature selector)
               ((signature params) len)
               signature))))
       reverse))

    (call (type T)
      (value T)
      (List GelRow)
      (self call (Mirror of value)))))

(define gel-rows (GelRows new))
