;; Gel v0 menu rows. This file is application code, not an Aloe library.

(define-class GelRow
  (fields
    (index Int)
    (selector Symbol)
    (arity Int)
    (signature Signature))
  (methods
    (label () String
      ((self selector) name))

    (expected-text () String
      ((Mirror of (((self signature) params) first)) raw))

    (int-hole? () Bool
      ((self expected-text) = "#<Symbol Int>"))

    (accepts? (candidate Mirror) Bool
      ((self signature) accepts? candidate))))

;; Top-level fn values are monomorphic in the current checker. A generic `of`
;; method keeps T fresh for each use.
(define-class GelRows
  (fields)
  (methods
    (of
      (mirror Mirror)
      (List GelRow)
      (((mirror signatures) fold
         (List empty)
         (fn (rows signature)
           (rows cons
             (GelRow new
               ((rows len) + 1)
               (signature selector)
               ((signature params) len)
               signature))))
       reverse))

    (of (type T)
      (value T)
      (List GelRow)
      (self of (Mirror of value)))

    (select
      (rows (List GelRow))
      (index Int)
      GelRow
      (let ((row
             (rows fold
               (rows first)
               (fn (found candidate)
                 (if ((candidate index) = index)
                     candidate
                     found)))))
        (if ((row index) = index)
            row
            ((List empty) first))))))

(define gel-rows (GelRows new))

(define-class GelMirrors
  (fields)
  (methods
    (of (value Mirror) Mirror
      value)

    (of (type T)
      (value T)
      Mirror
      (Mirror of value))))

(define gel-mirrors (GelMirrors new))

(define-class GelListValues
  (fields
    (items (List Mirror)))
  (methods))

(load "presentations.aloe")

(define-methods GelPresentations
  (methods
    (list-values (type T)
      (items (List T))
      GelListValues
      (GelListValues new
        (items map
          (fn (value)
            (gel-mirrors of value)))))))

(define-class GelItemKey
  (fields
    (index Int)
    (text String))
  (methods))

(define-class GelItemKeys
  (fields
    (items (List GelItemKey)))
  (methods
    (len () Int
      ((self items) len))

    (select (index Int) GelItemKey
      ((self items) fold
        ((self items) first)
        (fn (found candidate)
          (if ((candidate index) = index)
              candidate
              found))))

    (index (text String) Int
      ((self items) fold
        0
        (fn (found candidate)
          (if ((candidate text) = text)
              (candidate index)
              found))))))

(define gel-item-keys
  (GelItemKeys new
    (List of
      (GelItemKey new 1 "a")
      (GelItemKey new 2 "b")
      (GelItemKey new 3 "c")
      (GelItemKey new 4 "d")
      (GelItemKey new 5 "e")
      (GelItemKey new 6 "f")
      (GelItemKey new 7 "g")
      (GelItemKey new 8 "h")
      (GelItemKey new 9 "i")
      (GelItemKey new 10 "j")
      (GelItemKey new 11 "k")
      (GelItemKey new 12 "l")
      (GelItemKey new 13 "m")
      (GelItemKey new 14 "o")
      (GelItemKey new 15 "r")
      (GelItemKey new 16 "s")
      (GelItemKey new 17 "t")
      (GelItemKey new 18 "v")
      (GelItemKey new 19 "w")
      (GelItemKey new 20 "x")
      (GelItemKey new 21 "y")
      (GelItemKey new 22 "z"))))

(define-class GelValueRow
  (fields
    (index Int)
    (value Mirror)
    (label String))
  (methods
    (key () String
      ((gel-item-keys select (self index)) text))))

(define-class GelValueRows
  (fields
    (items (List GelValueRow)))
  (methods
    (len () Int
      ((self items) len))

    (select (index Int) GelValueRow
      ((self items) fold
        ((self items) first)
        (fn (found candidate)
          (if ((candidate index) = index)
              candidate
              found))))))

(define-class GelMenu
  (constructors
    (Messages (fields (rows (List GelRow))))
    (Values (fields (rows GelValueRows))))
  (methods))

(define-class GelMenus
  (fields)
  (methods
    (directory-signatures
      (mirror Mirror)
      (selector String)
      (List Signature)
      ((mirror signatures) fold
        (List empty)
        (fn (matches signature)
          (if (((signature selector) name) = selector)
              (if (((signature params) len) = 0)
                  (matches cons signature)
                  matches)
              matches))))

    (directory? (mirror Mirror) Bool
      (if ((self directory-signatures
             mirror
             "gel-directory-values") empty?)
          #f
          #t))

    (value-rows
      (values GelListValues)
      GelValueRows
      (GelValueRows new
        (((values items) fold
            (List empty)
            (fn (rows value)
              (if ((rows len) < (gel-item-keys len))
                  (rows cons
                    (GelValueRow new
                      ((rows len) + 1)
                      value
                      (value raw)))
                  rows)))
          reverse)))

    (list-signatures
      (mirror Mirror)
      (List Signature)
      (((Mirror of gel-presentations) signatures) fold
        (List empty)
        (fn (matches signature)
          (if (((signature selector) name) = "list-values")
              (if (((signature params) len) = 1)
                  (if (signature accepts? mirror)
                      (matches cons signature)
                      matches)
                  matches)
              matches))))

    (list-values
      (mirror Mirror)
      (signature Signature)
      GelListValues
      ((Mirror of gel-presentations) inv|o|ke
        signature
        (mirror subject)))

    (directory-values
      (mirror Mirror)
      (signature Signature)
      GelValueRows
      (mirror inv|o|ke signature))

    (window
      (rows GelValueRows)
      (page Int)
      GelValueRows
      (let ((start (page * (gel-item-keys len))))
        (GelValueRows new
          (((rows items) fold
              (List empty)
              (fn (visible row)
                (if ((row index) > start)
                    (if ((visible len) < (gel-item-keys len))
                        (visible cons
                          (GelValueRow new
                            ((visible len) + 1)
                            (row value)
                            (row label)))
                        visible)
                    visible)))
            reverse))))

    (of
      (mirror Mirror)
      GelMenu
      (self of mirror #f 0))

    (of
      (mirror Mirror)
      (show-hidden Bool)
      GelMenu
      (self of mirror show-hidden 0))

    (of
      (mirror Mirror)
      (show-hidden Bool)
      (page Int)
      GelMenu
      (let ((directory-signatures
             (self directory-signatures
               mirror
               (if show-hidden
                   "gel-directory-all-values"
                   "gel-directory-values"))))
        (if (directory-signatures empty?)
            (let ((list-signatures (self list-signatures mirror)))
              (if (list-signatures empty?)
                  (GelMenu Messages (gel-rows of mirror))
                  (GelMenu Values
                    (self value-rows
                      (self list-values
                        mirror
                        ((list-signatures reverse) first))))))
            (GelMenu Values
              (self window
                (self directory-values
                  mirror
                  ((directory-signatures reverse) first))
                page)))))))

(define gel-menus (GelMenus new))

(define-class GelUp
  (constructors
    (Unavailable (fields))
    (NoParent (fields))
    (Parent (fields (value Mirror))))
  (methods))

(define-class GelUps
  (fields)
  (methods
    (signatures
      (mirror Mirror)
      (List Signature)
      ((mirror signatures) fold
        (List empty)
        (fn (matches signature)
          (if (((signature selector) name) = "gel-up")
              (if (((signature params) len) = 0)
                  (matches cons signature)
                  matches)
              matches))))

    (available? (mirror Mirror) Bool
      (if ((self signatures mirror) empty?) #f #t))

    (result
      (mirror Mirror)
      (signature Signature)
      GelUp
      (mirror inv|o|ke signature))

    (of (mirror Mirror) GelUp
      (let ((matches (self signatures mirror)))
        (if (matches empty?)
            (GelUp Unavailable)
            (self result mirror ((matches reverse) first)))))))

(define gel-ups (GelUps new))
