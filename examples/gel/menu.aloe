;; Gel v0 menu rows. This file is application code, not an Aloe library.

(define-class GelRow
  (fields
    (index Int)
    (selector Symbol)
    (arity Int)
    (signature Signature))
  (methods
    (label () String
      ((self selector) name))

    (expected-text () String
      ((Mirror of (((self signature) params) first)) raw))

    (int-hole? () Bool
      ((self expected-text) = "#<Symbol Int>"))

    (accepts? (candidate Mirror) Bool
      ((self signature) accepts? candidate))))

;; Top-level fn values are monomorphic in the current checker. A generic `of`
;; method keeps T fresh for each use.
(define-class GelRows
  (fields)
  (methods
    (of
      (mirror Mirror)
      (List GelRow)
      (((mirror signatures) fold
         (List empty)
         (fn (rows signature)
           (rows cons
             (GelRow new
               ((rows len) + 1)
               (signature selector)
               ((signature params) len)
               signature))))
       reverse))

    (of (type T)
      (value T)
      (List GelRow)
      (self of (Mirror of value)))

    (select
      (rows (List GelRow))
      (index Int)
      GelRow
      (let ((row
             (rows fold
               (rows first)
               (fn (found candidate)
                 (if ((candidate index) = index)
                     candidate
                     found)))))
        (if ((row index) = index)
            row
            ((List empty) first))))))

(define gel-rows (GelRows new))
