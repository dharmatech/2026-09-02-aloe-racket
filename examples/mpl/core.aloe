(define-protocol Math
  (show () String)
  (math-name () String)
  (same-term? (other Math) Bool)
  (coeff-plus (other Math) Math)
  (factor-base () Math)
  (factor-exp () Int)
  (^ (n Int) Math)
  (* (other Math) Math)
  (* (n Int) Math)
  (+ (n Int) Math)
  (+ (other Math) Math))

(load "sym.aloe")
(load "sum.aloe")
(load "num.aloe")
(load "prod.aloe")
(load "pow.aloe")

(define-methods Sym
  (methods
    (show ()
       String
       (self name))
    (same? (other Sym)
       Bool
       ((self name) = (other name)))
    (math-name ()
       String
       (self name))
    (same-term? (other Math)
       Bool
       ((self math-name) = (other math-name)))
    (factor-base ()
       Math
       self)
    (factor-exp ()
       Int
       1)
    (+ (n Int)
       Math
       ((Sum new (List of self) n) unwrap))
    (+ (s Sym)
       Sum
       (Sum new (List of self s) 0))
    (+ (other Math)
       Sum
       (Sum new (self math-factors self other) 0))
    (math-factors (left Math)
                  (right Math)
       (List Math)
       (List of left right))
    (* (other Sym)
       Math
       (if (self same-term? other)
           ((Pow new self 2) unwrap)
           (Prod new 1 (List of self other))))
    (* (other Pow)
       Math
       (if (self same-term? (other base))
           ((Pow new self ((other exp) + 1)) unwrap)
           (Prod new 1 (self math-factors self other))))
    (* (n Int)
       Math
       ((Prod new n (List of self)) unwrap))
    (* (other Math)
       Math
       (Prod new 1 (self math-factors self other)))
    (^ (n Int)
       Math
       ((Pow new self n) unwrap))
    (coeff-plus (other Math)
       Prod
       (Prod new 2 (List of self)))))

(define-methods Sum
  (methods
    (join-show (left String)
               (right String)
       String
       ((("(" append left) append " + ") append (right append ")")))
    (show ()
       String
       (let ((shown
              (((self terms) rest) fold
                (((self terms) first) show)
                (fn (text term)
                  (self join-show text (term show))))))
         (if ((self const) = 0)
             shown
             (self join-show shown ((self const) text)))))
    (math-name ()
       String
       "<sum>")
    (same-term? (other Math)
       Bool
       ((self math-name) = (other math-name)))
    (factor-base ()
       Math
       self)
    (factor-exp ()
       Int
       1)
    (coeff-plus (other Math)
       Sum
       self)
    (^ (n Int)
       Math
       ((Pow new self n) unwrap))
    (* (other Math)
       Prod
       (Prod new 1 (List of other self)))
    (* (n Int)
       Math
       ((Prod new n (List of self)) unwrap))
    (insert-term (terms (List Math))
                 (term Math)
       (List Math)
       (let ((matching?
              (terms fold #f
                (fn (found candidate)
                  (if found
                      #t
                      (candidate same-term? term))))))
         (if matching?
             (terms map
               (fn (candidate)
                 (if (candidate same-term? term)
                     (candidate coeff-plus term)
                     candidate)))
             (terms cons term))))
    (normalized-terms ()
       (List Math)
       ((self terms) fold
         (List empty)
         (fn (terms term)
           (self insert-term terms term))))
    (+ (n Int)
       Math
       ((Sum new
          (self terms)
          ((self const) + n))
        unwrap))
    (+ (s Sym)
       Sum
       (let ((matching?
              ((self terms) fold #f
                (fn (found term)
                  (if found
                      #t
                      (term same-term? s))))))
         (Sum new
           (if matching?
               ((self terms) map
                 (fn (term)
                   (if (term same-term? s)
                       (term coeff-plus s)
                       term)))
               ((self terms) cons s))
           (self const))))
    (+ (other Sum)
       Sum
       (Sum new
         ((other terms) fold
           (self normalized-terms)
           (fn (terms term)
             (self insert-term terms term)))
         ((self const) + (other const))))
    (+ (other Math)
       Math
       ((Sum new
          (self insert-term (self terms) other)
          (self const))
        unwrap))))

(define-methods Prod
  (methods
    (join-show (left String)
               (right String)
       String
       ((("(" append left) append " * ") append (right append ")")))
    (show ()
       String
       (let ((shown
              (((self factors) rest) fold
                (((self factors) first) show)
                (fn (text factor)
                  (self join-show text (factor show))))))
         (if ((self coeff) = 1)
             shown
             (self join-show shown ((self coeff) text)))))
    (math-name ()
       String
       (((self factors) first) math-name))
    (same-term? (other Math)
       Bool
       ((self math-name) = (other math-name)))
    (same-factors? (left (List Math))
                   (right (List Math))
       Bool
       (if (left empty?)
           (right empty?)
           (if (right empty?)
               #f
               (if ((left first) same-term? (right first))
                   (self same-factors? (left rest) (right rest))
                   #f))))
    (same-term? (other Prod)
       Bool
       (self same-factors? (self factors) (other factors)))
    (factor-base ()
       Math
       self)
    (factor-exp ()
       Int
       1)
    (coeff-plus (other Math)
       Prod
       (Prod new
         ((self coeff) + 1)
         (self factors)))
    (+ (other Prod)
       Math
       (if (self same-term? other)
           ((Prod new
              ((self coeff) + (other coeff))
              (self factors))
            unwrap)
           (Sum new (List of self other) 0)))
    (+ (n Int)
       Math
       ((Sum new (List of self) n) unwrap))
    (+ (other Math)
       Sum
       (Sum new (List of other self) 0))
    (* (n Int)
       Math
       ((Prod new
          ((self coeff) * n)
          (self factors))
        unwrap))
    (merge-factor (left Math)
                  (right Math)
       Math
       ((Pow new
          (left factor-base)
          ((left factor-exp) + (right factor-exp)))
        unwrap))
    (insert-factor (factors (List Math))
                   (factor Math)
       (List Math)
       (let ((matching?
              (factors fold #f
                (fn (found candidate)
                  (if found
                      #t
                      (candidate same-term? factor))))))
         (if matching?
             (factors map
               (fn (candidate)
                 (if (candidate same-term? factor)
                     (self merge-factor candidate factor)
                     candidate)))
             (factors cons factor))))
    (coeff-power (n Int)
       Int
       (if (n <= 0)
           1
           ((self coeff) * (self coeff-power (n - 1)))))
    (* (s Sym)
       Prod
       (Prod new
         (self coeff)
         (self insert-factor (self factors) s)))
    (* (p Pow)
       Prod
       (Prod new
         (self coeff)
         (self insert-factor (self factors) p)))
    (* (other Math)
       Prod
       (Prod new
         (self coeff)
         (self insert-factor (self factors) other)))
    (* (other Prod)
       Prod
       (Prod new
         ((self coeff) * (other coeff))
         ((other factors) fold
           (self factors)
           (fn (factors factor)
             (self insert-factor factors factor)))))
    (^ (n Int)
       Prod
       (Prod new
         (self coeff-power n)
         ((self factors) map
           (fn (factor)
             (factor ^ n)))))))

(define-methods Pow
  (methods
    (show ()
       String
       ((("(" append ((self base) show)) append " ^ ")
        append (((self exp) text) append ")")))
    (math-name ()
       String
       ((self base) math-name))
    (same-term? (other Math)
       Bool
       ((self math-name) = (other math-name)))
    (factor-base ()
       Math
       (self base))
    (factor-exp ()
       Int
       (self exp))
    (coeff-plus (other Math)
       Prod
       (Prod new 2 (List of self)))
    (+ (n Int)
       Math
       ((Sum new (List of self) n) unwrap))
    (+ (other Math)
       Sum
       (Sum new (List of other self) 0))
    (* (n Int)
       Math
       ((Prod new n (List of self)) unwrap))
    (^ (n Int)
       Math
       ((Pow new
          (self base)
          ((self exp) * n))
        unwrap))
    (* (other Sym)
       Math
       (if ((self base) same-term? other)
           ((Pow new
              (self base)
              ((self exp) + 1))
            unwrap)
           ((Prod new 1 (List of self)) * other)))
    (* (other Prod)
       Prod
       (Prod new
         (other coeff)
         (other insert-factor (other factors) self)))
    (* (other Math)
       Math
       (if ((self base) same-term? (other factor-base))
           ((Pow new
              (self base)
              ((self exp) + (other factor-exp)))
            unwrap)
           (Prod new 1 (List of other self))))
    (* (other Pow)
       Math
       (if ((self base) same-term? (other base))
           ((Pow new
              (self base)
              ((self exp) + (other exp)))
            unwrap)
           (Prod new 1 (List of self other))))))

(define-methods Num
  (methods
    (show ()
       String
       ((self value) text))
    (math-name ()
       String
       "0")
    (same-term? (other Math)
       Bool
       ((self math-name) = (other math-name)))
    (coeff-plus (other Math)
       Math
       self)
    (factor-base ()
       Math
       self)
    (factor-exp ()
       Int
       1)
    (^ (n Int)
       Math
       self)
    (* (other Math)
       Math
       self)
    (* (n Int)
       Math
       self)
    (+ (n Int)
       Math
       (Num new ((self value) + n)))
    (+ (other Math)
       Math
       other)))
