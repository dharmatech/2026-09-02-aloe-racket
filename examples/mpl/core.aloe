(define-protocol Math)

(load "sym.aloe")
(load "sum.aloe")
(load "prod.aloe")

(define-methods Sym
  (methods
    (same? (other Sym)
       Bool
       ((self name) = (other name)))
    (+ (type U)
       (other U)
       (Sum Sym U)
       (Sum new self other))
    (* (type U)
       (other U)
       (Prod Sym U)
       (Prod new self other))
    (coeff-plus (s Sym)
       (Prod Sym Int)
       (if (self same? s)
           (Prod new self 2)
           (Prod new self (0 / 0))))))

(define-methods Sum
  (methods
    (+ (n Int)
       (Sum L Int)
       (Sum new
         (self left)
         ((self right) + n)))
    (+ (s Sym)
       (Sum (Prod Sym Int) Int)
       (Sum new
         ((self left) coeff-plus s)
         (self right)))))

(define-methods Prod
  (methods
    (coeff-plus (s Sym)
       (Prod Sym Int)
       (if ((self left) same? s)
           (Prod new
             (self left)
             ((self right) + 1))
           (Prod new
             (self left)
             (0 / 0))))))
