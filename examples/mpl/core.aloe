(define-protocol Math
  (math-name () String)
  (same-term? (other Math) Bool)
  (coeff-plus (other Math) Math))

(load "sym.aloe")
(load "sum.aloe")
(load "prod.aloe")

(define-methods Sym
  (methods
    (same? (other Sym)
       Bool
       ((self name) = (other name)))
    (math-name ()
       String
       (self name))
    (same-term? (other Math)
       Bool
       ((self math-name) = (other math-name)))
    (+ (n Int)
       Sum
       (Sum new (List of self) n))
    (+ (s Sym)
       Sum
       (Sum new (List of self s) 0))
    (* (type U)
       (other U)
       (Prod Sym U)
       (Prod new self other))
    (coeff-plus (other Math)
       (Prod Sym Int)
       (Prod new self 2))))

(define-methods Sum
  (methods
    (math-name ()
       String
       "<sum>")
    (same-term? (other Math)
       Bool
       ((self math-name) = (other math-name)))
    (coeff-plus (other Math)
       Sum
       self)
    (+ (n Int)
       Sum
       (Sum new
         (self terms)
         ((self const) + n)))
    (+ (s Sym)
       Sum
       (let ((matching?
              ((self terms) fold #f
                (fn (found term)
                  (if found
                      #t
                      (term same-term? s))))))
         (Sum new
           (if matching?
               ((self terms) map
                 (fn (term)
                   (if (term same-term? s)
                       (term coeff-plus s)
                       term)))
               ((self terms) cons s))
           (self const))))))

(define-methods Prod
  (methods
    (math-name ()
       String
       ((self left) math-name))
    (same-term? (other Math)
       Bool
       ((self math-name) = (other math-name)))
    (coeff-plus (other Math)
       (Prod Sym Int)
       (Prod new
         (self left)
         ((self right) + 1)))
    (* (n Int)
       (Prod L Int)
       (Prod new
         (self left)
         ((self right) * n)))
    (* (type U)
       (other U)
       (Prod (Prod L R) U)
       (Prod new self other))))
