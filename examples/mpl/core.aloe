(define-protocol Math
  (math-name () String)
  (same-term? (other Math) Bool)
  (coeff-plus (other Math) Math)
  (factor-base () Math)
  (factor-exp () Int)
  (^ (n Int) Math))

(load "sym.aloe")
(load "sum.aloe")
(load "prod.aloe")
(load "pow.aloe")

(define-methods Sym
  (methods
    (same? (other Sym)
       Bool
       ((self name) = (other name)))
    (math-name ()
       String
       (self name))
    (same-term? (other Math)
       Bool
       ((self math-name) = (other math-name)))
    (factor-base ()
       Math
       self)
    (factor-exp ()
       Int
       1)
    (+ (n Int)
       Sum
       (Sum new (List of self) n))
    (+ (s Sym)
       Sum
       (Sum new (List of self s) 0))
    (* (other Sym)
       Math
       (if (self same-term? other)
           (Pow new self 2)
           (Prod new 1 (List of self other))))
    (* (n Int)
       Prod
       (Prod new n (List of self)))
    (^ (n Int)
       Pow
       (Pow new self n))
    (coeff-plus (other Math)
       Prod
       (Prod new 2 (List of self)))))

(define-methods Sum
  (methods
    (math-name ()
       String
       "<sum>")
    (same-term? (other Math)
       Bool
       ((self math-name) = (other math-name)))
    (factor-base ()
       Math
       self)
    (factor-exp ()
       Int
       1)
    (coeff-plus (other Math)
       Sum
       self)
    (^ (n Int)
       Pow
       (Pow new self n))
    (insert-term (terms (List Math))
                 (term Math)
       (List Math)
       (let ((matching?
              (terms fold #f
                (fn (found candidate)
                  (if found
                      #t
                      (candidate same-term? term))))))
         (if matching?
             (terms map
               (fn (candidate)
                 (if (candidate same-term? term)
                     (candidate coeff-plus term)
                     candidate)))
             (terms cons term))))
    (normalized-terms ()
       (List Math)
       ((self terms) fold
         (List empty)
         (fn (terms term)
           (self insert-term terms term))))
    (+ (n Int)
       Sum
       (Sum new
         (self terms)
         ((self const) + n)))
    (+ (s Sym)
       Sum
       (let ((matching?
              ((self terms) fold #f
                (fn (found term)
                  (if found
                      #t
                      (term same-term? s))))))
         (Sum new
           (if matching?
               ((self terms) map
                 (fn (term)
                   (if (term same-term? s)
                       (term coeff-plus s)
                       term)))
               ((self terms) cons s))
           (self const))))
    (+ (other Sum)
       Sum
       (Sum new
         ((other terms) fold
           (self normalized-terms)
           (fn (terms term)
             (self insert-term terms term)))
         ((self const) + (other const))))))

(define-methods Prod
  (methods
    (math-name ()
       String
       (((self factors) first) math-name))
    (same-term? (other Math)
       Bool
       ((self math-name) = (other math-name)))
    (factor-base ()
       Math
       self)
    (factor-exp ()
       Int
       1)
    (coeff-plus (other Math)
       Prod
       (Prod new
         ((self coeff) + 1)
         (self factors)))
    (* (n Int)
       Prod
       (Prod new
         ((self coeff) * n)
         (self factors)))
    (merge-factor (left Math)
                  (right Math)
       Math
       (Pow new
         (left factor-base)
         ((left factor-exp) + (right factor-exp))))
    (insert-factor (factors (List Math))
                   (factor Math)
       (List Math)
       (let ((matching?
              (factors fold #f
                (fn (found candidate)
                  (if found
                      #t
                      (candidate same-term? factor))))))
         (if matching?
             (factors map
               (fn (candidate)
                 (if (candidate same-term? factor)
                     (self merge-factor candidate factor)
                     candidate)))
             (factors cons factor))))
    (coeff-power (n Int)
       Int
       (if (n <= 0)
           1
           ((self coeff) * (self coeff-power (n - 1)))))
    (* (s Sym)
       Prod
       (Prod new
         (self coeff)
         (self insert-factor (self factors) s)))
    (* (other Prod)
       Prod
       (Prod new
         ((self coeff) * (other coeff))
         ((other factors) fold
           (self factors)
           (fn (factors factor)
             (self insert-factor factors factor)))))
    (^ (n Int)
       Prod
       (Prod new
         (self coeff-power n)
         ((self factors) map
           (fn (factor)
             (factor ^ n)))))))

(define-methods Pow
  (methods
    (math-name ()
       String
       ((self base) math-name))
    (same-term? (other Math)
       Bool
       ((self math-name) = (other math-name)))
    (factor-base ()
       Math
       (self base))
    (factor-exp ()
       Int
       (self exp))
    (coeff-plus (other Math)
       Prod
       (Prod new 2 (List of self)))
    (^ (n Int)
       Pow
       (Pow new
         (self base)
         ((self exp) * n)))
    (* (other Pow)
       Math
       (if ((self base) same-term? (other base))
           (Pow new
             (self base)
             ((self exp) + (other exp)))
           (Prod new 1 (List of self other))))))
