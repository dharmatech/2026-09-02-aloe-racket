(load "file.aloe")

(define aloemacs-editor
  (AloemacsSession new
    (AloemacsBuffers new
      (List empty)
      (AloemacsBuffer new
        (AloemacsEditor new
          (Text from-string "")
          (Position new 0 0)
          #f
          0
          0
          (List empty)
          (if #t (Option None) (Option Some (Position new 0 0)))
          0)
        (if #t
            (Option None)
            (Option Some (Path new "/typed-none"))))
      (List empty))
    (Fs new fs-host)
    ""
    #f
    ""
    (Position new 0 0)
    #f
    #f
    (List empty)
    (if #t
        (Option None)
        (Option Some aloemacs-global-keymap))
    (if #t (Option None) (Option Some (AloemacsPrompt new "" "" 0)))
    (if #t (Option None) (Option Some ""))))
