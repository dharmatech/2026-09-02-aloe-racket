(load "file.aloe")

(define aloemacs-editor
  (AloemacsSession new
    (AloemacsEditor new
      (Text from-string "")
      (Position new 0 0)
      #f
      0
      0
      (List empty)
      (if #t (Option None) (Option Some (Position new 0 0))))
    (Fs new fs-host)
    (if #t
        (Option None)
        (Option Some (Path new "/typed-none")))
    ""
    #f
    ""
    (Position new 0 0)
    #f
    #f
    (List empty)))
