(load "file.aloe")

(define aloemacs-editor
  (AloemacsSession new
    (AloemacsEditor new
      (Text from-string "")
      (Position new 0 0)
      #f
      0
      0
      (List empty))
    (Fs new fs-host)
    (if #t
        (Option None)
        (Option Some (Path new "/typed-none")))
    ""))
