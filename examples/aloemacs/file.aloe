(load "editor.aloe")
(load "../../lib/fs.aloe")

(define-class AloemacsPrompt
  (fields
    (label String)
    (text String)
    (column Int)
    (completion-note String)
    (completion-lines (List String))
    (completion-matches (List String))
    (completion-start Int))
  (methods
    (row () String
      (((self label) append (self text)) append (self completion-note)))

    (screen-column (columns Int) Int
      (columns min ((((self label) len) + (self column)) + 1)))

    (with-completion (text String) (note String) (lines (List String))
                     AloemacsPrompt
      (self with
        (text text)
        (column (if (text = (self text)) (self column) (text len)))
        (completion-note note)
        (completion-lines lines)
        (completion-matches (List empty))
        (completion-start 0)))

    (with-completion-page (matches (List String)) (start Int) (lines (List String))
                          AloemacsPrompt
      (self with
        (completion-note "")
        (completion-lines lines)
        (completion-matches matches)
        (completion-start start)))

    (clear-completion () AloemacsPrompt
      (self with
        (completion-note "")
        (completion-lines (List empty))
        (completion-matches (List empty))
        (completion-start 0)))

    (insert (character String) AloemacsPrompt
      (if ((character len) = 1)
          (if (character = "\n")
              self
              (let ((text (self text)) (column (self column)))
                (self with
                  (text
                    (((text take column) append character) append (text drop column)))
                  (column (column + 1))
                  (completion-note "")
                  (completion-lines (List empty))
                  (completion-matches (List empty))
                  (completion-start 0))))
          self))

    (backward-delete () AloemacsPrompt
      (let ((text (self text)) (column (self column)))
        (if (column > 0)
            (self with
              (text ((text take (column - 1)) append (text drop column)))
              (column (column - 1))
              (completion-note "")
              (completion-lines (List empty))
              (completion-matches (List empty))
              (completion-start 0))
            (self clear-completion))))

    (move-left () AloemacsPrompt
      (self with (column (0 max ((self column) - 1)))))

    (move-right () AloemacsPrompt
      (self with (column (((self text) len) min ((self column) + 1)))))

    (line-start () AloemacsPrompt
      (self with (column 0)))

    (line-end () AloemacsPrompt
      (self with (column ((self text) len))))))

;; Recursive scans stay on a nongeneric receiver. The session owns Fs and
;; the prompt result; this scanner only consumes character/list data.
(define-class AloemacsCompletionScan
  (fields)
  (methods
    (split-offset (text String) Int
      (self scan-slashes text 0 0))

    (scan-slashes (remaining String) (offset Int) (latest Int) Int
      (if ((remaining len) = 0)
          latest
          (let ((advanced (offset + 1)))
            (self scan-slashes (remaining drop 1) advanced
              (if ((remaining take 1) = "/") advanced latest)))))

    (common-prefix (names (List String)) String
      (if (names empty?)
          ""
          (self prefix-in (names first) (names rest))))

    (prefix-in (prefix String) (names (List String)) String
      (if (names empty?)
          prefix
          (self prefix-in (self shared-prefix prefix (names first)) (names rest))))

    (shared-prefix (prefix String) (name String) String
      (if (name starts-with? prefix)
          prefix
          (self shared-prefix (prefix take ((prefix len) - 1)) name)))

    (drop-lines (lines (List String)) (count Int) (List String)
      (cond
        ((count <= 0) lines)
        ((lines empty?) lines)
        (else (self drop-lines (lines rest) (count - 1)))))

    (window-lines (matches (List String)) (start Int) (List String)
      (if ((matches len) <= 8)
          matches
          (let ((names
                  ((self drop-lines matches start) fold (List empty)
                    (fn (acc name)
                      (if ((acc len) < 7) (acc cons name) acc)))))
            ((names cons
               (("...(+" append (((matches len) - (names len)) text)) append ")"))
             reverse))))))

(define-class AloemacsBuffer
  (fields
    (editor AloemacsEditor)
    (path (Option Path))
    (id Int))
  (methods
    (name () String
      ((self path) case
        (None () "untitled")
        (Some (path) (path text))))

    (with-editor (editor AloemacsEditor) AloemacsBuffer
      (self with (editor editor)))

    (with-path (path Path) AloemacsBuffer
      (self with (path (Option Some path))))))

(define-class AloemacsBuffers
  (fields
    (before (List AloemacsBuffer))
    (current-buffer AloemacsBuffer)
    (after (List AloemacsBuffer)))
  (methods
    (with-current-buffer (buffer AloemacsBuffer) AloemacsBuffers
      (self with (current-buffer buffer)))

    (fresh-id () Int
      (let ((maximum
              ((self before) fold ((self current-buffer) id)
                (fn (maximum buffer) (maximum max (buffer id))))))
        (((self after) fold maximum
           (fn (maximum buffer) (maximum max (buffer id)))) + 1)))

    (find-id (id Int) (Option AloemacsBuffers)
      (self find-id-in id
        ((1 + ((self before) len)) + ((self after) len))))

    (find-id-in (id Int) (remaining Int) (Option AloemacsBuffers)
      (if (remaining <= 0)
          (Option None)
          (if (((self current-buffer) id) = id)
              (Option Some self)
              (if (remaining > 1)
                  ((self focus-next) find-id-in id (remaining - 1))
                  (Option None)))))

    (find-name (name String) (Option AloemacsBuffers)
      (if (name = "")
          (Option None)
          (self find-name-in name
            ((1 + ((self before) len)) + ((self after) len)))))

    (find-name-in (name String) (remaining Int) (Option AloemacsBuffers)
      (if (remaining <= 0)
          (Option None)
          (if (((self current-buffer) name) = name)
              (Option Some self)
              (if (remaining > 1)
                  ((self focus-next) find-name-in name (remaining - 1))
                  (Option None)))))

    (focus-next () AloemacsBuffers
      (if ((self after) empty?)
          (if ((self before) empty?)
              self
              ;; Consing current guarantees a nonempty reversal.
              (let ((forward
                      (((self before) cons (self current-buffer)) reverse)))
                (self with
                  (before (List empty))
                  (current-buffer (forward first))
                  (after (forward rest)))))
          (self with
            (before ((self before) cons (self current-buffer)))
            (current-buffer ((self after) first))
            (after ((self after) rest)))))

    (focus-previous () AloemacsBuffers
      (if ((self before) empty?)
          (if ((self after) empty?)
              self
              ;; Consing current guarantees a nonempty reversal.
              (let ((backward
                      (((self after) cons (self current-buffer)) reverse)))
                (self with
                  (before (backward rest))
                  (current-buffer (backward first))
                  (after (List empty)))))
          (self with
            (before ((self before) rest))
            (current-buffer ((self before) first))
            (after ((self after) cons (self current-buffer))))))

    (insert-after (buffer AloemacsBuffer) AloemacsBuffers
      (self with
        (before ((self before) cons (self current-buffer)))
        (current-buffer buffer)))

    (remove-current () AloemacsBuffers
      (if ((self after) empty?)
          (if ((self before) empty?)
              (self with
                (before (List empty))
                (current-buffer
                  (AloemacsBuffer new
                    (AloemacsEditor new
                      ((Text from-string "") indexed-value)
                      (Position new 0 0) #f 0 0 (List empty)
                      (if #t (Option None) (Option Some (Position new 0 0)))
                      0)
                    (Option None) ((self current-buffer) id)))
                (after (List empty)))
              (self with
                (before ((self before) rest))
                (current-buffer ((self before) first))
                (after (List empty))))
          (self with
            (current-buffer ((self after) first))
            (after ((self after) rest)))))))

(define-class AloemacsModeLine
  (fields)
  (methods
    ;; The six characters that end a mode line at least seven columns
    ;; wide: a space, U+2195, a space, U+2194, a space, U+00D7. Spelled
    ;; with escapes so this file stays ASCII bytes.
    (buttons () String
      " \u2195 \u2194 \u00d7")

    (buttons? (width Int) Bool
      (width >= 7))

    ;; The name, a space when it fits, then dash fill, clipped to the width.
    (name-row (name String) (width Int) String
      (if (width <= 0)
          ""
          (let ((clipped ((name append " ") take width)))
            (clipped append (self fill (width - (clipped len)))))))

    (row (name String) (width Int) String
      (if (self buttons? width)
          ((self name-row name (width - 6)) append (self buttons))
          (self name-row name width)))

    ;; Which label a cell of the row names: the three glyph cells of the
    ;; group, or "" for every other index. Pure; whether anything happens
    ;; is the session's decision.
    (label-at (width Int) (index Int) String
      (if (self buttons? width)
          (cond
            ((index = (width - 5)) "\u2195")
            ((index = (width - 3)) "\u2194")
            ((index = (width - 1)) "\u00d7")
            (else ""))
          ""))

    (fill (remaining Int) String
      (if (remaining <= 0) "" ("-" append (self fill (remaining - 1)))))

    ;; Display chrome around a visible row that safe cells already produced.
    ;; It never clips, pads or inspects the row.
    (bar (row String) (selected? Bool) String
      (if ((row len) = 0)
          ""
          (((if selected? (self light) (self dark)) append row) append (self plain))))

    (light () String
      "\u001b[38;5;16;48;5;250m")

    (dark () String
      "\u001b[38;5;252;48;5;239m")

    (plain () String
      "\u001b[0m")))

;; A leaf's finished rows and every input that built them.
(define-class AloemacsLeafPicture
  (fields
    (buffer-id Int)
    (history-length Int)
    (scroll-row Int)
    (scroll-col Int)
    (columns Int)
    (rows Int)
    (name String)
    (selected Bool)
    (lines (List String)))
  (methods
    (matches? (buffer-id Int) (history-length Int)
              (scroll-row Int) (scroll-col Int)
              (columns Int) (rows Int)
              (name String) (selected Bool) Bool
      ((List of
         ((self buffer-id) = buffer-id)
         ((self history-length) = history-length)
         ((self scroll-row) = scroll-row)
         ((self scroll-col) = scroll-col)
         ((self columns) = columns)
         ((self rows) = rows)
         ((self name) = name)
         (if selected (self selected) (if (self selected) #f #t)))
       fold #t (fn (all? same?) (if all? same? #f))))))

(define-class AloemacsView
  (fields
    (id Int)
    (buffer-id Int)
    (scroll-row Int)
    (scroll-col Int)
    (point Position)
    (locked Bool)
    (picture (Option AloemacsLeafPicture)))
  (methods))

(define-class AloemacsWindowTree
  (constructors
    (Leaf (fields (view AloemacsView)))
    (Below (fields (top AloemacsWindowTree) (bottom AloemacsWindowTree) (earlier Int) (later Int)))
    (Right (fields (left AloemacsWindowTree) (right AloemacsWindowTree) (earlier Int) (later Int))))
  (methods
    (single? () Bool
      (self case (Leaf (view) #t) (else #f)))

    (leaves () (List AloemacsView)
      (self case
        (Leaf (view) (List of view))
        (Below (top bottom earlier later)
          (((top leaves) reverse) fold (bottom leaves)
            (fn (views view) (views cons view))))
        (Right (left right earlier later)
          (((left leaves) reverse) fold (right leaves)
            (fn (views view) (views cons view))))))

    (find-view (id Int) (Option AloemacsView)
      (self case
        (Leaf (view)
          (if ((view id) = id) (Option Some view) (Option None)))
        (Below (top bottom earlier later)
          ((top find-view id) case
            (Some (view) (Option Some view))
            (None () (bottom find-view id))))
        (Right (left right earlier later)
          ((left find-view id) case
            (Some (view) (Option Some view))
            (None () (right find-view id))))))

    (fresh-id () Int
      (((self leaves) fold 0
         (fn (maximum view) (maximum max (view id)))) + 1))

    (with-toggled-lock (id Int) AloemacsWindowTree
      (self case
        (Leaf (view)
          (if ((view id) = id)
              (AloemacsWindowTree Leaf
                (view with (locked (if (view locked) #f #t))))
              self))
        (Below (top bottom earlier later)
          (if ((top find-view id) present?)
              (AloemacsWindowTree Below (top with-toggled-lock id) bottom earlier later)
              (if ((bottom find-view id) present?)
                  (AloemacsWindowTree Below top (bottom with-toggled-lock id) earlier later)
                  self)))
        (Right (left right earlier later)
          (if ((left find-view id) present?)
              (AloemacsWindowTree Right (left with-toggled-lock id) right earlier later)
              (if ((right find-view id) present?)
                  (AloemacsWindowTree Right left (right with-toggled-lock id) earlier later)
                  self)))))

    (next-view (id Int) (Option AloemacsView)
      (let ((views (self leaves)))
        ((self next-in views id) case
          (Some (view) (Option Some view))
          (None ()
            (if (views empty?) (Option None) (Option Some (views first)))))))

    (next-in (views (List AloemacsView)) (id Int) (Option AloemacsView)
      (if (views empty?)
          (Option None)
          (let ((remaining (views rest)))
            (if (((views first) id) = id)
                (if (remaining empty?) (Option None) (Option Some (remaining first)))
                (self next-in remaining id)))))

    (any-locked? () Bool
      ((self leaves) fold #f
        (fn (locked? view) (if locked? #t (view locked)))))

    (pictured? () Bool
      ((self leaves) fold #f
        (fn (pictured? view) (if pictured? #t ((view picture) present?)))))

    (without-pictures () AloemacsWindowTree
      (self case
        (Leaf (view)
          (AloemacsWindowTree Leaf (view with (picture (Option None)))))
        (Below (top bottom earlier later)
          (AloemacsWindowTree Below (top without-pictures) (bottom without-pictures) earlier later))
        (Right (left right earlier later)
          (AloemacsWindowTree Right (left without-pictures) (right without-pictures) earlier later))))

    (without-pictures-of (buffer-id Int) AloemacsWindowTree
      (self case
        (Leaf (view)
          (if ((view buffer-id) = buffer-id)
              (AloemacsWindowTree Leaf (view with (picture (Option None))))
              self))
        (Below (top bottom earlier later)
          (AloemacsWindowTree Below
            (top without-pictures-of buffer-id)
            (bottom without-pictures-of buffer-id) earlier later))
        (Right (left right earlier later)
          (AloemacsWindowTree Right
            (left without-pictures-of buffer-id)
            (right without-pictures-of buffer-id) earlier later))))

    ;; Find the immediate sibling, not the sibling of a containing subtree.
    (sibling-for (id Int) (Option AloemacsWindowTree)
      (self case
        (Leaf (view) (Option None))
        (Below (top bottom earlier later)
          (if ((top find-view id) present?)
              (if (top single?) (Option Some bottom) (top sibling-for id))
              (if ((bottom find-view id) present?)
                  (if (bottom single?) (Option Some top) (bottom sibling-for id))
                  (Option None))))
        (Right (left right earlier later)
          (if ((left find-view id) present?)
              (if (left single?) (Option Some right) (left sibling-for id))
              (if ((right find-view id) present?)
                  (if (right single?) (Option Some left) (right sibling-for id))
                  (Option None))))))

    (without-view (id Int) AloemacsWindowTree
      (self case
        (Leaf (view) self)
        (Below (top bottom earlier later)
          (if ((top find-view id) present?)
              (if (top single?) bottom
                  (AloemacsWindowTree Below (top without-view id) bottom earlier later))
              (if ((bottom find-view id) present?)
                  (if (bottom single?) top
                      (AloemacsWindowTree Below top (bottom without-view id) earlier later))
                  self)))
        (Right (left right earlier later)
          (if ((left find-view id) present?)
              (if (left single?) right
                  (AloemacsWindowTree Right (left without-view id) right earlier later))
              (if ((right find-view id) present?)
                  (if (right single?) left
                      (AloemacsWindowTree Right left (right without-view id) earlier later))
                  self)))))

    (with-split (id Int) (fresh-id Int) (scroll-row Int) (scroll-col Int)
                (point Position) (below? Bool) AloemacsWindowTree
      (self case
        (Leaf (view)
          (if ((view id) = id)
              (let ((original
                      (AloemacsWindowTree Leaf
                        (view with
                          (id id)
                          (scroll-row scroll-row)
                          (scroll-col scroll-col)
                          (point point)
                          (locked #f))))
                    (fresh
                      (AloemacsWindowTree Leaf
                        (view with
                          (id fresh-id)
                          (scroll-row scroll-row)
                          (scroll-col scroll-col)
                          (point point)
                          (locked #f)))))
                (if below?
                    (AloemacsWindowTree Below original fresh 1 1)
                    (AloemacsWindowTree Right original fresh 1 1)))
              self))
        (Below (top bottom earlier later)
          (if ((top find-view id) present?)
              (AloemacsWindowTree Below
                (top with-split id fresh-id scroll-row scroll-col point below?) bottom earlier later)
              (if ((bottom find-view id) present?)
                  (AloemacsWindowTree Below top
                    (bottom with-split id fresh-id scroll-row scroll-col point below?) earlier later)
                  self)))
        (Right (left right earlier later)
          (if ((left find-view id) present?)
              (AloemacsWindowTree Right
                (left with-split id fresh-id scroll-row scroll-col point below?) right earlier later)
              (if ((right find-view id) present?)
                  (AloemacsWindowTree Right left
                    (right with-split id fresh-id scroll-row scroll-col point below?) earlier later)
                  self)))))

    (with-view-buffer (id Int) (buffer AloemacsBuffer) AloemacsWindowTree
      (self case
        (Leaf (view)
          (if ((view id) = id)
              (let ((editor (buffer editor)))
                (AloemacsWindowTree Leaf
                  (view with
                    (id id)
                    (buffer-id (buffer id))
                    (scroll-row (editor scroll-row))
                    (scroll-col (editor scroll-col))
                    (point (editor point)))))
              self))
        (Below (top bottom earlier later)
          (if ((top find-view id) present?)
              (AloemacsWindowTree Below (top with-view-buffer id buffer) bottom earlier later)
              (if ((bottom find-view id) present?)
                  (AloemacsWindowTree Below top (bottom with-view-buffer id buffer) earlier later)
                  self)))
        (Right (left right earlier later)
          (if ((left find-view id) present?)
              (AloemacsWindowTree Right (left with-view-buffer id buffer) right earlier later)
              (if ((right find-view id) present?)
                  (AloemacsWindowTree Right left (right with-view-buffer id buffer) earlier later)
                  self)))))

    (retarget-buffer (removed-id Int) (buffer-id Int)
                     (scroll-row Int) (scroll-col Int) (point Position)
                     AloemacsWindowTree
      (self case
        (Leaf (view)
          (if ((view buffer-id) = removed-id)
              (AloemacsWindowTree Leaf
                (view with
                  (buffer-id buffer-id)
                  (scroll-row scroll-row)
                  (scroll-col scroll-col)
                  (point point)))
              self))
        (Below (top bottom earlier later)
          (AloemacsWindowTree Below
            (top retarget-buffer removed-id buffer-id scroll-row scroll-col point)
            (bottom retarget-buffer removed-id buffer-id scroll-row scroll-col point) earlier later))
        (Right (left right earlier later)
          (AloemacsWindowTree Right
            (left retarget-buffer removed-id buffer-id scroll-row scroll-col point)
            (right retarget-buffer removed-id buffer-id scroll-row scroll-col point) earlier later))))))

(define-class AloemacsWindowRect
  (fields
    (x Int)
    (y Int)
    (columns Int)
    (rows Int))
  (methods
    (text-rows () Int
      (if ((self rows) >= 2) ((self rows) - 1) (self rows)))

    (positive? () Bool
      (if ((self columns) > 0) ((self rows) > 0) #f))

    (same? (other AloemacsWindowRect) Bool
      (if ((self x) = (other x))
          (if ((self y) = (other y))
              (if ((self columns) = (other columns))
                  ((self rows) = (other rows)) #f) #f) #f))

    (contains? (column Int) (row Int) Bool
      (if ((self x) <= column)
          (if (column < ((self x) + (self columns)))
              (if ((self y) <= row)
                  (row < ((self y) + (self rows)))
                  #f)
              #f)
          #f))

    (divider (extent Int) Int
      (1 min extent))

    ;; The ceiling of extent * earlier / (earlier + later), clamped so
    ;; neither side drops below least while the extent allows it.
    (cut (extent Int) (least Int) (earlier Int) (later Int) Int
      (let ((share (((extent * earlier) + ((earlier + later) - 1)) / (earlier + later)))
            (lo (least min (extent / 2))))
        (lo max (share min (extent - lo)))))

    (row-cut (earlier Int) (later Int) Int
      (self cut (self rows) 2 earlier later))

    (column-cut (earlier Int) (later Int) Int
      (self cut ((self columns) - (self divider (self columns))) 1 earlier later))

    ;; Below reserves no row.
    (top (earlier Int) (later Int) AloemacsWindowRect
      (self with (rows (self row-cut earlier later))))

    (bottom (earlier Int) (later Int) AloemacsWindowRect
      (let ((cut (self row-cut earlier later)))
        (self with
          (y ((self y) + cut))
          (rows ((self rows) - cut)))))

    (left (earlier Int) (later Int) AloemacsWindowRect
      (self with (columns (self column-cut earlier later))))

    (right (earlier Int) (later Int) AloemacsWindowRect
      (let ((cut (self column-cut earlier later)) (divider (self divider (self columns))))
        (self with
          (x (((self x) + cut) + divider))
          (columns (((self columns) - divider) - cut)))))

    (spaces (remaining Int) String
      (if (remaining <= 0) "" (" " append (self spaces (remaining - 1)))))

    (pad-row (row String) String
      (row append (self spaces ((self columns) - (row len)))))))

;; Both types are now declared; keep the tree/rectangle declaration order.
(define-methods AloemacsWindowTree
  (methods
    (locked-rects-equal? (views (List AloemacsView))
                         (candidate AloemacsWindowTree) (root AloemacsWindowRect) Bool
      (if (views empty?)
          #t
          (let ((view (views first)))
            (if (if (view locked)
                    ((self rect-for (view id) root) case
                      (None () #f)
                      (Some (old)
                        ((candidate rect-for (view id) root) case
                          (None () #f)
                          (Some (new) (old same? new)))))
                    #t)
                (self locked-rects-equal? (views rest) candidate root)
                #f))))

    (rect-for (id Int) (rect AloemacsWindowRect) (Option AloemacsWindowRect)
      (self case
        (Leaf (view)
          (if ((view id) = id) (Option Some rect) (Option None)))
        (Below (top bottom earlier later)
          ((top rect-for id (rect top earlier later)) case
            (Some (found) (Option Some found))
            (None () (bottom rect-for id (rect bottom earlier later)))))
        (Right (left right earlier later)
          ((left rect-for id (rect left earlier later)) case
            (Some (found) (Option Some found))
            (None () (right rect-for id (rect right earlier later)))))))

    ;; The leaf whose rectangle holds the cell, walking the same children
    ;; rect-for walks. The reserved column of a Right split is in neither.
    (view-at (column Int) (row Int) (rect AloemacsWindowRect) (Option AloemacsView)
      (self case
        (Leaf (view)
          (if (rect contains? column row) (Option Some view) (Option None)))
        (Below (top bottom earlier later)
          ((top view-at column row (rect top earlier later)) case
            (Some (found) (Option Some found))
            (None () (bottom view-at column row (rect bottom earlier later)))))
        (Right (left right earlier later)
          ((left view-at column row (rect left earlier later)) case
            (Some (found) (Option Some found))
            (None () (right view-at column row (rect right earlier later)))))))

    (positive-layout? (rect AloemacsWindowRect) Bool
      (self case
        (Leaf (view) (rect positive?))
        (Below (top bottom earlier later)
          (if (top positive-layout? (rect top earlier later))
              (bottom positive-layout? (rect bottom earlier later)) #f))
        (Right (left right earlier later)
          (if (left positive-layout? (rect left earlier later))
              (right positive-layout? (rect right earlier later)) #f))))

    ;; Right reserves one column and paints its divider on every row.
    (right-rows (left-rows (List String)) (right-rows (List String)) (List String)
      (if (left-rows empty?)
          (List empty)
          ((self right-rows (left-rows rest) (right-rows rest))
           cons
           (((left-rows first) append "|") append (right-rows first)))))

    (blank-rows (rect AloemacsWindowRect) (remaining Int) (List String)
      (if (remaining <= 0)
          (List empty)
          ((self blank-rows rect (remaining - 1)) cons (rect pad-row ""))))

    ;; A tall leaf's last row is its bar, lighter on the selected view.
    (built-rows (view AloemacsView) (buffers AloemacsBuffers)
                (rect AloemacsWindowRect) (selected Int) (List String)
      ;; find-id returns a local focused collection; never install it.
      ((buffers find-id (view buffer-id)) case
        (None () (self blank-rows rect (rect rows)))
        (Some (focused)
          (let ((buffer (focused current-buffer)))
            (let ((editor (buffer editor)))
              (let ((lines
                      ((editor frame-rows (rect columns) (rect text-rows)
                         (view scroll-row) (view scroll-col))
                       map (fn (line) (rect pad-row line)))))
                (if ((rect rows) >= 2)
                    ((lines reverse) fold
                      (List of ((AloemacsModeLine new) bar
                        (editor safe-cells
                          ((AloemacsModeLine new) row (buffer name) (rect columns)))
                        ((view id) = selected)))
                      (fn (rows line) (rows cons line)))
                    lines)))))))

    ;; The recorded rows, while every input that built them is unchanged.
    (reused-rows (view AloemacsView) (buffers AloemacsBuffers)
                 (rect AloemacsWindowRect) (selected Int) (Option (List String))
      ((view picture) case
        (None () (Option None))
        (Some (picture)
          ((buffers find-id (view buffer-id)) case
            (None () (Option None))
            (Some (focused)
              (let ((buffer (focused current-buffer)))
                (if (picture matches? (view buffer-id)
                      (((buffer editor) history) len)
                      (view scroll-row) (view scroll-col)
                      (rect columns) (rect rows)
                      (buffer name) ((view id) = selected))
                    (Option Some (picture lines))
                    (Option None))))))))

    ;; A missing buffer gets no picture.
    (picture-for (view AloemacsView) (buffers AloemacsBuffers)
                 (rect AloemacsWindowRect) (selected Int) (Option AloemacsLeafPicture)
      ((buffers find-id (view buffer-id)) case
        (None () (Option None))
        (Some (focused)
          (let ((buffer (focused current-buffer)))
            (Option Some
              (AloemacsLeafPicture new
                (view buffer-id) (((buffer editor) history) len)
                (view scroll-row) (view scroll-col)
                (rect columns) (rect rows)
                (buffer name) ((view id) = selected)
                (self built-rows view buffers rect selected)))))))

    ;; Walk the leaves as frame-rows does. Keep each matching picture.
    (with-pictures (buffers AloemacsBuffers) (rect AloemacsWindowRect) (selected Int)
                   AloemacsWindowTree
      (self case
        (Leaf (view)
          (if ((self reused-rows view buffers rect selected) present?)
              self
              (AloemacsWindowTree Leaf
                (view with (picture (self picture-for view buffers rect selected))))))
        (Below (top bottom earlier later)
          (AloemacsWindowTree Below
            (top with-pictures buffers (rect top earlier later) selected)
            (bottom with-pictures buffers (rect bottom earlier later) selected) earlier later))
        (Right (left right earlier later)
          (AloemacsWindowTree Right
            (left with-pictures buffers (rect left earlier later) selected)
            (right with-pictures buffers (rect right earlier later) selected) earlier later))))

    (frame-rows (buffers AloemacsBuffers) (rect AloemacsWindowRect) (selected Int) (List String)
      (self case
        (Leaf (view)
          ((self reused-rows view buffers rect selected) case
            (Some (lines) lines)
            (None () (self built-rows view buffers rect selected))))
        (Below (top bottom earlier later)
          (((top frame-rows buffers (rect top earlier later) selected) reverse)
           fold
           (bottom frame-rows buffers (rect bottom earlier later) selected)
           (fn (rows row) (rows cons row))))
        (Right (left right earlier later)
          (self right-rows
            (left frame-rows buffers (rect left earlier later) selected)
            (right frame-rows buffers (rect right earlier later) selected)))))))

(define-class AloemacsWindows
  (fields
    (tree AloemacsWindowTree)
    (selected Int)
    (columns Int)
    (rows Int))
  (methods
    (text-rect (columns Int) (rows Int) AloemacsWindowRect
      (AloemacsWindowRect new 0 0 columns (if (rows >= 2) (rows - 1) rows)))

    (fit-rect (columns Int) (rows Int) AloemacsWindowRect
      (let ((root (self text-rect columns rows)))
        (if ((self tree) positive-layout? root)
            (((self tree) rect-for (self selected) root) case
              (None () root)
              (Some (rect) rect))
            root)))

    (split-allowed? (below? Bool) Bool
      (cond
        (((self columns) <= 0) #f)
        (((self rows) <= 0) #f)
        (else
          (((self tree) find-view (self selected)) case
            (None () #f)
            (Some (view)
              (if (view locked)
                  #f
                  ;; Commands judge the nominal leaf, even during fallback.
                  (((self tree) rect-for (self selected)
                     (self text-rect (self columns) (self rows))) case
                    (None () #f)
                    (Some (rect)
                      ;; Below needs two rows per child, so each has a bar.
                      (if (rect positive?)
                          (if below? ((rect rows) >= 4) ((rect columns) >= 3))
                          #f)))))))))

    (with-split (scroll-row Int) (scroll-col Int) (point Position) (below? Bool)
                AloemacsWindows
      (self with
        (tree
          ((self tree) with-split (self selected) ((self tree) fresh-id)
            scroll-row scroll-col point below?))))

    (with-toggled-lock () AloemacsWindows
      (self with (tree ((self tree) with-toggled-lock (self selected)))))

    (delete-allowed? (candidate AloemacsWindowTree) (sibling AloemacsWindowTree) Bool
      (if (if ((self columns) > 0) ((self rows) > 0) #f)
          ((self tree) locked-rects-equal? (candidate leaves) candidate
            (self text-rect (self columns) (self rows)))
          ;; Unknown geometry cannot prove protection of sibling descendants.
          (if (sibling any-locked?) #f #t)))

    (with-buffer (buffer AloemacsBuffer) AloemacsWindows
      (self with (tree ((self tree) with-view-buffer (self selected) buffer))))

    (without-buffer (removed-id Int) (replacement AloemacsBuffer) AloemacsWindows
      ;; Capture the replacement point and origin before traversing any
      ;; affected view.
      (let ((editor (replacement editor)))
        (self with
          (tree
            ((self tree) retarget-buffer removed-id (replacement id)
              (editor scroll-row) (editor scroll-col) (editor point))))))

    (with-size (columns Int) (rows Int) AloemacsWindows
      (if (columns > 0)
          (if (rows > 0)
              (self with
                (columns columns)
                (rows rows))
              self)
          self))))

(define-class AloemacsCommand
  (constructors
    (Newline (fields))
    (BackwardDelete (fields))
    (MoveLeft (fields))
    (MoveRight (fields))
    (MoveUp (fields))
    (MoveDown (fields))
    (LineStart (fields))
    (LineEnd (fields))
    (PageUp (fields))
    (PageDown (fields))
    (BufferStart (fields))
    (BufferEnd (fields))
    (RequestQuit (fields))
    (Undo (fields))
    (SetMark (fields))
    (Kill (fields))
    (KillLine (fields))
    (Yank (fields))
    (Find (fields))
    (Save (fields))
    (SelfInsert (fields))
    (SwitchBuffer (fields))
    (KillBuffer (fields))
    (FindFile (fields))
    (SaveAs (fields))
    (SelectBuffer (fields))
    (SplitBelow (fields))
    (SplitRight (fields))
    (DeleteWindow (fields))
    (OtherWindow (fields))
    (ToggleWindowLock (fields)))
  (methods
    (name () String
      (self case
        (Newline () "newline")
        (BackwardDelete () "backward-delete")
        (MoveLeft () "move-left")
        (MoveRight () "move-right")
        (MoveUp () "move-up")
        (MoveDown () "move-down")
        (LineStart () "line-start")
        (LineEnd () "line-end")
        (PageUp () "page-up")
        (PageDown () "page-down")
        (BufferStart () "buffer-start")
        (BufferEnd () "buffer-end")
        (RequestQuit () "request-quit")
        (Undo () "undo")
        (SetMark () "set-mark")
        (Kill () "kill")
        (KillLine () "kill-line")
        (Yank () "yank")
        (Find () "find")
        (Save () "save")
        (SelfInsert () "self-insert")
        (SwitchBuffer () "switch-buffer")
        (KillBuffer () "kill-buffer")
        (FindFile () "find-file")
        (SaveAs () "save-as")
        (SelectBuffer () "select-buffer")
        (SplitBelow () "split-below")
        (SplitRight () "split-right")
        (DeleteWindow () "delete-window")
        (OtherWindow () "other-window")
        (ToggleWindowLock () "toggle-window-lock")))))

(define-class (AloemacsKeymap B)
  (fields
    (bindings (List B))
    (default (Option AloemacsCommand)))
  (methods
    (lookup (key String) (Option B)
      (self lookup-in (self bindings) key))

    (lookup-in (bindings (List B)) (key String) (Option B)
      (bindings fold
        (Option None)
        (fn (found binding)
          (found case
            (Some (first) (Option Some first))
            (None ()
              (if ((binding key) = key)
                  (Option Some binding)
                  (Option None)))))))))

(define-class AloemacsBinding
  (constructors
    (Command (fields (key String) (command AloemacsCommand)))
    (Prefix
      (fields
        (key String)
        (map (AloemacsKeymap AloemacsBinding)))))
  (methods
    (key () String
      (self case
        (Command (key command) key)
        (Prefix (key map) key)))))

(define-class AloemacsSearchScan
  (fields)
  (methods
    (lines (focused Text) (remaining Int) (query String)
           (Option Position)
      (if (remaining <= 0)
          (Option None)
          (((focused current-line) find query 0) case
            (Some (column)
              (Option Some (Position new (focused focus-line) column)))
            (None ()
              (if (focused has-next?)
                  (self lines (focused focus-down)
                    (remaining - 1) query)
                  (Option None))))))))

;; The mouse string the host reads: `mouse <down|up> <left|middle|right>
;; <column> <row>`, one space between fields, canonical decimals, nothing
;; else. `event?` accepts exactly that grammar; the other reads are defined
;; when it is true.
(define-class AloemacsMouse
  (fields
    (event String))
  (methods
    (event? () Bool
      (if ((self event) starts-with? "mouse ")
          (if ((self action-length) > 0)
              (if ((self button-length) > 0)
                  (if (self decimal? (self column-text))
                      (self decimal? (self row-text))
                      #f)
                  #f)
              #f)
          #f))

    (down? () Bool
      ((self after-mouse) starts-with? "down "))

    (left? () Bool
      ((self after-action) starts-with? "left "))

    (column () Int
      (self decimal-value (self column-text) 0))

    (row () Int
      (self decimal-value (self row-text) 0))

    ;; The rest of the string after each field, from the left.
    (after-mouse () String
      ((self event) drop 6))

    (action-length () Int
      (cond
        (((self after-mouse) starts-with? "down ") 5)
        (((self after-mouse) starts-with? "up ") 3)
        (else 0)))

    (after-action () String
      ((self after-mouse) drop (self action-length)))

    (button-length () Int
      (cond
        (((self after-action) starts-with? "left ") 5)
        (((self after-action) starts-with? "middle ") 7)
        (((self after-action) starts-with? "right ") 6)
        (else 0)))

    (coordinates () String
      ((self after-action) drop (self button-length)))

    (column-text () String
      (((self coordinates) find " " 0) case
        (None () "")
        (Some (space) ((self coordinates) take space))))

    (row-text () String
      (((self coordinates) find " " 0) case
        (None () "")
        (Some (space) ((self coordinates) drop (space + 1)))))

    ;; A digit is one character found in the digit string; its index is its
    ;; value. The length check guards find of "", which succeeds at 0.
    (digit? (text String) Bool
      (if ((text len) = 1)
          (("0123456789" find text 0) present?)
          #f))

    (digits? (text String) Bool
      (if ((text len) = 0)
          #t
          (if (self digit? (text take 1))
              (self digits? (text drop 1))
              #f)))

    ;; A canonical decimal is 0, or a non-zero digit followed by digits.
    (decimal? (text String) Bool
      (if ((text len) = 0)
          #f
          (if ((text len) = 1)
              (self digit? text)
              (if ((text take 1) = "0")
                  #f
                  (self digits? text)))))

    (digit-value (text String) Int
      (("0123456789" find text 0) case
        (None () 0)
        (Some (value) value)))

    (decimal-value (text String) (total Int) Int
      (if ((text len) = 0)
          total
          (self decimal-value (text drop 1)
            ((total * 10) + (self digit-value (text take 1))))))))

(define-class (AloemacsSession H)
  (fields
    (buffers AloemacsBuffers)
    (fs (Fs H))
    (echo String)
    (searching Bool)
    (query String)
    (origin Position)
    (wrapped Bool)
    (failing Bool)
    (kill-ring (List String))
    (pending (Option (AloemacsKeymap AloemacsBinding)))
    (prompt (Option AloemacsPrompt))
    (last-submission (Option String))
    (waiting-command (Option AloemacsCommand))
    (windows AloemacsWindows))
  (methods
    (current-buffer () AloemacsBuffer
      ((self buffers) current-buffer))

    (editor () AloemacsEditor
      ((self current-buffer) editor))

    (path () (Option Path)
      ((self current-buffer) path))

    (with-current-path (path Path) (AloemacsSession H)
      (self with
        (buffers
          ((self buffers) with-current-buffer
            ((self current-buffer) with-path path)))))

    (start-prompt (label String) (AloemacsSession H)
      (cond
        ((self quit) self)
        ((self searching) self)
        (((self pending) present?) self)
        (((self prompt) present?) self)
        (else (self with-active-prompt (AloemacsPrompt new label "" 0 "" (List empty) (List empty) 0)))))

    (with-active-prompt (prompt AloemacsPrompt) (AloemacsSession H)
      (self with (prompt (Option Some prompt))))

    (with-waiting-command (command AloemacsCommand) (AloemacsSession H)
      (self with (waiting-command (Option Some command))))

    (clear-waiting-command () (AloemacsSession H)
      (self with (waiting-command (Option None))))

    (start-command-prompt (command AloemacsCommand) (label String)
                          (AloemacsSession H)
      (cond
        ((self quit) self)
        ((self searching) self)
        (((self pending) present?) self)
        (((self prompt) present?) self)
        (else
          (let ((text
                  (command case
                    (FindFile () (self file-prompt-directory))
                    (SaveAs ()
                      ((self path) case
                        (None () (self file-prompt-directory))
                        (Some (path) (path text))))
                    (else ""))))
            ((self with-active-prompt
               (AloemacsPrompt new label text (text len) "" (List empty) (List empty) 0))
             with-waiting-command command)))))

    (file-prompt-directory () String
      (let ((directory
              ((self path) case
                (None () (((self fs) current) text))
                (Some (path)
                  (((self fs) parent path) case
                    (None () (path text))
                    (Some (parent) (parent text)))))))
        (if ((directory drop ((directory len) - 1)) = "/")
            directory
            (directory append "/"))))

    (completion-note () String
      ((self prompt) case
        (None () "")
        (Some (prompt) (prompt completion-note))))

    (completion-lines () (List String)
      ((self prompt) case
        (None () (List empty))
        (Some (prompt) (prompt completion-lines))))

    (complete-prompt () (AloemacsSession H)
      ((self prompt) case
        (None () self)
        (Some (prompt)
          (if ((self waiting-command) case
                (None () #f)
                (Some (command)
                  (command case
                    (FindFile () #t)
                    (SaveAs () #t)
                    (else #f))))
              (let ((scanner (AloemacsCompletionScan new))
                    (text (prompt text)) (fs (self fs)))
                (let ((offset (scanner split-offset text)))
                  (let ((prefix (text take offset)) (leaf (text drop offset)))
                    (let ((directory
                            (if (prefix = "") (fs current) (fs path prefix))))
                      (let ((entries
                              ((fs inspect directory) case
                                (None () (List empty))
                                (Some (entry)
                                  (entry case
                                    (Directory (path) (fs entries path))
                                    (else (List empty)))))))
                        (let ((matches
                                ((entries fold (List empty)
                                   (fn (acc entry)
                                     (let ((name (fs name (entry path))))
                                       (if (name starts-with? leaf)
                                           (if (name starts-with? ".")
                                               (if (leaf starts-with? ".")
                                                   (acc cons entry) acc)
                                               (acc cons entry))
                                           acc))))
                                 reverse)))
                          (cond
                            ((matches empty?)
                              (self with-active-prompt
                                (prompt with-completion text " [No match]" (List empty))))
                            (((matches len) = 1)
                              (let ((entry (matches first)))
                                (let ((name (fs name (entry path))))
                                  (let ((replacement
                                          ((prefix append name) append
                                            (entry case
                                              (Directory (path) "/")
                                              (else "")))))
                                    (self with-active-prompt
                                      (prompt with-completion replacement
                                        (if (replacement = text) " [Sole completion]" "")
                                        (List empty)))))))
                            (else
                              (let ((common
                                      (scanner common-prefix
                                        (matches map (fn (entry) (fs name (entry path)))))))
                                (if ((common len) > (leaf len))
                                    (self with-active-prompt
                                      (prompt with-completion (prefix append common)
                                        "" (List empty)))
                                    (let ((lines
                                            (matches map
                                              (fn (entry)
                                                ((fs name (entry path)) append
                                                  (entry case
                                                    (Directory (path) "/")
                                                    (else "")))))))
                                      (let ((prepared
                                              (scanner window-lines lines 0)))
                                        (self with-active-prompt
                                          (prompt with-completion-page lines 0 prepared))))))))))))))
              self))))

    (page-completion (key String) (AloemacsSession H)
      (if (cond
            ((key = "page-down") #t)
            ((key = "page-up") #t)
            (else #f))
          ((self prompt) case
            (None () self)
            (Some (prompt)
              (if ((self waiting-command) case
                    (None () #f)
                    (Some (command)
                      (command case
                        (FindFile () #t)
                        (SaveAs () #t)
                        (else #f))))
                  (cond
                    (((prompt completion-note) = "")
                      (if ((prompt completion-lines) empty?)
                          self
                          (let ((matches (prompt completion-matches))
                                (start (prompt completion-start)))
                            (if ((matches len) > 8)
                                (let ((next
                                        (if (key = "page-down")
                                            (if ((start + 7) < (matches len))
                                                (start + 7) start)
                                            (0 max (start - 7)))))
                                  (if (next = start)
                                      self
                                      (self with-active-prompt
                                        (prompt with-completion-page matches next
                                          ((AloemacsCompletionScan new)
                                           window-lines matches next)))))
                                self))))
                    (else self))
                  self)))
          self))

    (run-submitted-command () (AloemacsSession H)
      ((self waiting-command) case
        (None () self)
        (Some (command)
          (((self last-submission) case
            (None () self)
            (Some (submitted)
              (command case
                (FindFile () (self find-file-submitted submitted))
                (SaveAs () (self save-as-submitted submitted))
                (SelectBuffer () (self select-buffer-submitted submitted))
                (else self))))
           clear-waiting-command))))

    (submit-prompt () (AloemacsSession H)
      ((self prompt) case
        (None () self)
        (Some (prompt)
          ((self with
             (prompt
               (if #t (Option None) (Option Some (AloemacsPrompt new "" "" 0 "" (List empty) (List empty) 0))))
             (last-submission (Option Some (prompt text))))
           run-submitted-command))))

    (cancel-prompt () (AloemacsSession H)
      (if ((self prompt) present?)
          (self with
            (prompt (Option None))
            (waiting-command (Option None)))
          ((self waiting-command) case
            (None () self)
            (Some (command) (self clear-waiting-command)))))

    (prompt-key (key String) (AloemacsSession H)
      ((self prompt) case
        (None () self)
        (Some (prompt)
          (cond
            ((key = "tab") (self complete-prompt))
            ((key = "page-down") (self page-completion key))
            ((key = "page-up") (self page-completion key))
            ((key = "backspace") (self with-active-prompt (prompt backward-delete)))
            ((key = "left") (self with-active-prompt (prompt move-left)))
            ((key = "right") (self with-active-prompt (prompt move-right)))
            ((key = "line-start") (self with-active-prompt (prompt line-start)))
            ((key = "line-end") (self with-active-prompt (prompt line-end)))
            ((key = "return") (self submit-prompt))
            ((key = "escape") (self cancel-prompt))
            (((key len) = 1)
              (if (key = "\n")
                  self
                  (self with-active-prompt (prompt insert key))))
            (else self)))))

    (add-buffer (contents String) (AloemacsSession H)
      (let ((session (self end-search)))
        (session selected-buffers
          ((session buffers) insert-after
            (AloemacsBuffer new
              (AloemacsEditor new
                ((Text from-string contents) indexed-value)
                (Position new 0 0) #f 0 0 (List empty)
                (if #t (Option None) (Option Some (Position new 0 0)))
                0)
              (Option None) ((session buffers) fresh-id))))))

    (add-buffer (contents String) (path Path) (AloemacsSession H)
      (let ((session (self end-search)))
        (session selected-buffers
          ((session buffers) insert-after
            (AloemacsBuffer new
              (AloemacsEditor new
                ((Text from-string contents) indexed-value)
                (Position new 0 0) #f 0 0 (List empty)
                (if #t (Option None) (Option Some (Position new 0 0)))
                0)
              (Option Some path) ((session buffers) fresh-id))))))

    (switch-buffer () (AloemacsSession H)
      (let ((session (self end-search)))
        (session selected-buffers ((session buffers) focus-next))))

    (kill-buffer () (AloemacsSession H)
      (let ((session (self end-search)))
        (let ((buffers ((session buffers) remove-current)))
          (session with
            (buffers buffers)
            (echo "")
            (searching #f)
            (query "")
            (origin (Position new 0 0))
            (wrapped #f)
            (failing #f)
            (pending (Option None))
            (windows
              ((session windows) without-buffer ((session current-buffer) id)
                (buffers current-buffer)))))))

    (selected-buffers (buffers AloemacsBuffers) (AloemacsSession H)
      (self with
        (buffers buffers)
        (echo "")
        (searching #f)
        (query "")
        (origin (Position new 0 0))
        (wrapped #f)
        (failing #f)
        (pending (Option None))
        (windows ((self windows) with-buffer (buffers current-buffer)))))

    (with-editor (editor AloemacsEditor) (AloemacsSession H)
      (let ((buffer ((self current-buffer) with-editor editor)))
        (self with
          (buffers ((self buffers) with-current-buffer buffer))
          (windows ((self windows) with-buffer buffer)))))

    (with-kill-state (editor AloemacsEditor) (kill-ring (List String))
                     (AloemacsSession H)
      (let ((buffer ((self current-buffer) with-editor editor)))
        (self with
          (buffers ((self buffers) with-current-buffer buffer))
          (echo "")
          (kill-ring kill-ring)
          (windows ((self windows) with-buffer buffer)))))

    (with-search (editor AloemacsEditor) (searching Bool)
                 (query String) (origin Position)
                 (wrapped Bool) (failing Bool) (AloemacsSession H)
      (let ((buffer ((self current-buffer) with-editor editor)))
        (self with
          (buffers ((self buffers) with-current-buffer buffer))
          (searching searching)
          (query query)
          (origin origin)
          (wrapped wrapped)
          (failing failing)
          (windows ((self windows) with-buffer buffer)))))

    (with-echo (token String) (AloemacsSession H)
      (self with (echo token)))

    (split-below () (AloemacsSession H)
      (self split-window #t))

    (split-right () (AloemacsSession H)
      (self split-window #f))

    (split-window (below? Bool) (AloemacsSession H)
      (let ((windows (self windows))
            (active? (if (self searching) #t ((self prompt) present?))))
        (if (windows split-allowed? below?)
            ;; Capture both points and origins before fitting the selected
            ;; original once.
            (let ((editor (self editor)))
              ((self with
                 (echo (if active? (self echo) ""))
                 (windows
                   (windows with-split (editor scroll-row) (editor scroll-col)
                     (editor point) below?)))
               ensure-visible (windows columns) (windows rows)))
            (if active? self (self with-echo "failed")))))

    ;; The callers store the departing live point and origin before changing
    ;; selection. Entry installs the entered view's place, stores it on that
    ;; view, and applies the buffer-ID reset fields.
    (enter-view (tree AloemacsWindowTree) (view AloemacsView) (AloemacsSession H)
      (((self buffers) find-id (view buffer-id)) case
        (None () self)
        (Some (focused)
          (let ((same-buffer? (((self current-buffer) id) = (view buffer-id)))
                (buffer (focused current-buffer)))
            (let ((entered
                    (buffer with-editor
                      ((buffer editor) install
                        ;; A same-buffer entry during search keeps the match.
                        (if (if same-buffer? (self searching) #f)
                            ((buffer editor) point)
                            (view point))
                        (view scroll-row) (view scroll-col)))))
              (self with
                (buffers (focused with-current-buffer entered))
                (echo
                  (if same-buffer? (self echo)
                      (if ((self prompt) present?) (self echo) "")))
                (searching (if same-buffer? (self searching) #f))
                (query (if same-buffer? (self query) ""))
                (origin (if same-buffer? (self origin) (Position new 0 0)))
                (wrapped (if same-buffer? (self wrapped) #f))
                (failing (if same-buffer? (self failing) #f))
                (pending (if same-buffer? (self pending) (Option None)))
                (windows
                  (((self windows) with
                     (tree tree)
                     (selected (view id)))
                   with-buffer entered))))))))

    (other-window () (AloemacsSession H)
      (if (((self windows) tree) single?)
          self
          (let ((windows ((self windows) with-buffer (self current-buffer))))
            (((windows tree) next-view (windows selected)) case
              (None () self)
              (Some (view) (self enter-view (windows tree) view))))))

    (toggle-window-lock () (AloemacsSession H)
      (self with (windows ((self windows) with-toggled-lock))))

    (delete-refused () (AloemacsSession H)
      (if (self searching) self
          (if ((self prompt) present?) self (self with-echo "failed"))))

    (delete-window () (AloemacsSession H)
      (let ((windows (self windows)))
        (((windows tree) find-view (windows selected)) case
          (None () (self delete-refused))
          (Some (view)
            (if (view locked)
                (self delete-refused)
                (((windows tree) sibling-for (windows selected)) case
                  (None () (self delete-refused))
                  (Some (sibling)
                    (let ((stored ((windows with-buffer (self current-buffer)) tree)))
                      (let ((candidate (stored without-view (windows selected)))
                            (destinations (sibling leaves)))
                        (if (windows delete-allowed? candidate sibling)
                            (if (destinations empty?)
                                (self delete-refused)
                                (self enter-view candidate (destinations first)))
                            (self delete-refused)))))))))))

    (with-prefix (map (AloemacsKeymap AloemacsBinding)) (AloemacsSession H)
      (self with
        (echo "")
        (pending (Option Some map))))

    (clear-prefix () (AloemacsSession H)
      (self with (pending (Option None))))

    (find () (AloemacsSession H)
      (self with-search (self editor) #t "" (self point) #f #f))

    (save-key () (AloemacsSession H)
      ((self save) case
        (None () (self with-echo "failed"))
        (Some (session) (session with-echo "saved"))))

    (set-mark () (AloemacsSession H)
      (self with-kill-state
        ((self editor) with-mark (Option Some (self point)))
        (self kill-ring)))

    (kill-span (span Span) (clear-mark Bool) (AloemacsSession H)
      (((self text) excerpt span) case
        (None () (self with-kill-state (self editor) (self kill-ring)))
        (Some (excerpt)
          (if (excerpt = "")
              (self with-kill-state (self editor) (self kill-ring))
              (((self text) delete span) case
                (None () (self with-kill-state (self editor) (self kill-ring)))
                (Some (result)
                  (let ((edited ((self editor) from-edit result)))
                    (self with-kill-state
                      (if clear-mark
                          (edited clear-mark)
                          (edited keep-valid-mark))
                      ((self kill-ring) cons excerpt)))))))))

    (kill () (AloemacsSession H)
      (((self editor) mark) case
        (None () (self with-kill-state (self editor) (self kill-ring)))
        (Some (mark)
          (let ((point (self point)))
            (if (mark before? point)
                (self kill-span (Span new mark point) #t)
                (self kill-span (Span new point mark) #t))))))

    (kill-line () (AloemacsSession H)
      (let ((point (self point)))
        (((self text) focus-at (point line)) case
          (None () (self with-kill-state (self editor) (self kill-ring)))
          (Some (focused)
            (let ((length (focused line-length))
                  (column (point column)))
              (if (column < length)
                  (self kill-span
                    (Span new point (Position new (point line) length)) #f)
                  (if (column = length)
                      (if (focused has-next?)
                          (self kill-span
                            (Span new point
                              (Position new ((point line) + 1) 0)) #f)
                          (self with-kill-state (self editor) (self kill-ring)))
                      (self with-kill-state (self editor) (self kill-ring)))))))))

    (yank () (AloemacsSession H)
      (if ((self kill-ring) empty?)
          (self with-kill-state (self editor) (self kill-ring))
          (if ((self text) valid-position? (self point))
              (self with-kill-state
                (((self editor) insert ((self kill-ring) first)) keep-valid-mark)
                (self kill-ring))
              (self with-kill-state (self editor) (self kill-ring)))))

    (end-search () (AloemacsSession H)
      (self with-search (self editor) #f "" (Position new 0 0) #f #f))

    (search-hit (query String) (position Position) (wrapped Bool)
                (AloemacsSession H)
      (((self text) focus-at (position line)) case
        (None () (self search-miss query))
        (Some (focused)
          (self with-search
            ((self editor) with-text-and-point focused position)
            #t query (self origin) wrapped #f))))

    (search-miss (query String) (AloemacsSession H)
      (((self text) focus-at ((self origin) line)) case
        (None () (self with-search (self editor) #t query
                    (self origin) #f #t))
        (Some (focused)
          (self with-search
            ((self editor) with-text-and-point focused (self origin))
            #t query (self origin) #f #t))))

    (scan-wrap (start Position) (query String)
               (prefix-found Bool) (prefix-position Position)
               (AloemacsSession H)
      (((self text) focus-at 0) case
        (None () (self search-miss query))
        (Some (first-line)
          (((AloemacsSearchScan new) lines
             first-line (start line) query) case
            (Some (position) (self search-hit query position #t))
            (None ()
              (if prefix-found
                  (self search-hit query prefix-position #t)
                  (self search-miss query)))))))

    (scan-after (focused Text) (start Position) (query String)
                (prefix-found Bool) (prefix-position Position)
                (AloemacsSession H)
      (if (focused has-next?)
          (((AloemacsSearchScan new) lines (focused focus-down)
             ((((self text) lines) len) - ((start line) + 1)) query) case
            (Some (position) (self search-hit query position #f))
            (None () (self scan-wrap start query
                       prefix-found prefix-position)))
          (self scan-wrap start query prefix-found prefix-position)))

    (seek-from (start Position) (query String) (AloemacsSession H)
      (if ((query len) = 0)
          (((self text) focus-at ((self origin) line)) case
            (None () (self with-search (self editor) #t query
                        (self origin) #f #f))
            (Some (focused)
              (self with-search
                ((self editor) with-text-and-point focused (self origin))
                #t query (self origin) #f #f)))
          (((self text) focus-at (start line)) case
            (None () (self search-miss query))
            (Some (focused)
              (let ((line (focused current-line)))
                (let ((suffix (line drop (start column)))
                      (prefix (line take
                                (((start column) + (query len)) - 1))))
                  (let ((combined ((suffix append "\n") append prefix)))
                    ((combined find query 0) case
                      (None ()
                        (self scan-after focused start query
                          #f (Position new 0 0)))
                      (Some (index)
                        (if (index < (suffix len))
                            (self search-hit query
                              (Position new (start line)
                                ((start column) + index)) #f)
                            (self scan-after focused start query
                              #t (Position new (start line)
                                   ((index - (suffix len)) - 1)))))))))))))

    (search-key (key String) (AloemacsSession H)
      (cond
        ((key = "escape") (self end-search))
        ((key = "return") (self end-search))
        ((key = "backspace")
         (self seek-from (self origin)
           ((self query) take (((self query) len) - 1))))
        ((key = "find")
         (cond
           (((self query) = "") (self unchanged))
           ((self failing) (self unchanged))
           ((self wrapped)
            (self with-search (self editor) #t (self query)
              (self origin) #t #t))
           (else
            (self seek-from
              (Position new ((self point) line)
                (((self point) column) + 1))
              (self query)))))
        (((key len) = 1)
         (if (((self editor) safe-cells key) = key)
             (self seek-from (self origin) ((self query) append key))
             ((self end-search) idle-key key)))
        (else ((self end-search) idle-key key))))

    (idle-key (key String) (AloemacsSession H)
      (let ((map
              ((self pending) case
                (None () aloemacs-global-keymap)
                (Some (map) map))))
        ((map lookup key) case
          (Some (binding)
            (binding case
              (Command (bound-key command)
                ((self pending) case
                  (None () (self execute-command command key))
                  (Some (map)
                    ((self clear-prefix) execute-command command key))))
              (Prefix (bound-key next-map) (self with-prefix next-map))))
          (None ()
            ((self pending) case
              (Some (map) ((self clear-prefix) with-echo ""))
              (None ()
                (if ((key len) = 1)
                    ((map default) case
                      (Some (command) (self execute-command command key))
                      (None () (self with-echo "")))
                    (self with-echo ""))))))))

    (execute-command (command AloemacsCommand) (key String) (AloemacsSession H)
      (command case
        (Newline () ((self newline) with-echo ""))
        (BackwardDelete () ((self backward-delete) with-echo ""))
        (MoveLeft () ((self move-left) with-echo ""))
        (MoveRight () ((self move-right) with-echo ""))
        (MoveUp () ((self move-up) with-echo ""))
        (MoveDown () ((self move-down) with-echo ""))
        (LineStart () ((self line-start) with-echo ""))
        (LineEnd () ((self line-end) with-echo ""))
        (PageUp () ((self page-up) with-echo ""))
        (PageDown () ((self page-down) with-echo ""))
        (BufferStart () ((self buffer-start) with-echo ""))
        (BufferEnd () ((self buffer-end) with-echo ""))
        (RequestQuit () ((self request-quit) with-echo ""))
        (Undo () ((self undo) with-echo ""))
        (SetMark () (self set-mark))
        (Kill () (self kill))
        (KillLine () (self kill-line))
        (Yank () (self yank))
        (Find () (self find))
        (Save () (self save-key))
        (SelfInsert () ((self insert key) with-echo ""))
        (SwitchBuffer () (self switch-buffer))
        (KillBuffer () (self kill-buffer))
        (FindFile () (self start-command-prompt command "Find file: "))
        (SaveAs () (self start-command-prompt command "Save as: "))
        (SelectBuffer () (self start-command-prompt command "Buffer: "))
        (SplitBelow () (self split-below))
        (SplitRight () (self split-right))
        (DeleteWindow () (self delete-window))
        (OtherWindow () (self other-window))
        (ToggleWindowLock () (self toggle-window-lock))))

    (unchanged () (AloemacsSession H)
      self)

    (visited (contents String) (path Path) (AloemacsSession H)
      (let ((buffer
              (AloemacsBuffer new
                (AloemacsEditor new
                  ((Text from-string contents) indexed-value)
                  (Position new 0 0) #f 0 0 (List empty)
                  (if #t (Option None) (Option Some (Position new 0 0))) 0)
                (Option Some path) ((self current-buffer) id))))
        (self with
          (buffers ((self buffers) with-current-buffer buffer))
          (echo "")
          (searching #f)
          (query "")
          (origin (Position new 0 0))
          (wrapped #f)
          (failing #f)
          (kill-ring (List empty))
          (pending (Option None))
          (prompt (Option None))
          (waiting-command (Option None))
          (windows
            ;; The new editor keeps this buffer id and can keep history length 0.
            (let ((windows ((self windows) with-buffer buffer)))
              (windows with
                (tree ((windows tree) without-pictures-of (buffer id)))))))))

    (text () Text
      ((self editor) text))

    (point () Position
      ((self editor) point))

    (quit () Bool
      ((self editor) quit))

    (insert (string String) (AloemacsSession H)
      (self with-editor ((self editor) insert string)))

    (newline () (AloemacsSession H)
      (self with-editor ((self editor) newline)))

    (backward-delete () (AloemacsSession H)
      (self with-editor ((self editor) backward-delete)))

    (move-left () (AloemacsSession H)
      (self with-editor ((self editor) move-left)))

    (move-right () (AloemacsSession H)
      (self with-editor ((self editor) move-right)))

    (move-up () (AloemacsSession H)
      (self with-editor ((self editor) move-up)))

    (move-down () (AloemacsSession H)
      (self with-editor ((self editor) move-down)))

    (line-start () (AloemacsSession H)
      (self with-editor ((self editor) line-start)))

    (line-end () (AloemacsSession H)
      (self with-editor ((self editor) line-end)))

    (page-up () (AloemacsSession H)
      (self with-editor ((self editor) page-up)))

    (page-down () (AloemacsSession H)
      (self with-editor ((self editor) page-down)))

    (buffer-start () (AloemacsSession H)
      (self with-editor ((self editor) buffer-start)))

    (buffer-end () (AloemacsSession H)
      (self with-editor ((self editor) buffer-end)))

    (undo () (AloemacsSession H)
      (self with-editor ((self editor) undo)))

    (request-quit () (AloemacsSession H)
      (self with-editor ((self editor) request-quit)))

    (completion-row-count (rows Int) Int
      (if (rows < 2)
          0
          (((self completion-lines) len) min (0 max (rows - 2)))))

    (root-rect (columns Int) (rows Int) AloemacsWindowRect
      (AloemacsWindowRect new 0 0 columns
        (if (rows < 2) rows ((rows - 1) - (self completion-row-count rows)))))

    (fit-rect (columns Int) (rows Int) AloemacsWindowRect
      (let ((root (self root-rect columns rows)) (windows (self windows)))
        (if ((windows tree) positive-layout? root)
            (((windows tree) rect-for (windows selected) root) case
              (None () root)
              (Some (rect) rect))
            root)))

    ;; Accumulate only the first k addressed rows. Their count supplies each
    ;; row's offset without indexing or recursive sends on this session.
    (completion-frame (root AloemacsWindowRect) (columns Int) (rows Int) String
      (let ((count (self completion-row-count rows)) (editor (self editor)))
        (let ((painted
                ((self completion-lines) fold (List empty)
                  (fn (painted line)
                    (if ((painted len) < count)
                        (painted cons
                          ((List of "\u001b[" ((((root rows) + (painted len)) + 1) text)
                             ";1H" (editor safe-cells (line take columns)))
                           fold "" (fn (acc part) (acc append part))))
                        painted)))))
          ((painted reverse) fold "" (fn (acc part) (acc append part))))))

    (frame (columns Int) (rows Int) String
      (let ((windows (self windows)))
        (let ((root (self root-rect columns rows)))
          (if ((windows tree) single?)
              (self single-frame columns rows)
              (if ((windows tree) positive-layout? root)
                  (self multi-frame root columns rows)
                  (self single-frame columns rows))))))

    (echo-row (columns Int) (leaf-rows Int) String
      (let ((label
              ((self path) case
                (None () "untitled")
                (Some (path) (path text)))))
        (let ((row
                ((self prompt) case
                  (Some (prompt) (prompt row))
                  (None ()
                    (if (self searching)
                        (cond
                          ((self failing) ("failing: " append (self query)))
                          ((self wrapped) ("wrapped: " append (self query)))
                          (else ("search: " append (self query))))
                        (cond
                          (((self echo) = "saved") ("saved: " append label))
                          (((self echo) = "failed") ("failed: " append label))
                          (else (if (leaf-rows >= 2) "" label))))))))
          ((self editor) safe-cells (row take columns)))))

    (multi-frame (root AloemacsWindowRect) (columns Int) (rows Int) String
      (let ((editor (self editor)) (windows (self windows)))
        (let ((lines ((windows tree) frame-rows (self buffers) root (windows selected)))
              (selected (self fit-rect columns rows)))
          (let ((body
                  (((lines rest) fold (lines first)
                     (fn (body line) ((body append "\r\n") append line)))
                   append (self completion-frame root columns rows)))
                (text-cursor-row
                  ((((selected y) + ((editor point) line)) - (editor scroll-row)) + 1))
                (text-cursor-column
                  ((((selected x) + ((editor point) column)) - (editor scroll-col)) + 1)))
            (let ((cursor-row
                    (if (rows >= 2)
                        ((self prompt) case
                          (Some (prompt) rows)
                          (None () text-cursor-row))
                        text-cursor-row))
                  (cursor-column
                    (if (rows >= 2)
                        ((self prompt) case
                          (Some (prompt) (prompt screen-column columns))
                          (None () text-cursor-column))
                        text-cursor-column)))
              (editor frame-ansi
                (if (rows >= 2)
                    ((((body append "\u001b[") append (rows text)) append ";1H")
                     append (self echo-row columns (selected rows)))
                    body)
                cursor-row cursor-column))))))

    ;; Keep the editor prefix and its intermediate cursor sequences. Tall
    ;; one-view/fallback frames reserve the root's last row for its name,
    ;; painted as the selected bar.
    (single-frame (columns Int) (rows Int) String
      (let ((editor (self editor))
            (root (self root-rect columns rows)))
        (let ((body (editor frame columns (root text-rows))))
          (if (rows < 2)
              body
              (let ((point (editor point)))
                (let ((cursor-row
                        ((self prompt) case
                          (Some (prompt) rows)
                          (None () (((point line) - (editor scroll-row)) + 1))))
                      (cursor-column
                        ((self prompt) case
                          (Some (prompt) (prompt screen-column columns))
                          (None () (((point column) - (editor scroll-col)) + 1)))))
                  ((List of
                     body
                     "\u001b[?25l"
                     (if ((root rows) >= 2)
                         ((List of "\u001b[" ((root rows) text) ";1H"
                            ((AloemacsModeLine new) bar
                              (editor safe-cells
                                ((AloemacsModeLine new) row
                                  ((self current-buffer) name) columns))
                              #t))
                          fold "" (fn (acc part) (acc append part)))
                         "")
                     (self completion-frame root columns rows)
                     "\u001b["
                     (rows text)
                     ";1H"
                     (self echo-row columns (root rows))
                     "\u001b["
                     (cursor-row text)
                     ";"
                     (cursor-column text)
                     "H"
                     "\u001b[?25h")
                   fold
                   ""
                   (fn (acc part) (acc append part)))))))))

    (ensure-visible (columns Int) (rows Int) (AloemacsSession H)
      (let ((rect (self fit-rect columns rows)))
        (let ((session
                (self with-editor
                  ((self editor) ensure-visible (rect columns) (rect text-rows)))))
          (session with (windows ((session windows) with-size columns rows))))))

    ;; Record each leaf's rows at the root frame paints. One view, or a root
    ;; with no positive layout, records nothing and drops every picture.
    (record-pictures (columns Int) (rows Int) (AloemacsSession H)
      (let ((windows (self windows)) (root (self root-rect columns rows)))
        (if (if ((windows tree) single?) #f ((windows tree) positive-layout? root))
            (self with
              (windows
                (windows with
                  (tree
                    ((windows tree) with-pictures (self buffers) root
                      (windows selected))))))
            (self without-pictures))))

    (without-pictures () (AloemacsSession H)
      (let ((windows (self windows)))
        (if ((windows tree) pictured?)
            (self with (windows (windows with (tree ((windows tree) without-pictures)))))
            self)))

    (file-contents (path Path) (Option String)
      (((self fs) inspect path) case
        (None () (Option Some ""))
        (Some (entry)
          (entry case
            (RegularFile (file) ((self fs) read path))
            (Directory (directory) (Option None))
            (SymbolicLink (link) (Option None))
            (Other (other kind) (Option None))))))

    (visit (path Path) (Option (AloemacsSession H))
      (let ((resolved ((self fs) path (path text))))
        ((self file-contents resolved) case
          (None () (Option None))
          (Some (contents) (Option Some (self visited contents resolved))))))

    (find-file-submitted (submitted String) (AloemacsSession H)
      (if (submitted = "")
          (self with-echo "failed")
          (let ((resolved ((self fs) path submitted)))
            (((self buffers) find-name (resolved text)) case
              (Some (buffers) (self selected-buffers buffers))
              (None ()
                ((self file-contents resolved) case
                  (Some (contents) (self add-buffer contents resolved))
                  (None () (self with-echo "failed"))))))))

    (save-as-submitted (submitted String) (AloemacsSession H)
      (if (submitted = "")
          (self with-echo "failed")
          (let ((resolved ((self fs) path submitted)))
            (((self fs) write resolved ((self text) to-string)) case
              (None () (self with-echo "failed"))
              (Some (contents)
                ((self with-current-path resolved) with-echo "saved"))))))

    (select-buffer-submitted (submitted String) (AloemacsSession H)
      (((self buffers) find-name submitted) case
        (Some (buffers) (self selected-buffers buffers))
        (None () (self with-echo "failed"))))

    (save () (Option (AloemacsSession H))
      ((self path) case
        (None () (Option None))
        (Some (path)
          (((self fs) write path ((self text) to-string)) case
            (None () (Option None))
            (Some (contents) (Option Some (self unchanged)))))))

    (handle-key (key String) (AloemacsSession H)
      (cond
        ((self quit) (self unchanged))
        ((self searching) (self search-key key))
        (((self prompt) present?) (self prompt-key key))
        (else (self idle-key key))))

    ;; The runner sends every read here. A mouse string takes the mouse path;
    ;; any other string is a key and takes handle-key as before.
    (handle-event (event String) (AloemacsSession H)
      (cond
        ((self quit) (self unchanged))
        (((AloemacsMouse new event) event?) (self handle-mouse event))
        (else (self handle-key event))))

    ;; A search, a prompt, or a pending prefix refuses every mouse string.
    ;; Otherwise only a left press reaches the cell.
    (handle-mouse (event String) (AloemacsSession H)
      (cond
        ((self searching) (self unchanged))
        (((self prompt) present?) (self unchanged))
        (((self pending) present?) (self unchanged))
        (else
          (let ((mouse (AloemacsMouse new event)))
            (if (mouse down?)
                (if (mouse left?)
                    (self press-at (mouse column) (mouse row))
                    (self unchanged))
                (self unchanged))))))

    ;; Classify the cell with the geometry the last fit stored, in order:
    ;; echo row, completion row, mode line, text, or no leaf at all.
    (press-at (column Int) (row Int) (AloemacsSession H)
      (let ((windows (self windows)))
        (let ((rows (windows rows))
              (root (self root-rect (windows columns) (windows rows)))
              (count (self completion-row-count (windows rows))))
          (cond
            ((if (rows >= 2) (row = (rows - 1)) #f) (self unchanged))
            ((if (row >= (root rows)) (row < ((root rows) + count)) #f)
             (self unchanged))
            (else
              (((windows tree) view-at column row root) case
                (None () (self unchanged))
                (Some (view)
                  (((windows tree) rect-for (view id) root) case
                    (None () (self unchanged))
                    (Some (rect)
                      (if (if ((rect rows) >= 2)
                              (row = (((rect y) + (rect rows)) - 1))
                              #f)
                          (self press-mode-line view rect (column - (rect x)))
                          (self place-in view
                            ((view scroll-row) + (row - (rect y)))
                            ((view scroll-col) + (column - (rect x))))))))))))))

    ;; A label cell on a mode line selects that window, then runs the
    ;; window command the label names. Every other mode-line cell leaves
    ;; the session as it was.
    (press-mode-line (view AloemacsView) (rect AloemacsWindowRect) (index Int)
                     (AloemacsSession H)
      (let ((label ((AloemacsModeLine new) label-at (rect columns) index)))
        (if (label = "")
            (self unchanged)
            ((self select-view view) case
              (None () (self unchanged))
              (Some (selected) (selected button-send label))))))

    ;; The selected view is already selected. Another view takes the
    ;; other-window handoff: store the departing view, then enter the
    ;; pressed one. A view the stored tree lacks is None.
    (select-view (view AloemacsView) (Option (AloemacsSession H))
      (if ((view id) = ((self windows) selected))
          (Option Some self)
          (let ((stored ((self windows) with-buffer (self current-buffer))))
            (((stored tree) find-view (view id)) case
              (None () (Option None))
              (Some (stored-view)
                (Option Some (self enter-view (stored tree) stored-view)))))))

    ;; The window command a label names, on the session whose window is
    ;; already selected.
    (button-send (label String) (AloemacsSession H)
      (cond
        ((label = "\u2195") (self split-below))
        ((label = "\u2194") (self split-right))
        ((label = "\u00d7") (self delete-window))
        (else (self unchanged))))

    ;; The selected leaf places directly. Another leaf takes the same
    ;; handoff a label press takes, through select-view, then places.
    (place-in (view AloemacsView) (line Int) (column Int) (AloemacsSession H)
      ((self select-view view) case
        (None () self)
        (Some (entered) (entered place-at line column))))

    ;; with-editor stores the placed point on the selected view. The origin
    ;; is not refitted here; the runner's next fit is the fit.
    (place-at (line Int) (column Int) (AloemacsSession H)
      ((self with-editor ((self editor) place line column)) with-echo ""))))

(define aloemacs-self-insert-command (AloemacsCommand SelfInsert))
(define aloemacs-save-command (AloemacsCommand Save))

(define aloemacs-ctrl-x-keymap
  (AloemacsKeymap new
    (List of
      (AloemacsBinding Command "save" aloemacs-save-command)
      (AloemacsBinding Command "find" (AloemacsCommand FindFile))
      (AloemacsBinding Command "kill" (AloemacsCommand SaveAs))
      (AloemacsBinding Command "b" (AloemacsCommand SelectBuffer))
      (AloemacsBinding Command "2" (AloemacsCommand SplitBelow))
      (AloemacsBinding Command "3" (AloemacsCommand SplitRight))
      (AloemacsBinding Command "0" (AloemacsCommand DeleteWindow))
      (AloemacsBinding Command "o" (AloemacsCommand OtherWindow))
      (AloemacsBinding Command "l" (AloemacsCommand ToggleWindowLock)))
    (if #t
        (Option None)
        (Option Some aloemacs-self-insert-command))))

(define aloemacs-global-keymap
  (AloemacsKeymap new
    (List of
      (AloemacsBinding Command "return" (AloemacsCommand Newline))
      (AloemacsBinding Command "backspace" (AloemacsCommand BackwardDelete))
      (AloemacsBinding Command "left" (AloemacsCommand MoveLeft))
      (AloemacsBinding Command "right" (AloemacsCommand MoveRight))
      (AloemacsBinding Command "up" (AloemacsCommand MoveUp))
      (AloemacsBinding Command "down" (AloemacsCommand MoveDown))
      (AloemacsBinding Command "line-start" (AloemacsCommand LineStart))
      (AloemacsBinding Command "line-end" (AloemacsCommand LineEnd))
      (AloemacsBinding Command "page-up" (AloemacsCommand PageUp))
      (AloemacsBinding Command "page-down" (AloemacsCommand PageDown))
      (AloemacsBinding Command "buffer-start" (AloemacsCommand BufferStart))
      (AloemacsBinding Command "buffer-end" (AloemacsCommand BufferEnd))
      (AloemacsBinding Command "escape" (AloemacsCommand RequestQuit))
      (AloemacsBinding Command "undo" (AloemacsCommand Undo))
      (AloemacsBinding Command "mark" (AloemacsCommand SetMark))
      (AloemacsBinding Command "kill" (AloemacsCommand Kill))
      (AloemacsBinding Command "kill-line" (AloemacsCommand KillLine))
      (AloemacsBinding Command "yank" (AloemacsCommand Yank))
      (AloemacsBinding Command "find" (AloemacsCommand Find))
      (AloemacsBinding Command "save" aloemacs-save-command)
      (AloemacsBinding Prefix "ctrl-x" aloemacs-ctrl-x-keymap))
    (Option Some aloemacs-self-insert-command)))
