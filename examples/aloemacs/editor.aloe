(load "../../lib/text.aloe")

(define-class UndoFrame
  (fields
    (text Text)
    (point Position)
    (scroll-row Int)
    (scroll-col Int))
  (methods))

(define-class AloemacsEditor
  (fields
    (text Text)
    (point Position)
    (quit Bool)
    (scroll-row Int)
    (scroll-col Int)
    (history (List UndoFrame)))
  (methods
    (fit-origin (point Int) (origin Int) (size Int) Int
      ((if (point < origin)
           point
           (if (point >= (origin + size))
               ((point - size) + 1)
               origin)) max 0))

    (ensure-visible (columns Int) (rows Int) AloemacsEditor
      (let ((point (self point)))
        (AloemacsEditor new
          (self text)
          point
          (self quit)
          (self fit-origin (point line) (self scroll-row) rows)
          (self fit-origin (point column) (self scroll-col) columns)
          (self history))))

    (render-rows
      (text Text)
      (left Int)
      (columns Int)
      (remaining Int)
      (has-line Bool)
      String
      (let ((row
             (if has-line
                 (((text current-line) drop left) take columns)
                 "")))
        (if (remaining = 1)
            row
            (let ((has-next (if has-line (text has-next?) #f)))
              ((row append "\r\n") append
                (self render-rows
                  (if has-next (text focus-down) text)
                  left
                  columns
                  (remaining - 1)
                  has-next))))))

    (frame-ansi (body String) (cursor-row Int) (cursor-column Int) String
      ((List of
         "\u001b[?25l"
         "\u001b[2J"
         "\u001b[H"
         body
         "\u001b["
         (cursor-row text)
         ";"
         (cursor-column text)
         "H"
         "\u001b[?25h")
       fold
       ""
       (fn (acc s) (acc append s))))

    (frame (columns Int) (rows Int) String
      (let ((point (self point)))
        (let ((top (self scroll-row))
              (left (self scroll-col)))
          (let ((cursor-row (((point line) - top) + 1))
                (cursor-column (((point column) - left) + 1)))
            (((self text) focus-at (point line)) case
              (None ()
                (self frame-ansi "" cursor-row cursor-column))
              (Some (focused)
                ((focused focus-at top) case
                  (None ()
                    (self frame-ansi "" cursor-row cursor-column))
                  (Some (at-top)
                    (self frame-ansi
                      (self render-rows
                        at-top
                        left
                        columns
                        rows
                        #t)
                      cursor-row
                      cursor-column)))))))))

    (unchanged () AloemacsEditor
      (AloemacsEditor new
        (self text)
        (self point)
        (self quit)
        (self scroll-row)
        (self scroll-col)
        (self history)))

    (with-text-and-point (text Text) (point Position) AloemacsEditor
      (AloemacsEditor new
        text
        point
        (self quit)
        (self scroll-row)
        (self scroll-col)
        (self history)))

    (from-edit (result EditResult) AloemacsEditor
      (AloemacsEditor new
        (result text)
        (result position)
        (self quit)
        (self scroll-row)
        (self scroll-col)
        ((self history) cons
          (UndoFrame new
            (self text)
            (self point)
            (self scroll-row)
            (self scroll-col)))))

    (undo () AloemacsEditor
      (if ((self history) empty?)
          (self unchanged)
          (let ((frame ((self history) first)))
            (AloemacsEditor new
              (frame text)
              (frame point)
              (self quit)
              (frame scroll-row)
              (frame scroll-col)
              ((self history) rest)))))

    (insert (string String) AloemacsEditor
      (((self text) insert (self point) string) case
        (None () (self unchanged))
        (Some (result) (self from-edit result))))

    (newline () AloemacsEditor
      (((self text) newline (self point)) case
        (None () (self unchanged))
        (Some (result) (self from-edit result))))

    (backward-delete () AloemacsEditor
      (let ((point (self point)))
        (if ((point column) > 0)
            (let ((span
                   (Span new
                     (Position new
                       (point line)
                       ((point column) - 1))
                     point)))
              (((self text) delete span) case
                (None () (self unchanged))
                (Some (result) (self from-edit result))))
            (if ((point line) > 0)
                (((self text) focus-at (point line)) case
                  (None () (self unchanged))
                  (Some (focused)
                    (if (focused has-previous?)
                        (let ((previous (focused focus-up)))
                          (let ((span
                                 (Span new
                                   (Position new
                                     ((point line) - 1)
                                     (previous line-length))
                                   point)))
                            ((focused delete span) case
                              (None () (self unchanged))
                              (Some (result) (self from-edit result)))))
                        (self unchanged))))
                (self unchanged)))))

    (move-left () AloemacsEditor
      (let ((point (self point)))
        (if ((point column) = 0)
            (if ((point line) = 0)
                (self unchanged)
                (((self text) focus-at (point line)) case
                  (None () (self unchanged))
                  (Some (focused)
                    (if (focused has-previous?)
                        (let ((previous (focused focus-up)))
                          (self with-text-and-point previous
                            (Position new
                              ((point line) - 1)
                              (previous line-length))))
                        (self unchanged)))))
            (((self text) focus-at (point line)) case
              (None () (self unchanged))
              (Some (focused)
                (self with-text-and-point focused
                  (Position new
                    (point line)
                    ((point column) - 1))))))))

    (move-right () AloemacsEditor
      (let ((point (self point)))
        (((self text) focus-at (point line)) case
          (None () (self unchanged))
          (Some (focused)
            (let ((length (focused line-length)))
              (if ((point column) < length)
                  (self with-text-and-point focused
                    (Position new
                      (point line)
                      ((point column) + 1)))
                  (if (focused has-next?)
                      (self with-text-and-point (focused focus-down)
                        (Position new
                          ((point line) + 1)
                          0))
                      (self unchanged))))))))

    (move-up () AloemacsEditor
      (let ((point (self point)))
        (if ((point line) = 0)
            (self unchanged)
            (((self text) focus-at (point line)) case
              (None () (self unchanged))
              (Some (focused)
                (if (focused has-previous?)
                    (let ((previous (focused focus-up)))
                      (self with-text-and-point previous
                        (Position new
                          ((point line) - 1)
                          ((point column) min (previous line-length)))))
                    (self unchanged)))))))

    (move-down () AloemacsEditor
      (let ((point (self point)))
        (((self text) focus-at (point line)) case
          (None () (self unchanged))
          (Some (focused)
            (if (focused has-next?)
                (let ((next (focused focus-down)))
                  (self with-text-and-point next
                    (Position new
                      ((point line) + 1)
                      ((point column) min (next line-length)))))
                (self unchanged))))))

    (request-quit () AloemacsEditor
      (AloemacsEditor new
        (self text)
        (self point)
        #t
        (self scroll-row)
        (self scroll-col)
        (self history)))

    (handle-key (key String) AloemacsEditor
      (cond
        ((self quit) (self unchanged))
        ((key = "return") (self newline))
        ((key = "backspace") (self backward-delete))
        ((key = "left") (self move-left))
        ((key = "right") (self move-right))
        ((key = "up") (self move-up))
        ((key = "down") (self move-down))
        ((key = "escape") (self request-quit))
        ((key = "undo") (self undo))
        (((key len) = 1) (self insert key))
        (else (self unchanged))))))
