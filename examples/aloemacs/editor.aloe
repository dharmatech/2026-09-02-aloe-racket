(load "../../lib/text.aloe")

(define-class AloemacsEditor
  (fields
    (text Text)
    (point Position)
    (quit Bool))
  (methods
    (line-length (text Text) Int
      ((text current-line) len))

    (clamp-column (column Int) (text Text) Int
      (let ((length (self line-length text)))
        (if (column > length)
            length
            column)))

    (max-zero (value Int) Int
      (if (value < 0)
          0
          value))

    (viewport-top (text Text) (top Int) Text
      (if ((text focus-line) = top)
          text
          (self viewport-top (text focus-up) top)))

    (render-rows
      (text Text)
      (left Int)
      (columns Int)
      (remaining Int)
      (has-line Bool)
      String
      (let ((row
             (if has-line
                 (((text current-line) drop left) take columns)
                 "")))
        (if (remaining = 1)
            row
            (let ((has-next (if has-line (text has-next?) #f)))
              ((row append "\r\n") append
                (self render-rows
                  (if has-next (text focus-down) text)
                  left
                  columns
                  (remaining - 1)
                  has-next))))))

    (frame-ansi (body String) (cursor-row Int) (cursor-column Int) String
      ((List of
         "\u001b[?25l"
         "\u001b[2J"
         "\u001b[H"
         body
         "\u001b["
         (cursor-row text)
         ";"
         (cursor-column text)
         "H"
         "\u001b[?25h")
       fold
       ""
       (fn (acc s) (acc append s))))

    (frame (columns Int) (rows Int) String
      (let ((point (self point)))
        (let ((top
               (self max-zero
                 ((point line) - (rows - 1))))
              (left
               (self max-zero
                 ((point column) - (columns - 1)))))
          (let ((cursor-row (((point line) - top) + 1))
                (cursor-column (((point column) - left) + 1)))
            (((self text) focus-at (point line)) case
              (None ()
                (self frame-ansi "" cursor-row cursor-column))
              (Some (focused)
                (self frame-ansi
                  (self render-rows
                    (self viewport-top focused top)
                    left
                    columns
                    rows
                    #t)
                  cursor-row
                  cursor-column)))))))

    (unchanged () AloemacsEditor
      (AloemacsEditor new
        (self text)
        (self point)
        (self quit)))

    (with-text-and-point (text Text) (point Position) AloemacsEditor
      (AloemacsEditor new
        text
        point
        (self quit)))

    (from-edit (result EditResult) AloemacsEditor
      (AloemacsEditor new
        (result text)
        (result position)
        (self quit)))

    (insert (string String) AloemacsEditor
      (((self text) insert (self point) string) case
        (None () (self unchanged))
        (Some (result) (self from-edit result))))

    (newline () AloemacsEditor
      (((self text) newline (self point)) case
        (None () (self unchanged))
        (Some (result) (self from-edit result))))

    (backward-delete () AloemacsEditor
      (let ((point (self point)))
        (if ((point column) > 0)
            (let ((span
                   (Span new
                     (Position new
                       (point line)
                       ((point column) - 1))
                     point)))
              (((self text) delete span) case
                (None () (self unchanged))
                (Some (result) (self from-edit result))))
            (if ((point line) > 0)
                (((self text) focus-at (point line)) case
                  (None () (self unchanged))
                  (Some (focused)
                    (if (focused has-previous?)
                        (let ((previous (focused focus-up)))
                          (let ((span
                                 (Span new
                                   (Position new
                                     ((point line) - 1)
                                     (self line-length previous))
                                   point)))
                            ((focused delete span) case
                              (None () (self unchanged))
                              (Some (result) (self from-edit result)))))
                        (self unchanged))))
                (self unchanged)))))

    (move-left () AloemacsEditor
      (let ((point (self point)))
        (if ((point column) = 0)
            (if ((point line) = 0)
                (self unchanged)
                (((self text) focus-at (point line)) case
                  (None () (self unchanged))
                  (Some (focused)
                    (if (focused has-previous?)
                        (let ((previous (focused focus-up)))
                          (self with-text-and-point previous
                            (Position new
                              ((point line) - 1)
                              (self line-length previous))))
                        (self unchanged)))))
            (((self text) focus-at (point line)) case
              (None () (self unchanged))
              (Some (focused)
                (self with-text-and-point focused
                  (Position new
                    (point line)
                    ((point column) - 1))))))))

    (move-right () AloemacsEditor
      (let ((point (self point)))
        (((self text) focus-at (point line)) case
          (None () (self unchanged))
          (Some (focused)
            (let ((length (self line-length focused)))
              (if ((point column) < length)
                  (self with-text-and-point focused
                    (Position new
                      (point line)
                      ((point column) + 1)))
                  (if (focused has-next?)
                      (self with-text-and-point (focused focus-down)
                        (Position new
                          ((point line) + 1)
                          0))
                      (self unchanged))))))))

    (move-up () AloemacsEditor
      (let ((point (self point)))
        (if ((point line) = 0)
            (self unchanged)
            (((self text) focus-at (point line)) case
              (None () (self unchanged))
              (Some (focused)
                (if (focused has-previous?)
                    (let ((previous (focused focus-up)))
                      (self with-text-and-point previous
                        (Position new
                          ((point line) - 1)
                          (self clamp-column (point column) previous))))
                    (self unchanged)))))))

    (move-down () AloemacsEditor
      (let ((point (self point)))
        (((self text) focus-at (point line)) case
          (None () (self unchanged))
          (Some (focused)
            (if (focused has-next?)
                (let ((next (focused focus-down)))
                  (self with-text-and-point next
                    (Position new
                      ((point line) + 1)
                      (self clamp-column (point column) next))))
                (self unchanged))))))

    (request-quit () AloemacsEditor
      (AloemacsEditor new
        (self text)
        (self point)
        #t))

    (handle-key (key String) AloemacsEditor
      (cond
        ((self quit) (self unchanged))
        ((key = "return") (self newline))
        ((key = "backspace") (self backward-delete))
        ((key = "left") (self move-left))
        ((key = "right") (self move-right))
        ((key = "up") (self move-up))
        ((key = "down") (self move-down))
        ((key = "escape") (self request-quit))
        (((key len) = 1) (self insert key))
        (else (self unchanged))))))
