(load "../../lib/text.aloe")

(define-class AloemacsEditor
  (fields
    (text Text)
    (point Position)
    (quit Bool))
  (methods
    (line-length (line Int) Int
      (let ((selected
             (((self text) lines) fold
               (Position new 0 0)
               (fn (cursor current-line)
                 (if ((cursor line) = line)
                     (Position new
                       ((cursor line) + 1)
                       (current-line len))
                     (Position new
                       ((cursor line) + 1)
                       (cursor column)))))))
        (selected column)))

    (clamp-column (column Int) (line Int) Int
      (let ((length (self line-length line)))
        (if (column > length)
            length
            column)))

    (max-zero (value Int) Int
      (if (value < 0)
          0
          value))

    (source-line (lines (List String)) (index Int) String
      (if (lines empty?)
          ""
          (if (index = 0)
              (lines first)
              (self source-line (lines rest) (index - 1)))))

    (render-rows
      (lines (List String))
      (source-index Int)
      (left Int)
      (columns Int)
      (remaining Int)
      String
      (let ((row
             (((self source-line lines source-index) drop left)
              take columns)))
        (if (remaining = 1)
            row
            ((row append "\r\n") append
              (self render-rows
                lines
                (source-index + 1)
                left
                columns
                (remaining - 1))))))

    (frame-ansi (body String) (cursor-row Int) (cursor-column Int) String
      ((List of
         "\u001b[?25l"
         "\u001b[2J"
         "\u001b[H"
         body
         "\u001b["
         (cursor-row text)
         ";"
         (cursor-column text)
         "H"
         "\u001b[?25h")
       fold
       ""
       (fn (acc s) (acc append s))))

    (frame (columns Int) (rows Int) String
      (let ((point (self point)))
        (let ((top
               (self max-zero
                 ((point line) - (rows - 1))))
              (left
               (self max-zero
                 ((point column) - (columns - 1)))))
          (let ((body
                 (self render-rows
                   ((self text) lines)
                   top
                   left
                   columns
                   rows))
                (cursor-row (((point line) - top) + 1))
                (cursor-column (((point column) - left) + 1)))
            (self frame-ansi body cursor-row cursor-column)))))

    (unchanged () AloemacsEditor
      (AloemacsEditor new
        (self text)
        (self point)
        (self quit)))

    (with-point (point Position) AloemacsEditor
      (AloemacsEditor new
        (self text)
        point
        (self quit)))

    (from-edit (result EditResult) AloemacsEditor
      (AloemacsEditor new
        (result text)
        (result position)
        (self quit)))

    (insert (string String) AloemacsEditor
      (((self text) insert (self point) string) case
        (None () (self unchanged))
        (Some (result) (self from-edit result))))

    (newline () AloemacsEditor
      (((self text) newline (self point)) case
        (None () (self unchanged))
        (Some (result) (self from-edit result))))

    (backward-delete () AloemacsEditor
      (let ((point (self point)))
        (if ((point column) > 0)
            (let ((span
                   (Span new
                     (Position new
                       (point line)
                       ((point column) - 1))
                     point)))
              (((self text) delete span) case
                (None () (self unchanged))
                (Some (result) (self from-edit result))))
            (if ((point line) > 0)
                (let ((span
                       (Span new
                         (Position new
                           ((point line) - 1)
                           (self line-length ((point line) - 1)))
                         point)))
                  (((self text) delete span) case
                    (None () (self unchanged))
                    (Some (result) (self from-edit result))))
                (self unchanged)))))

    (move-left () AloemacsEditor
      (let ((point (self point)))
        (if ((point column) > 0)
            (self with-point
              (Position new
                (point line)
                ((point column) - 1)))
            (if ((point line) > 0)
                (self with-point
                  (Position new
                    ((point line) - 1)
                    (self line-length ((point line) - 1))))
                (self unchanged)))))

    (move-right () AloemacsEditor
      (let ((point (self point))
            (line-count (((self text) lines) len)))
        (let ((line-length (self line-length (point line))))
          (if ((point column) < line-length)
              (self with-point
                (Position new
                  (point line)
                  ((point column) + 1)))
              (if ((point line) < (line-count - 1))
                  (self with-point
                    (Position new
                      ((point line) + 1)
                      0))
                  (self unchanged))))))

    (move-up () AloemacsEditor
      (let ((point (self point)))
        (if ((point line) = 0)
            (self unchanged)
            (self with-point
              (Position new
                ((point line) - 1)
                (self clamp-column
                  (point column)
                  ((point line) - 1)))))))

    (move-down () AloemacsEditor
      (let ((point (self point))
            (line-count (((self text) lines) len)))
        (if ((point line) = (line-count - 1))
            (self unchanged)
            (self with-point
              (Position new
                ((point line) + 1)
                (self clamp-column
                  (point column)
                  ((point line) + 1)))))))

    (request-quit () AloemacsEditor
      (AloemacsEditor new
        (self text)
        (self point)
        #t))

    (handle-key (key String) AloemacsEditor
      (cond
        ((self quit) (self unchanged))
        ((key = "return") (self newline))
        ((key = "backspace") (self backward-delete))
        ((key = "left") (self move-left))
        ((key = "right") (self move-right))
        ((key = "up") (self move-up))
        ((key = "down") (self move-down))
        ((key = "escape") (self request-quit))
        (((key len) = 1) (self insert key))
        (else (self unchanged))))))
