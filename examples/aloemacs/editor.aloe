(load "../../lib/text.aloe")

(define-class AloemacsEditor
  (fields
    (text Text)
    (point Position)
    (quit Bool))
  (methods
    (line-length (line Int) Int
      (let ((selected
             (((self text) lines) fold
               (Position new 0 0)
               (fn (cursor current-line)
                 (if ((cursor line) = line)
                     (Position new
                       ((cursor line) + 1)
                       (current-line len))
                     (Position new
                       ((cursor line) + 1)
                       (cursor column)))))))
        (selected column)))

    (clamp-column (column Int) (line Int) Int
      (let ((length (self line-length line)))
        (if (column > length)
            length
            column)))

    (max-zero (value Int) Int
      (if (value < 0)
          0
          value))

    (source-line (lines (List String)) (index Int) String
      (if (lines empty?)
          ""
          (if (index = 0)
              (lines first)
              (self source-line (lines rest) (index - 1)))))

    (render-rows
      (lines (List String))
      (source-index Int)
      (left Int)
      (columns Int)
      (remaining Int)
      String
      (let ((row
             (((self source-line lines source-index) drop left)
              take columns)))
        (if (remaining = 1)
            row
            ((row append "\r\n") append
              (self render-rows
                lines
                (source-index + 1)
                left
                columns
                (remaining - 1))))))

    (frame-ansi (body String) (cursor-row Int) (cursor-column Int) String
      ("\u001b[?25l" append
        ("\u001b[2J" append
          ("\u001b[H" append
            (body append
              ("\u001b[" append
                ((cursor-row text) append
                  (";" append
                    ((cursor-column text) append
                      ("H" append "\u001b[?25h"))))))))))

    (frame (columns Int) (rows Int) String
      (let ((point (self point)))
        (let ((top
               (self max-zero
                 ((point line) - (rows - 1))))
              (left
               (self max-zero
                 ((point column) - (columns - 1)))))
          (let ((body
                 (self render-rows
                   ((self text) lines)
                   top
                   left
                   columns
                   rows))
                (cursor-row (((point line) - top) + 1))
                (cursor-column (((point column) - left) + 1)))
            (self frame-ansi body cursor-row cursor-column)))))

    (insert (string String) AloemacsEditor
      (((self text) insert (self point) string) case
        (None ()
          (AloemacsEditor new
            (self text)
            (self point)
            (self quit)))
        (Some (result)
          (AloemacsEditor new
            (result text)
            (result position)
            (self quit)))))

    (newline () AloemacsEditor
      (((self text) newline (self point)) case
        (None ()
          (AloemacsEditor new
            (self text)
            (self point)
            (self quit)))
        (Some (result)
          (AloemacsEditor new
            (result text)
            (result position)
            (self quit)))))

    (backward-delete () AloemacsEditor
      (let ((point (self point)))
        (if ((point column) > 0)
            (let ((span
                   (Span new
                     (Position new
                       (point line)
                       ((point column) - 1))
                     point)))
              (((self text) delete span) case
                (None ()
                  (AloemacsEditor new
                    (self text)
                    point
                    (self quit)))
                (Some (result)
                  (AloemacsEditor new
                    (result text)
                    (result position)
                    (self quit)))))
            (if ((point line) > 0)
                (let ((span
                       (Span new
                         (Position new
                           ((point line) - 1)
                           (self line-length ((point line) - 1)))
                         point)))
                  (((self text) delete span) case
                    (None ()
                      (AloemacsEditor new
                        (self text)
                        point
                        (self quit)))
                    (Some (result)
                      (AloemacsEditor new
                        (result text)
                        (result position)
                        (self quit)))))
                (AloemacsEditor new
                  (self text)
                  point
                  (self quit))))))

    (move-left () AloemacsEditor
      (let ((point (self point)))
        (if ((point column) > 0)
            (AloemacsEditor new
              (self text)
              (Position new
                (point line)
                ((point column) - 1))
              (self quit))
            (if ((point line) > 0)
                (AloemacsEditor new
                  (self text)
                  (Position new
                    ((point line) - 1)
                    (self line-length ((point line) - 1)))
                  (self quit))
                (AloemacsEditor new
                  (self text)
                  point
                  (self quit))))))

    (move-right () AloemacsEditor
      (let ((point (self point))
            (line-count (((self text) lines) len)))
        (let ((line-length (self line-length (point line))))
          (if ((point column) < line-length)
              (AloemacsEditor new
                (self text)
                (Position new
                  (point line)
                  ((point column) + 1))
                (self quit))
              (if ((point line) < (line-count - 1))
                  (AloemacsEditor new
                    (self text)
                    (Position new
                      ((point line) + 1)
                      0)
                    (self quit))
                  (AloemacsEditor new
                    (self text)
                    point
                    (self quit)))))))

    (move-up () AloemacsEditor
      (let ((point (self point)))
        (if ((point line) = 0)
            (AloemacsEditor new
              (self text)
              point
              (self quit))
            (AloemacsEditor new
              (self text)
              (Position new
                ((point line) - 1)
                (self clamp-column
                  (point column)
                  ((point line) - 1)))
              (self quit)))))

    (move-down () AloemacsEditor
      (let ((point (self point))
            (line-count (((self text) lines) len)))
        (if ((point line) = (line-count - 1))
            (AloemacsEditor new
              (self text)
              point
              (self quit))
            (AloemacsEditor new
              (self text)
              (Position new
                ((point line) + 1)
                (self clamp-column
                  (point column)
                  ((point line) + 1)))
              (self quit)))))

    (request-quit () AloemacsEditor
      (AloemacsEditor new
        (self text)
        (self point)
        #t))

    (handle-key (key String) AloemacsEditor
      (if (self quit)
          (AloemacsEditor new
            (self text)
            (self point)
            (self quit))
          (if (key = "return")
              (self newline)
              (if (key = "backspace")
                  (self backward-delete)
                  (if (key = "left")
                      (self move-left)
                      (if (key = "right")
                          (self move-right)
                          (if (key = "up")
                              (self move-up)
                              (if (key = "down")
                                  (self move-down)
                                  (if (key = "escape")
                                      (self request-quit)
                                      (if ((key len) = 1)
                                          (self insert key)
                                          (AloemacsEditor new
                                            (self text)
                                            (self point)
                                            (self quit))))))))))))))
