(load "../../lib/text.aloe")

(define-class UndoFrame
  (fields
    (text Text)
    (point Position)
    (scroll-row Int)
    (scroll-col Int))
  (methods))

;; Codes 0–31, then 127. find uses this as a set.
(define safe-cell-controls
  "\u0000\u0001\u0002\u0003\u0004\u0005\u0006\u0007\u0008\u0009\u000a\u000b\u000c\u000d\u000e\u000f\u0010\u0011\u0012\u0013\u0014\u0015\u0016\u0017\u0018\u0019\u001a\u001b\u001c\u001d\u001e\u001f\u007f")

(define-class AloemacsEditor
  (fields
    (text Text)
    (point Position)
    (quit Bool)
    (scroll-row Int)
    (scroll-col Int)
    (history (List UndoFrame))
    (mark (Option Position))
    (text-rows Int))
  (methods
    (with-origin (scroll-row Int) (scroll-col Int) AloemacsEditor
      (AloemacsEditor new
        (self text) (self point) (self quit) scroll-row scroll-col
        (self history) (self mark) (self text-rows)))

    (fit-origin (point Int) (origin Int) (size Int) Int
      ((if (point < origin)
           point
           (if (point >= (origin + size))
               ((point - size) + 1)
               origin)) max 0))

    (ensure-visible (columns Int) (rows Int) AloemacsEditor
      (let ((point (self point)))
        (AloemacsEditor new
          (self text)
          point
          (self quit)
          (self fit-origin (point line) (self scroll-row) rows)
          (self fit-origin (point column) (self scroll-col) columns)
          (self history)
          (self mark)
          rows)))

    (frame-ansi (body String) (cursor-row Int) (cursor-column Int) String
      ((List of
         "\u001b[?25l"
         "\u001b[2J"
         "\u001b[H"
         body
         "\u001b["
         (cursor-row text)
         ";"
         (cursor-column text)
         "H"
         "\u001b[?25h")
       fold
       ""
       (fn (acc s) (acc append s))))

    (safe-cells (clipped-string String) String
      (if ((clipped-string len) = 0)
          ""
          (let ((cell (clipped-string take 1)))
            ((if ((safe-cell-controls find cell 0) present?)
                 " "
                 cell)
             append
             (self safe-cells (clipped-string drop 1))))))

    (blank-rows (rows Int) (List String)
      (if (rows <= 0)
          (List empty)
          ((self blank-rows (rows - 1)) cons "")))

    (frame-rows (columns Int) (rows Int) (scroll-row Int) (scroll-col Int)
                (List String)
      ;; Focus only a temporary zipper at this view's explicit origin.
      (((self text) focus-at scroll-row) case
        (None () (self blank-rows rows))
        (Some (at-top)
          ((at-top next-lines rows) map
            (fn (line)
              (self safe-cells ((line drop scroll-col) take columns)))))))

    (frame (columns Int) (rows Int) String
      (let ((point (self point)))
        (let ((top (self scroll-row))
              (left (self scroll-col)))
          (let ((cursor-row (((point line) - top) + 1))
                (cursor-column (((point column) - left) + 1)))
            (((self text) focus-at (point line)) case
              (None ()
                (self frame-ansi "" cursor-row cursor-column))
              (Some (focused)
                ((focused focus-at top) case
                  (None ()
                    (self frame-ansi "" cursor-row cursor-column))
                  (Some (at-top)
                    (self frame-ansi
                      (if (rows < 1)
                          ""
                          (let ((clipped
                                 ((at-top next-lines rows) map
                                   (fn (line)
                                     (self safe-cells
                                       ((line drop left) take columns))))))
                            ((clipped rest) fold
                              (clipped first)
                              (fn (body line)
                                ((body append "\r\n") append line)))))
                      cursor-row
                      cursor-column)))))))))

    (unchanged () AloemacsEditor
      self)

    (with-mark (mark (Option Position)) AloemacsEditor
      (AloemacsEditor new
        (self text)
        (self point)
        (self quit)
        (self scroll-row)
        (self scroll-col)
        (self history)
        mark
        (self text-rows)))

    (clear-mark () AloemacsEditor
      (AloemacsEditor new
        (self text)
        (self point)
        (self quit)
        (self scroll-row)
        (self scroll-col)
        (self history)
        (Option None)
        (self text-rows)))

    (keep-valid-mark () AloemacsEditor
      ((self mark) case
        (None () self)
        (Some (mark)
          (if ((self text) valid-position? mark)
              self
              (self clear-mark)))))

    (with-text-and-point (text Text) (point Position) AloemacsEditor
      (AloemacsEditor new
        text
        point
        (self quit)
        (self scroll-row)
        (self scroll-col)
        (self history)
        (self mark)
        (self text-rows)))

    (from-edit (result EditResult) AloemacsEditor
      (AloemacsEditor new
        (result text)
        (result position)
        (self quit)
        (self scroll-row)
        (self scroll-col)
        ((self history) cons
          (UndoFrame new
            (self text)
            (self point)
            (self scroll-row)
            (self scroll-col)))
        (self mark)
        (self text-rows)))

    (undo () AloemacsEditor
      (if ((self history) empty?)
          (self unchanged)
          (let ((frame ((self history) first)))
            (AloemacsEditor new
              (frame text)
              (frame point)
              (self quit)
              (frame scroll-row)
              (frame scroll-col)
              ((self history) rest)
              (self mark)
              (self text-rows)))))

    (insert (string String) AloemacsEditor
      (((self text) insert (self point) string) case
        (None () (self unchanged))
        (Some (result) (self from-edit result))))

    (newline () AloemacsEditor
      (((self text) newline (self point)) case
        (None () (self unchanged))
        (Some (result) (self from-edit result))))

    (backward-delete () AloemacsEditor
      (let ((point (self point)))
        (if ((point column) > 0)
            (let ((span
                   (Span new
                     (Position new
                       (point line)
                       ((point column) - 1))
                     point)))
              (((self text) delete span) case
                (None () (self unchanged))
                (Some (result) (self from-edit result))))
            (if ((point line) > 0)
                (((self text) focus-at (point line)) case
                  (None () (self unchanged))
                  (Some (focused)
                    (if (focused has-previous?)
                        (let ((previous (focused focus-up)))
                          (let ((span
                                 (Span new
                                   (Position new
                                     ((point line) - 1)
                                     (previous line-length))
                                   point)))
                            ((focused delete span) case
                              (None () (self unchanged))
                              (Some (result) (self from-edit result)))))
                        (self unchanged))))
                (self unchanged)))))

    (move-left () AloemacsEditor
      (let ((point (self point)))
        (if ((point column) = 0)
            (if ((point line) = 0)
                (self unchanged)
                (((self text) focus-at (point line)) case
                  (None () (self unchanged))
                  (Some (focused)
                    (if (focused has-previous?)
                        (let ((previous (focused focus-up)))
                          (self with-text-and-point previous
                            (Position new
                              ((point line) - 1)
                              (previous line-length))))
                        (self unchanged)))))
            (((self text) focus-at (point line)) case
              (None () (self unchanged))
              (Some (focused)
                (self with-text-and-point focused
                  (Position new
                    (point line)
                    ((point column) - 1))))))))

    (move-right () AloemacsEditor
      (let ((point (self point)))
        (((self text) focus-at (point line)) case
          (None () (self unchanged))
          (Some (focused)
            (let ((length (focused line-length)))
              (if ((point column) < length)
                  (self with-text-and-point focused
                    (Position new
                      (point line)
                      ((point column) + 1)))
                  (if (focused has-next?)
                      (self with-text-and-point (focused focus-down)
                        (Position new
                          ((point line) + 1)
                          0))
                      (self unchanged))))))))

    (move-up () AloemacsEditor
      (let ((point (self point)))
        (if ((point line) = 0)
            (self unchanged)
            (((self text) focus-at (point line)) case
              (None () (self unchanged))
              (Some (focused)
                (if (focused has-previous?)
                    (let ((previous (focused focus-up)))
                      (self with-text-and-point previous
                        (Position new
                          ((point line) - 1)
                          ((point column) min (previous line-length)))))
                    (self unchanged)))))))

    (move-down () AloemacsEditor
      (let ((point (self point)))
        (((self text) focus-at (point line)) case
          (None () (self unchanged))
          (Some (focused)
            (if (focused has-next?)
                (let ((next (focused focus-down)))
                  (self with-text-and-point next
                    (Position new
                      ((point line) + 1)
                      ((point column) min (next line-length)))))
                (self unchanged))))))

    (at-focused (focused Text) (column Int) AloemacsEditor
      (let ((destination
             (Position new (focused focus-line)
               (column min (focused line-length)))))
        (if ((self point) = destination)
            (self unchanged)
            (self with-text-and-point focused destination))))

    (line-start () AloemacsEditor
      (((self text) focus-at ((self point) line)) case
        (None () (self unchanged))
        (Some (focused) (self at-focused focused 0))))

    (line-end () AloemacsEditor
      (((self text) focus-at ((self point) line)) case
        (None () (self unchanged))
        (Some (focused) (self at-focused focused (focused line-length)))))

    (focus-up-by (focused Text) (remaining Int) Text
      (if (remaining <= 0)
          focused
          (if (focused has-previous?)
              (self focus-up-by (focused focus-up) (remaining - 1))
              focused)))

    (focus-down-by (focused Text) (remaining Int) Text
      (if (remaining <= 0)
          focused
          (if (focused has-next?)
              (self focus-down-by (focused focus-down) (remaining - 1))
              focused)))

    (focus-end (focused Text) Text
      (if (focused has-next?)
          (self focus-end (focused focus-down))
          focused))

    (page-distance () Int
      (if ((self text-rows) >= 2)
          ((self text-rows) - 1)
          (self text-rows)))

    (page-up () AloemacsEditor
      (if ((self page-distance) <= 0)
          (self unchanged)
          (((self text) focus-at ((self point) line)) case
            (None () (self unchanged))
            (Some (focused)
              (self at-focused
                (self focus-up-by focused (self page-distance))
                ((self point) column))))))

    (page-down () AloemacsEditor
      (if ((self page-distance) <= 0)
          (self unchanged)
          (((self text) focus-at ((self point) line)) case
            (None () (self unchanged))
            (Some (focused)
              (self at-focused
                (self focus-down-by focused (self page-distance))
                ((self point) column))))))

    (buffer-start () AloemacsEditor
      (((self text) focus-at 0) case
        (None () (self unchanged))
        (Some (focused) (self at-focused focused 0))))

    (buffer-end () AloemacsEditor
      (let ((last (self focus-end ((self text) indexed-value))))
        (self at-focused last (last line-length))))

    (request-quit () AloemacsEditor
      (AloemacsEditor new
        (self text)
        (self point)
        #t
        (self scroll-row)
        (self scroll-col)
        (self history)
        (self mark)
        (self text-rows)))

    (handle-key (key String) AloemacsEditor
      (cond
        ((self quit) (self unchanged))
        ((key = "return") (self newline))
        ((key = "backspace") (self backward-delete))
        ((key = "left") (self move-left))
        ((key = "right") (self move-right))
        ((key = "up") (self move-up))
        ((key = "down") (self move-down))
        ((key = "line-start") (self line-start))
        ((key = "line-end") (self line-end))
        ((key = "page-up") (self page-up))
        ((key = "page-down") (self page-down))
        ((key = "buffer-start") (self buffer-start))
        ((key = "buffer-end") (self buffer-end))
        ((key = "escape") (self request-quit))
        ((key = "undo") (self undo))
        (((key len) = 1) (self insert key))
        (else (self unchanged))))))
