(load "point.aloe")

;; Aloe 0.1 — Boids target program

(define-class (Boid T)
  (fields
    (position (Point T))
    (velocity (Point T)))
  (methods
    (in-view? (other (Boid T)) Bool
      (let ((to ((other position) - (self position)))
            (hd (self velocity)))
        (if (0.0 < (hd dot hd))
            (0.0 < (hd dot to))
            #t)))

    (neighbors (flock (List (Boid T))) (r T) (List (Boid T))
      (flock fold (List empty)
        (fn (neighbors other)
          (let ((d2 ((self position) dist2 (other position))))
            (cond ((d2 <= 0.0)           neighbors)
                  ((d2 >= (r * r))       neighbors)
                  ((self in-view? other) (neighbors cons other))
                  (else neighbors))))))

    (cohere (others (List (Boid T))) (Point T)
      (let ((origin (Point new 0.0 0.0)))
        (if (others empty?)
            origin
            (((((others map (fn (other) (other position)))
                fold origin
                (fn (acc p) (acc + p)))
               / ((others len) float))
              - (self position))
             * 0.01))))

    (align (others (List (Boid T))) (Point T)
      (let ((origin (Point new 0.0 0.0)))
        (if (others empty?)
            origin
            (((((others map (fn (other) (other velocity)))
                fold origin
                (fn (acc v) (acc + v)))
               / ((others len) float))
              - (self velocity))
             * 0.05))))

    (separate (flock (List (Boid T))) (Point T)
      (let ((origin (Point new 0.0 0.0)))
        ((flock fold origin
           (fn (acc other)
             (let ((d2 ((self position) dist2 (other position))))
               (acc +
                 (cond ((d2 <= 0.0)  origin)
                       ((d2 >= 25.0) origin)
                       (else ((self position) - (other position))))))))
         * 0.001)))

    (advance (new-vel (Point T)) (Boid T)
      (Boid new
        ((self position) + new-vel)
        new-vel))))

(define-class Sim
  (fields
    (flock (List (Boid Float))))
  (methods
    (step () Sim
      (let ((bs       (self flock))
            (cohere-r 50.0)
            (align-r  50.0))

        (Sim new
          (bs map
            (fn (b)
              (let ((cn    (b neighbors bs cohere-r))
                    (an    (b neighbors bs align-r))
                    (separ (b separate bs)))
                  (let ((new-vel
                         ((((b velocity) + (b cohere cn))
                           + (b align an))
                          + separ)))
                    (b advance new-vel))))))))))

(define demo
  (Sim new
    (List of
      (Boid new (Point new 0.0 0.0) (Point new 1.0 0.0))
      (Boid new (Point new 1.0 1.0) (Point new 0.0 1.0))
      (Boid new (Point new 2.0 0.0) (Point new 1.0 1.0)))))

(demo step)
(demo step)
