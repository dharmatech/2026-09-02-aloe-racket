(load "point.aloe")

;; Aloe 0.1 — Boids target program

(define-class (Boid T)
  (fields
    (position (Point T))
    (velocity (Point T)))
  (methods))

(define-class Sim
  (fields
    (flock (List (Boid Float))))
  (methods
    (step () Sim
      (let ((origin   (Point new 0.0 0.0))
            (bs       (self flock))
            (cohere-r 50.0)
            (align-r  50.0))

        (Sim new
          (bs map
            (fn (b)
              (let ((cohere-neighbors
                     (bs fold (List empty)
                       (fn (neighbors other)
                         (let ((d2 ((b position) dist2 (other position))))
                           (if (0.0 < d2)
                               (if (d2 < (cohere-r * cohere-r))
                                   (if (let ((to ((other position) - (b position)))
                                             (hd (b velocity)))
                                         (if (0.0 < (hd dot hd))
                                             (0.0 < (hd dot to))
                                             #t))
                                       (neighbors cons other)
                                       neighbors)
                                   neighbors)
                               neighbors)))))
                    (align-neighbors
                     (bs fold (List empty)
                       (fn (neighbors other)
                         (let ((d2 ((b position) dist2 (other position))))
                           (if (0.0 < d2)
                               (if (d2 < (align-r * align-r))
                                   (if (let ((to ((other position) - (b position)))
                                             (hd (b velocity)))
                                         (if (0.0 < (hd dot hd))
                                             (0.0 < (hd dot to))
                                             #t))
                                       (neighbors cons other)
                                       neighbors)
                                   neighbors)
                               neighbors)))))
                    (separ
                     ((bs fold origin
                        (fn (acc other)
                          (acc +
                            (if (0.0 < ((b position) dist2 (other position)))
                                (if (((b position) dist2 (other position)) < 25.0)
                                    ((b position) - (other position))
                                    origin)
                                origin))))
                      * 0.001)))

                (let ((cohere
                       (if (cohere-neighbors empty?)
                           origin
                           (((((cohere-neighbors map
                                (fn (other) (other position)))
                               fold origin
                               (fn (acc p) (acc + p)))
                              / ((cohere-neighbors len) float))
                             - (b position))
                            * 0.01)))
                      (align
                       (if (align-neighbors empty?)
                           origin
                           (((((align-neighbors map
                                (fn (other) (other velocity)))
                               fold origin
                               (fn (acc v) (acc + v)))
                              / ((align-neighbors len) float))
                             - (b velocity))
                            * 0.05))))
                  (let ((new-vel
                         ((((b velocity) + cohere) + align) + separ)))
                    (Boid new
                      ((b position) + new-vel)
                      new-vel)))))))))))

(define demo
  (Sim new
    (List of
      (Boid new (Point new 0.0 0.0) (Point new 1.0 0.0))
      (Boid new (Point new 1.0 1.0) (Point new 0.0 1.0))
      (Boid new (Point new 2.0 0.0) (Point new 1.0 1.0)))))

(demo step)
(demo step)
