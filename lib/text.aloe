(load "option.aloe")

(define-class Position
  (fields
    (line Int)
    (column Int))
  (methods
    (= (other Position) Bool
      (if ((self line) = (other line))
          ((self column) = (other column))
          #f))

    (before? (other Position) Bool
      (if ((self line) < (other line))
          #t
          (if ((self line) = (other line))
              ((self column) < (other column))
              #f)))

    (before-or-equal? (other Position) Bool
      (if (self before? other)
          #t
          (self = other)))

    (after (string String) Position
      (let ((pieces (string split-lines)))
        (let ((line-count ((pieces len) - 1))
              (final-piece ((pieces reverse) first)))
          (if (line-count = 0)
              (Position new
                (self line)
                ((self column) + (string len)))
              (Position new
                ((self line) + line-count)
                (final-piece len))))))))

(define-class Span
  (fields
    (start Position)
    (end Position))
  (methods
    (empty? () Bool
      ((self start) = (self end)))))

(define-class Text
  (constructors
    (from-string (fields (source String)))
    (indexed (fields
      (above (List String))
      (current String)
      (below (List String))
      (focus Int))))
  (methods
    (to-string () String
      (self case
        (from-string (stored-source) stored-source)
        (indexed (above current below focus)
          ("\n" joined-with above current below))))

    (lines () (List String)
      (self case
        (from-string (source) (source split-lines))
        (indexed (above current below focus)
          (above fold
            (below cons current)
            (fn (lines line) (lines cons line))))))

    (indexed-value () Text
      (self case
        (from-string (source)
          (let ((pieces (source split-lines)))
            (Text indexed
              (List empty)
              (pieces first)
              (pieces rest)
              0)))
        (indexed (above current below focus) self)))

    (focus-at (line Int) (Option Text)
      (if (line < 0)
          (Option None)
          (self case
            (from-string (source)
              ((self indexed-value) focus-at line))
            (indexed (above current below focus)
              (if (line = focus)
                  (Option Some self)
                  (if (line < focus)
                      (if (above empty?)
                          (Option None)
                          ((self focus-up) focus-at line))
                      (if (below empty?)
                          (Option None)
                          ((self focus-down) focus-at line))))))))

    (focus-line () Int
      ((self indexed-value) case
        (from-string (source) 0)
        (indexed (above current below focus) focus)))

    (current-line () String
      ((self indexed-value) case
        (from-string (source) source)
        (indexed (above current below focus) current)))

    (next-lines (n Int) (List String)
      (if (n <= 0)
          (List empty)
          (let ((at-line (self indexed-value)))
            (let ((next (if (at-line has-next?)
                            (at-line focus-down)
                            (Text indexed (List empty) "" (List empty) 0))))
              ((next next-lines (n - 1)) cons (at-line current-line))))))

    (line-length () Int
      ((self current-line) len))

    (has-previous? () Bool
      ((self indexed-value) case
        (from-string (source) #f)
        (indexed (above current below focus)
          (if (above empty?) #f #t))))

    (has-next? () Bool
      ((self indexed-value) case
        (from-string (source) #f)
        (indexed (above current below focus)
          (if (below empty?) #f #t))))

    (focus-up () Text
      (self case
        (from-string (source) ((self indexed-value) focus-up))
        (indexed (above current below focus)
          (if (above empty?)
              self
              (Text indexed
                (above rest)
                (above first)
                (below cons current)
                (focus - 1))))))

    (focus-down () Text
      (self case
        (from-string (source) ((self indexed-value) focus-down))
        (indexed (above current below focus)
          (if (below empty?)
              self
              (Text indexed
                (above cons current)
                (below first)
                (below rest)
                (focus + 1))))))

    (valid-position? (position Position) Bool
      (if ((position line) < 0)
          #f
          (if ((position column) < 0)
              #f
              ((self focus-at (position line)) case
                (None () #f)
                (Some (selected)
                  ((position column) <= ((selected current-line) len)))))))

    (valid-span? (span Span) Bool
      (if (self valid-position? (span start))
          (if (self valid-position? (span end))
              ((span start) before-or-equal? (span end))
              #f)
          #f))))

(define-class EditResult
  (fields
    (text Text)
    (position Position))
  (methods))

(define-methods Text
  (methods
    (excerpt (span Span) (Option String)
      (let ((indexed (self indexed-value)))
        (if (indexed valid-span? span)
            (let ((start (span start))
                  (end (span end)))
              ((indexed focus-at (start line)) case
                (None () (Option None))
                (Some (at-start)
                  (if ((start line) = (end line))
                      (Option Some
                        (((at-start current-line) drop (start column))
                          take ((end column) - (start column))))
                      ((at-start focus-at (end line)) case
                        (None () (Option None))
                        (Some (at-end)
                          (let ((beginning
                                  ((at-start current-line) drop (start column)))
                                (interior
                                  ((at-start focus-down) next-lines
                                    (((end line) - (start line)) - 1))))
                            (Option Some
                              ((interior fold
                                 (beginning append "\n")
                                 (fn (result line)
                                   ((result append line) append "\n")))
                                append
                                ((at-end current-line) take (end column)))))))))))
            (Option None))))

    (replace-pieces
      (pieces (List String))
      (prefix String)
      (suffix String)
      (above (List String))
      (below (List String))
      (focus Int)
      Text
      (if ((pieces rest) empty?)
          (Text indexed
            above
            ((prefix append (pieces first)) append suffix)
            below
            focus)
          (self replace-pieces
            (pieces rest)
            ""
            suffix
            (above cons (prefix append (pieces first)))
            below
            (focus + 1))))

    (replace (span Span) (string String) (Option EditResult)
      (if (self valid-span? span)
          (let ((start (span start))
                (end (span end)))
            ((self focus-at (start line)) case
              (None () (Option None))
              (Some (at-start)
                (at-start case
                  (from-string (source) (Option None))
                  (indexed (above current below focus)
                    ((at-start focus-at (end line)) case
                      (None () (Option None))
                      (Some (at-end)
                        (at-end case
                          (from-string (source) (Option None))
                          (indexed (end-above end-current end-below end-focus)
                            (Option Some
                              (EditResult new
                                (self replace-pieces
                                  (string split-lines)
                                  (current take (start column))
                                  (end-current drop (end column))
                                  above
                                  end-below
                                  (start line))
                                (start after string))))))))))))
          (Option None)))

    (insert (position Position) (string String) (Option EditResult)
      (self replace (Span new position position) string))

    (delete (span Span) (Option EditResult)
      (self replace span ""))

    (newline (position Position) (Option EditResult)
      (self insert position "\n"))))
