(load "option.aloe")

(define-class Position
  (fields
    (line Int)
    (column Int))
  (methods
    (= (other Position) Bool
      (if ((self line) = (other line))
          ((self column) = (other column))
          #f))

    (before? (other Position) Bool
      (if ((self line) < (other line))
          #t
          (if ((self line) = (other line))
              ((self column) < (other column))
              #f)))

    (before-or-equal? (other Position) Bool
      (if (self before? other)
          #t
          (self = other)))

    (after (string String) Position
      (let ((pieces (string split-lines)))
        (let ((line-count ((pieces len) - 1))
              (final-piece ((pieces reverse) first)))
          (if (line-count = 0)
              (Position new
                (self line)
                ((self column) + (string len)))
              (Position new
                ((self line) + line-count)
                (final-piece len))))))))

(define-class Span
  (fields
    (start Position)
    (end Position))
  (methods
    (empty? () Bool
      ((self start) = (self end)))))

(define-class Text
  (constructors
    (from-string (fields (source String))))
  (methods
    (to-string () String
      (self case
        (from-string (stored-source) stored-source)))

    (lines () (List String)
      ((self to-string) split-lines))

    (valid-position? (position Position) Bool
      (if ((position line) < 0)
          #f
          (if ((position column) < 0)
              #f
              (let ((lines (self lines)))
                (if ((position line) >= (lines len))
                    #f
                    (let ((selected
                           (lines fold
                             (Position new 0 0)
                             (fn (cursor current-line)
                               (if ((cursor line) = (position line))
                                   (Position new
                                     ((cursor line) + 1)
                                     (current-line len))
                                   (Position new
                                     ((cursor line) + 1)
                                     (cursor column)))))))
                      ((position column) <= (selected column))))))))

    (valid-span? (span Span) Bool
      (if (self valid-position? (span start))
          (if (self valid-position? (span end))
              ((span start) before-or-equal? (span end))
              #f)
          #f))))
