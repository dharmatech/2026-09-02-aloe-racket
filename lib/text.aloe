(load "option.aloe")

(define-class Position
  (fields
    (line Int)
    (column Int))
  (methods
    (= (other Position) Bool
      (if ((self line) = (other line))
          ((self column) = (other column))
          #f))

    (before? (other Position) Bool
      (if ((self line) < (other line))
          #t
          (if ((self line) = (other line))
              ((self column) < (other column))
              #f)))

    (before-or-equal? (other Position) Bool
      (if (self before? other)
          #t
          (self = other)))

    (after (string String) Position
      (let ((pieces (string split-lines)))
        (let ((line-count ((pieces len) - 1))
              (final-piece ((pieces reverse) first)))
          (if (line-count = 0)
              (Position new
                (self line)
                ((self column) + (string len)))
              (Position new
                ((self line) + line-count)
                (final-piece len))))))))

(define-class Span
  (fields
    (start Position)
    (end Position))
  (methods
    (empty? () Bool
      ((self start) = (self end)))))

(define-class Text
  (constructors
    (from-string (fields (source String))))
  (methods
    (to-string () String
      (self case
        (from-string (stored-source) stored-source)))

    (lines () (List String)
      ((self to-string) split-lines))

    (valid-position? (position Position) Bool
      (if ((position line) < 0)
          #f
          (if ((position column) < 0)
              #f
              (let ((lines (self lines)))
                (if ((position line) >= (lines len))
                    #f
                    (let ((selected
                           (lines fold
                             (Position new 0 0)
                             (fn (cursor current-line)
                               (if ((cursor line) = (position line))
                                   (Position new
                                     ((cursor line) + 1)
                                     (current-line len))
                                   (Position new
                                     ((cursor line) + 1)
                                     (cursor column)))))))
                      ((position column) <= (selected column))))))))

    (valid-span? (span Span) Bool
      (if (self valid-position? (span start))
          (if (self valid-position? (span end))
              ((span start) before-or-equal? (span end))
              #f)
          #f))))

(define-class EditResult
  (fields
    (text Text)
    (position Position))
  (methods))

(define-methods Text
  (methods
    (replace (span Span) (string String) (Option EditResult)
      (if (self valid-span? span)
          (let ((old (self to-string))
                (lines (self lines))
                (start (span start))
                (end (span end)))
            (let ((start-prefix
                   (lines fold
                     (Position new 0 0)
                     (fn (cursor current-line)
                       (if ((cursor line) < (start line))
                           (Position new
                             ((cursor line) + 1)
                             (((cursor column) + (current-line len)) + 1))
                           (Position new
                             ((cursor line) + 1)
                             (cursor column))))))
                  (end-prefix
                   (lines fold
                     (Position new 0 0)
                     (fn (cursor current-line)
                       (if ((cursor line) < (end line))
                           (Position new
                             ((cursor line) + 1)
                             (((cursor column) + (current-line len)) + 1))
                           (Position new
                             ((cursor line) + 1)
                             (cursor column)))))))
              (let ((a ((start-prefix column) + (start column)))
                    (b ((end-prefix column) + (end column))))
                (let ((new-source
                       (((old take a) append string) append (old drop b))))
                  (Option Some
                    (EditResult new
                      (Text from-string new-source)
                      (start after string)))))))
          (Option None)))

    (insert (position Position) (string String) (Option EditResult)
      (self replace (Span new position position) string))

    (delete (span Span) (Option EditResult)
      (self replace span ""))

    (newline (position Position) (Option EditResult)
      (self insert position "\n"))))
