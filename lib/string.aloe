(define-methods String
  (methods
    (starts-with? (prefix String) Bool
      ((self take (prefix len)) = prefix))

    (split-lines () (List String)
      (if ((self len) = 0)
          (List of "")
          (let ((first-character (self take 1))
                (remaining-lines ((self drop 1) split-lines)))
            (if (first-character = "\n")
                (remaining-lines cons "")
                ((remaining-lines rest) cons
                  (first-character append (remaining-lines first)))))))))
