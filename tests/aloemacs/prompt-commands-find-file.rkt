          (runner-frame "" 1 (string-append "Find file: " text) (if (= rows 1) #f 2) 2 rows))
        (list (runner-frame "ab" 1 "/cwd/a.txt" #f 2 rows #:name "/cwd/a.txt")
              (runner-frame "ab" 2 "/cwd/a.txt" #f 2 rows #:name "/cwd/a.txt")
