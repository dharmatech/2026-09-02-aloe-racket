;; Real runner, descriptor-compatible Term with exact fixed host call shapes.
;; Record the complete event sequence and the Fs state at every key boundary.
(define (scripted-run keys columns rows expected #:contents [contents "x"])
  (define-values (fs calls disk) (counted-fs #:contents contents))
  (define events (box '()))
  (define remaining keys)
  (define missing-at-key (box '()))
  (define (record x) (set-box! events (cons x (unbox events))))
  (define term
    (make-host-receiver
      (make-host-interface 'Term
        (list
          (make-host-method 'read-key '() 'String (lambda (state)
            (when (null? remaining) (error 'scripted-run "exhausted"))
            (define key (car remaining))
            (set! remaining (cdr remaining))
            (record (list 'key key))
            (set-box! missing-at-key (cons (host-receiver-send disk 'kind '("/cwd/new")) (unbox missing-at-key)))
            key))
          (make-host-method 'write-line '(String) 'String (lambda (state s) (error 'scripted-run "unexpected write-line")))
          (make-host-method 'write '(String) 'String (lambda (state s) (record (list 'write s)) s))
          (make-host-method 'columns '() 'Int (lambda (state) (record 'columns) columns))
          (make-host-method 'rows '() 'Int (lambda (state) (record 'rows) rows)))) #f))
  (run-aloemacs-with-hosts term fs)
  (check-equal? remaining '())
  (check-equal? (reverse (unbox events))
    (append-map (lambda (key painted) (list 'columns 'rows (list 'write painted) (list 'key key))) keys expected))
  (values calls disk (reverse (unbox missing-at-key))))
(define (runner-frame text column label [prompt-column #f] [columns 20] [rows 3]
                      #:name [name "untitled"])
  (define shown
    (if (and (>= rows 3) (not prompt-column) (equal? label name)) ""
        (substring label 0 (min columns (string-length label)))))
  (if (= rows 1)
      (editor-frame text 1 column)
      (frame (string-append text "\r\n") 1 column rows shown
        (if prompt-column rows 1) (or prompt-column column) #:name name #:width columns)))

(test-case "scripted runner prefix, redraw, typing, completion, edit/save, cancel and quit"
  (define keys '("ctrl-x" "unknown" "ctrl-x" "find" "n" "e" "w" "left" "right" "return"
                "x" "save" "ctrl-x" "save" "ctrl-x" "find" "z" "escape" "escape"))
  (define frames
    (append
      (make-list 4 (runner-frame "" 1 "untitled"))
      (for/list ([text '("/cwd/" "/cwd/n" "/cwd/ne" "/cwd/new" "/cwd/new" "/cwd/new")]
                 [col '(17 18 19 20 19 20)])
        (runner-frame "" 1 (string-append "Find file: " text) col))
      (list (runner-frame "" 1 "/cwd/new" #:name "/cwd/new") (runner-frame "x" 2 "/cwd/new" #:name "/cwd/new")
            (runner-frame "x" 2 "saved: /cwd/new" #:name "/cwd/new") (runner-frame "x" 2 "/cwd/new" #:name "/cwd/new")
            (runner-frame "x" 2 "saved: /cwd/new" #:name "/cwd/new") (runner-frame "x" 2 "/cwd/new" #:name "/cwd/new")
            (runner-frame "x" 2 "Find file: /cwd/" 17 #:name "/cwd/new") (runner-frame "x" 2 "Find file: /cwd/z" 18 #:name "/cwd/new")
            (runner-frame "x" 2 "/cwd/new" #:name "/cwd/new"))))
  (define-values (calls disk missing) (scripted-run keys 20 3 frames))
  (check-equal? (all-calls calls)
    '((current) (resolve "/cwd/new") (kind "/cwd/new") (resolve "/cwd/new")
      (kind "/cwd/new") (resolve "/cwd/new") (root? "/cwd/new")
      (parent "/cwd/new") (kind "/cwd") (resolve "/cwd") (write "/cwd/new" "x")
      (kind "/cwd/new") (resolve "/cwd/new") (write "/cwd/new" "x")
      (root? "/cwd/new") (parent "/cwd/new")))
  (check-equal? (effects calls 'read) '())
  (check-equal? (effects calls 'write) '((write "/cwd/new" "x") (write "/cwd/new" "x")))
  (check-equal? (take missing 12) (make-list 12 "missing"))
  (check-equal? (drop missing 12) (make-list 7 "file"))
  (check-equal? (host-receiver-send disk 'read '("/cwd/new")) "x"))

(test-case "runner opens regular contents and fits before frames, including one-row operation"
  (for ([rows '(3 1)])
    (define keys '("ctrl-x" "find" "a" "." "t" "x" "t" "return" "right" "right" "right" "escape"))
    (define frames
