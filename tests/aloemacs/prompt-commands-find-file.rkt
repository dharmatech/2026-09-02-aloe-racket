(test-case "remaining prefix misses, plain search/region/insertion/save, and quit keep their meanings"
  (define-values (st calls) (state))
  (rich! st)
  (def! st 'armed '(source handle-key "ctrl-x"))
  (same st '(armed handle-key "kill")
    (rebuild 'source #:echo "" #:prompt (prompt "/cwd/b.txt" 10 "Save as: ")
      #:waiting '(Option Some (AloemacsCommand SaveAs))))
  (same st '(armed handle-key "b")
    (rebuild 'source #:echo "" #:prompt (prompt "" 0 "Buffer: ")
      #:waiting '(Option Some (AloemacsCommand SelectBuffer))))
  (for ([key '("escape" "x" "s" "left" "undo" "return" "mark" "unknown" "" "ctrl-x" "kill-line" "yank")])
    (same st `(armed handle-key ,key) (rebuild 'source #:echo "")))
  (same st '(source handle-key "b")
    (rebuild 'source #:echo "" #:buffers (replace-current 'source '(rich-editor insert "b"))))
  (same st '(source handle-key "find")
    (rebuild 'source #:searching #t #:query "" #:origin '(source point) #:wrapped #f #:failing #f))
  ;; Mark (1,1) to point (2,4) removes econd\nthir, independently of dispatch.
  (def! st 'killed '(source handle-key "kill"))
  (check-equal? (ev st '((killed text) to-string)) "first\nsd-long\nfourth\nfifth")
  (check-equal? (ev st '((killed kill-ring) first)) "econd\nthir")
  (check-equal? (unbox calls) '())
  (def! st 'saved '(source handle-key "save"))
  (same st 'saved (rebuild 'source #:echo "saved"))
  (set-box! calls '())
  (same st '(armed handle-key "save") (rebuild 'source #:echo "saved"))
  (check-equal? (effects calls 'write) '((write "/cwd/b.txt" "first\nsecond\nthird-long\nfourth\nfifth")))
  (set-box! calls '())
  (def! st 'quit '(source request-quit))
  (for ([key '("ctrl-x" "find" "return" "save" "kill" "b" "escape")])
    (same st `(quit handle-key ,key) 'quit))
  (check-equal? (unbox calls) '()))
