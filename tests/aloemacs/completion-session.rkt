(define (safe s)
  (list->string (for/list ([c (in-string s)])
    (if (or (< (char->integer c) 32) (= (char->integer c) 127)) #\space c))))
(define (clip s w) (substring s 0 (min w (string-length s))))
(test-case "notes keep single-row safe painting and prepared lists shorten fit and frames"
  (define-values (st calls names) (state))
  (active! st "/cwd/z" 2)
  (def! st 'noted '(s complete-prompt))
  (set-box! calls '())
  (for* ([width '(1 12 40)] [height '(1 2 3 7)])
    (def! st 'fitted `(noted ensure-visible ,width ,height))
    (def! st 'plain `(fitted with-active-prompt ,(p "/cwd/z" 2)))
    (same st '(fitted buffers) '(plain buffers))
    (same st '(fitted windows) '(plain windows))
    (check-equal? (ev st '((fitted editor) text-rows))
      (if (>= height 3) (- height 2) 1))
    (define body (if (>= height 3) (string-append (clip "body" width)
      (apply string-append (make-list (- height 3) "\r\n"))) (clip "body" width)))
    (define expected (frame body 1 1 height (safe (clip "Find file: /cwd/z [No match]" width))
      (if (= height 1) 1 height) (if (= height 1) 1 (min width 14))
      #:name "untitled" #:width width))
    (check-equal? (ev st `(fitted frame ,width ,height)) expected)
    (same st '(fitted prompt) '(noted prompt)))
  (def! st 'raw `(s with-active-prompt ,(p "T\n\r\t\e[31m\u0001\u007fZ" 99 " [No match]")))
  (check-equal? (ev st '(raw frame 30 2))
    (frame "body" 1 1 2 "Find file: T    [31m  Z [No ma" 2 30 #:width 30))
  ;; Independent list-aware expectations for this point-zero/body fixture.
  ;; Leave the no-list frame builder and the note goldens above unchanged.
  (define (listed-fit-gold source width height leaf-height)
    (define ed
      `(AloemacsEditor new ((,source editor) text) ((,source editor) point)
         ((,source editor) quit) 0 0 ((,source editor) history) ((,source editor) mark)
         ,(if (>= leaf-height 2) (sub1 leaf-height) leaf-height)))
    (rebuild source #:buffers (replace-current source ed)
      #:windows `(AloemacsWindows new ((,source windows) tree)
                    ((,source windows) selected) ,width ,height)))
  (define (listed-gold width height lines shown prompt-column split?)
    (define k (if (< height 2) 0 (min (length lines) (- height 2))))
    (define root (if (< height 2) height (- height 1 k)))
    (define text-height (if (>= root 2) (sub1 root) root))
    (define suffix
      (apply string-append
        (for/list ([line (in-list (take lines k))] [j (in-naturals 1)])
          (format "\e[~a;1H~a" (+ root j) (safe (clip line width))))))
    (define body (string-append (clip "body" (if split? 4 width))
                  (apply string-append (make-list (sub1 text-height) "\r\n"))))
    (define prefix
      (if split?
          (string-append "\e[?25l\e[2J\e[H"
            (string-join
              (append (list "body|body") (make-list (sub1 text-height) "    |    ")
                      (if (>= root 2) (list "unti|unti") '())) "\r\n"))
          (string-append (editor-frame body 1 1)
            (if (< height 2) ""
                (string-append "\e[?25l"
                  (if (>= root 2) (format "\e[~a;1H~a" root (mode-row "untitled" width)) ""))))))
    (string-append prefix suffix
      (if (< height 2)
          (if split? "\e[1;1H\e[?25h" "")
          (format "\e[~a;1H~a\e[~a;~aH\e[?25h" height (safe (clip shown width))
                  height (min width prompt-column)))))
  (for* ([width '(1 9 40)] [height '(1 2 3 7)])
    (def! st 'listed `(s with-active-prompt ,(p "/cwd/z" 2 "" '("raw\n\t" "dir/" "...(+2)"))))
    (def! st 'listed-fit `(listed ensure-visible ,width ,height))
    (define root (if (< height 2) height (- height 1 (min 3 (- height 2)))))
    (same st 'listed-fit (listed-fit-gold 'listed width height root))
    (check-equal? (ev st `(listed frame ,width ,height))
      (listed-gold width height '("raw\n\t" "dir/" "...(+2)") "Find file: /cwd/z" 14 #f)))
  ;; Split root: prepared lines shorten both leaves, retaining short text-only leaves.
  (def! st 'split (rebuild 's #:windows
    '(AloemacsWindows new
       (AloemacsWindowTree Right
         (AloemacsWindowTree Leaf (AloemacsView new 0 0 0 0 #f))
         (AloemacsWindowTree Leaf (AloemacsView new 1 0 0 0 #t))) 0 9 4)))
  (def! st 'split `(split with-active-prompt ,(p "x" 0 " [No match]")))
  (check-equal? (ev st '(split frame 9 4))
    "\e[?25l\e[2J\e[Hbody|body\r\n    |    \r\nunti|unti\e[4;1HFind file\e[4;9H\e[?25h")
  (def! st 'listed `(split with-active-prompt ,(p "x" 0 " [No match]" '("a" "b"))))
  (for* ([width '(1 9)] [height '(1 2 4 8)])
    (def! st 'listed-fit `(listed ensure-visible ,width ,height))
    (define root (if (< height 2) height (- height 1 (min 2 (- height 2)))))
    (same st 'listed-fit (listed-fit-gold 'listed width height root))
    (check-equal? (ev st `(listed frame ,width ,height))
      (listed-gold width height '("a" "b") "Find file: x [No match]" 11 (= width 9))))
  (check-equal? (unbox calls) '()))

