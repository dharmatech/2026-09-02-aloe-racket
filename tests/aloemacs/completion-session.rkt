  (define frames (box '()))
  (define events (box '()))
  (define snapshots (box '()))
  (define keys (box '("a" "return" "b" "return" "c" "up" "ctrl-x" "find" "a" "tab" "tab"
                     "h" "tab" "tab" "left" "right" "return" "ctrl-x" "find" "tab" "escape" "escape")))
  (define (record item) (set-box! events (append (unbox events) (list item))))
  (define term (make-host-receiver
    (make-host-interface 'Term
      (list (make-host-method 'columns '() 'Int (lambda (_) (record 'columns) 30))
            (make-host-method 'rows '() 'Int (lambda (_) (record 'rows) 3))
            (make-host-method 'write '(String) 'String (lambda (_ text)
              (record 'write) (set-box! frames (append (unbox frames) (list text))) text))
            (make-host-method 'read-key '() 'String (lambda (_)
              (record 'read-key)
              (set-box! snapshots (append (unbox snapshots) (list (reverse (unbox calls)))))
              (define key (car (unbox keys))) (set-box! keys (cdr (unbox keys))) key)))) #f))
  (run-aloemacs-with-hosts term host)
  (define (gold body row col shown prompt-col [name "untitled"])
    (frame body row col 3 shown (if prompt-col 3 row) (or prompt-col col)
      #:name name #:width 30))
  ;; Distinct a/b/c rows prove fitting before paint at one text row.
  (define blank (gold "" 1 1 "" #f))
  (define body (gold "b" 1 2 "" #f))
  (define started (gold "b" 1 2 "Find file: /cwd/" 17))
  (define typed (gold "b" 1 2 "Find file: /cwd/a" 18))
  (define grown (gold "b" 1 2 "Find file: /cwd/alp" 20))
  (define narrowed (gold "b" 1 2 "Find file: /cwd/alph" 21))
  (define unique (gold "b" 1 2 "Find file: /cwd/alpha.txt" 26))
  (define sole (gold "b" 1 2 (clip "Find file: /cwd/alpha.txt [Sole completion]" 30) 26))
  (define sole-left (gold "b" 1 2 (clip "Find file: /cwd/alpha.txt [Sole completion]" 30) 25))
  (define opened (gold "disk contents" 1 1 "" #f "/cwd/alpha.txt"))
  (define restarted (gold "disk contents" 1 1 "Find file: /cwd/" 17 "/cwd/alpha.txt"))
  (define listed-grown
    "\e[?25l\e[2J\e[Hb\e[1;2H\e[?25h\e[?25l\e[2;1Halpha.txt\e[3;1HFind file: /cwd/alp\e[3;20H\e[?25h")
  (define listed-restarted
    "\e[?25l\e[2J\e[Hdisk contents\e[1;1H\e[?25h\e[?25l\e[2;1Halpha.txt\e[3;1HFind file: /cwd/\e[3;17H\e[?25h")
  (check-equal? (unbox frames)
    (list blank (gold "a" 1 2 "" #f) blank (gold "b" 1 2 "" #f)
          blank (gold "c" 1 2 "" #f) body body started typed grown listed-grown
          narrowed unique sole sole-left sole opened opened restarted listed-restarted opened))
  (check-equal? (unbox events) (apply append (make-list 22 '(columns rows write read-key))))
  (check-equal? (effects calls 'current) '((current)))
  (check-equal? (effects calls 'parent) '((parent "/cwd/alpha.txt")))
  (check-equal? (effects calls 'names) (make-list 5 '(names "/cwd")))
  (check-equal? (effects calls 'read) '((read "/cwd/alpha.txt")))
  (check-equal? (effects calls 'write) '())
  ;; Only starts, Tabs and Return introduce calls between key snapshots.
  (for ([index '(1 2 3 4 5 6 7 9 12 15 16 18 21)])
    (check-equal? (list-ref (unbox snapshots) index) (list-ref (unbox snapshots) (sub1 index))))
  (check-equal? (unbox keys) '()))
