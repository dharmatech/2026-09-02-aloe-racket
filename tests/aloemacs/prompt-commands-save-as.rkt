  (set-box! calls '())
  (same st '(edited handle-key "save") (rebuild 'edited #:echo "saved"))
  (same st '((edited handle-key "ctrl-x") handle-key "save") (rebuild 'edited #:echo "saved"))
  (define edited-text "first\nsecond\nthir!d-long\nfourth\nfifth")
