(test-case "absent/non-prompt/missing-answer protocol, direct save/visit and selections stay intact"
  (define-values (st calls disk) (state))
  (rich! st)
  (draft! st "a.txt")
  (def! st 'direct (rebuild 'draft #:waiting no-command))
  (same st '(direct submit-prompt) (rebuild 'direct #:prompt no-prompt #:submission '(Option Some "a.txt")))
  (same st '(source start-prompt "Direct: ") (rebuild 'source #:prompt (prompt "" 0 "Direct: ")))
  (for ([command '(Save Kill RequestQuit SwitchBuffer KillBuffer Undo)])
    (def! st 'raw (rebuild 'draft #:waiting `(Option Some (AloemacsCommand ,command))))
    (same st '(raw submit-prompt)
      (rebuild 'raw #:prompt no-prompt #:submission '(Option Some "a.txt") #:waiting no-command)))
  (def! st 'no-answer (rebuild 'draft #:prompt no-prompt #:submission no-submission))
  (same st '(no-answer run-submitted-command) (rebuild 'no-answer #:waiting no-command))
  (same st '(draft kill-buffer) (selected 'draft (zipper '(a c) 1)))
  (same st '(draft switch-buffer) (selected 'draft (zipper '(a b c) 2)))
  (def! st 'mixed (rebuild 'draft #:searching #t))
  (same st '(mixed handle-key "return")
    (rebuild 'mixed #:searching #f #:query "" #:origin '(Position new 0 0) #:wrapped #f #:failing #f))
  (def! st 'quit '(draft request-quit))
  (same st '(quit handle-key "return") 'quit)
  (check-equal? (unbox calls) '())
  (same st '((draft save) case (None () source) (Some (s) s)) 'draft)
  (check-equal? (effects calls 'write) (list (list 'write "/cwd/b.txt" rich-text)))
  (set-box! calls '())
  (check-false (ev st '((draft visit (Path new "dir")) present?)))
  (same st '(draft waiting-command) waiting)
  (def! st 'visited '((draft visit (Path new "missing")) case (None () source) (Some (s) s)))
  (same st 'visited
    (rebuild 'draft #:buffers (replace-current 'draft (editor "") '(Option Some (Path new "/cwd/missing")))
      #:echo "" #:searching #f #:query "" #:origin '(Position new 0 0) #:wrapped #f #:failing #f
      #:ring '(List empty) #:pending no-pending #:prompt no-prompt #:waiting no-command))
  (check-equal? (effects calls 'write) '()))

(test-case "full active/saved/failed/canceled frames, safe clipping, submission and one row"
  (define-values (st calls disk) (state))
  (def! st 'source (session (zipper (list (buffer "ab\nsecond")) 0)))
  (draft! st "a.txt")
  (check-equal? (ev st '(draft frame 20 3)) (frame "ab\r\nsecond" 1 1 3 "Save as: a.txt" 3 15 #:name "untitled" #:width 20))
  (def! st 'done '(draft submit-prompt))
  (check-equal? (ev st '(done frame 20 3)) (frame "ab\r\nsecond" 1 1 3 "saved: /cwd/a.txt" 1 1 #:name "/cwd/a.txt" #:width 20))
  (def! st 'failed (rebuild 'draft #:prompt (prompt "dir")))
  (def! st 'failed '(failed submit-prompt))
  (check-equal? (ev st '(failed frame 20 3)) (frame "ab\r\nsecond" 1 1 3 "failed: untitled" 1 1 #:name "untitled" #:width 20))
  (def! st 'later '(done execute-command (AloemacsCommand SaveAs) "ignored"))
  (def! st 'cancel '(later handle-key "escape"))
  (check-equal? (ev st '(cancel frame 20 3)) (frame "ab\r\nsecond" 1 1 3 "saved: /cwd/a.txt" 1 1 #:name "/cwd/a.txt" #:width 20))
  (define unsafe "\t\r\u001b\u0000\u007f λabcdef")
  (def! st 'safe (rebuild 'draft #:prompt (prompt unsafe)))
  (set-box! calls '())
  (check-equal? (ev st '(safe frame 12 3)) (frame "ab\r\nsecond" 1 1 3 "Save as:    " 3 12 #:name "untitled" #:width 12))
  (check-equal? (unbox calls) '())
  (def! st 'safe-done '(safe submit-prompt))
  (same st '(safe-done last-submission) `(Option Some ,unsafe))
  (check-equal? (car (all-calls calls)) (list 'resolve unsafe))
  (for ([s '(draft done failed cancel safe)])
    (check-equal? (ev st `(,s frame 20 1)) (ev st `((,s editor) frame 20 1)))))

;; Exact Term call shapes, full frames and event order exercise the unchanged
;; runner's fit-before-frame step; narrow views require fitting to show bc/cd.
(define (scripted-run keys columns rows expected)
  (define-values (fs calls disk) (counted-fs))
  (define events (box '()))
  (define remaining keys)
  (define disk-kinds (box '()))
  (define (record x) (set-box! events (cons x (unbox events))))
  (define term
    (make-host-receiver
      (make-host-interface 'Term
        (list
          (make-host-method 'read-key '() 'String (lambda (state)
            (when (null? remaining) (error 'scripted-run "exhausted"))
            (define key (car remaining))
            (set! remaining (cdr remaining))
            (record (list 'key key))
            (set-box! disk-kinds (cons (host-receiver-send disk 'kind '("/cwd/new")) (unbox disk-kinds)))
            key))
          (make-host-method 'write-line '(String) 'String (lambda (state s) (error 'scripted-run "unexpected write-line")))
          (make-host-method 'write '(String) 'String (lambda (state s) (record (list 'write s)) s))
          (make-host-method 'columns '() 'Int (lambda (state) (record 'columns) columns))
          (make-host-method 'rows '() 'Int (lambda (state) (record 'rows) rows)))) #f))
  (run-aloemacs-with-hosts term fs)
  (check-equal? remaining '())
  (check-equal? (reverse (unbox events))
    (append-map (lambda (key painted) (list 'columns 'rows (list 'write painted) (list 'key key))) keys expected))
  (values calls disk (reverse (unbox disk-kinds))))

(test-case "scripted runner saves as, redraws through typing, edits/saves, cancels and quits at one or three rows"
  (for ([rows '(3 1)])
    (define keys '("x" "ctrl-x" "kill" "n" "e" "w" "left" "right" "return"
                  "y" "save" "ctrl-x" "kill" "z" "escape" "escape"))
    (define (paint text column label [prompt-column #f] #:name [name "untitled"])
      (runner-frame text column label prompt-column 20 rows #:name name))
    (define frames
      (append (list (paint "" 1 "untitled") (paint "x" 2 "untitled") (paint "x" 2 "untitled"))
        (for/list ([text '("/cwd/" "/cwd/n" "/cwd/ne" "/cwd/new" "/cwd/new" "/cwd/new")] [col '(15 16 17 18 17 18)])
          (paint "x" 2 (string-append "Save as: " text) col))
        (list (paint "x" 2 "saved: /cwd/new" #:name "/cwd/new") (paint "xy" 3 "/cwd/new" #:name "/cwd/new")
              (paint "xy" 3 "saved: /cwd/new" #:name "/cwd/new") (paint "xy" 3 "/cwd/new" #:name "/cwd/new")
              (paint "xy" 3 "Save as: /cwd/new" 18 #:name "/cwd/new") (paint "xy" 3 "Save as: /cwd/newz" 19 #:name "/cwd/new")
              (paint "xy" 3 "/cwd/new" #:name "/cwd/new"))))
    (define-values (calls disk kinds) (scripted-run keys 20 rows frames))
    (check-equal? (all-calls calls)
      (append '((current)) (write-calls "/cwd/new" "/cwd/new" "x" #:parent "/cwd")
        '((kind "/cwd/new") (resolve "/cwd/new") (write "/cwd/new" "xy"))))
    (check-equal? (take kinds 9) (make-list 9 "missing"))
    (check-equal? (drop kinds 9) (make-list 7 "file"))
    (check-equal? (host-receiver-send disk 'read '("/cwd/new")) "xy")))

(test-case "scripted narrow runner fits before every frame through save-as without changing contents"
  (for ([rows '(3 1)])
    (define keys '("a" "b" "c" "d" "ctrl-x" "kill" "a" "." "t" "x" "t" "return" "escape"))
    (define (paint text column label [prompt-column #f] #:name [name "untitled"])
      (runner-frame text column label prompt-column 2 rows #:name name))
    (define frames
      (append (list (paint "" 1 "untitled") (paint "a" 2 "untitled") (paint "b" 2 "untitled")
                    (paint "c" 2 "untitled") (paint "d" 2 "untitled") (paint "d" 2 "untitled"))
        (for/list ([text '("/cwd/" "/cwd/a" "/cwd/a." "/cwd/a.t" "/cwd/a.tx" "/cwd/a.txt")])
          (paint "d" 2 (string-append "Save as: " text) 2))
        (list (paint "d" 2 "saved: /cwd/a.txt" #:name "/cwd/a.txt"))))
    (define-values (calls disk kinds) (scripted-run keys 2 rows frames))
