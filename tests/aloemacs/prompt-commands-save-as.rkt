(test-case "empty input, all thin refusals and cancellation preserve exact buffers and prior tokens"
  (for ([input '("" "absent/new" "a.txt/new" "link/new" "pipe/new" "dir" "link" "pipe" "/")])
    (define-values (st calls disk) (state))
    (rich! st)
    (draft! st input)
    (define before (ev st 'draft))
    (def! st 'done '(draft submit-prompt))
    (same st 'done (completed 'draft input #:echo "failed"))
    (check-equal? (effects calls 'write) '())
    (check-equal? (effects calls 'read) '())
    (cond
      [(equal? input "") (check-equal? (unbox calls) '())]
      [(equal? input "/")
       (check-equal? (all-calls calls) '((resolve "/") (kind "/") (resolve "/") (root? "/")))]
      [else
       (define resolved (string-append "/cwd/" input))
       (define parent (cond [(equal? input "absent/new") "/cwd/absent"]
                            [(equal? input "a.txt/new") "/cwd/a.txt"]
                            [(equal? input "link/new") "/cwd/link"]
                            [(equal? input "pipe/new") "/cwd/pipe"] [else #f]))
       (check-equal? (all-calls calls) (write-calls input resolved rich-text #:parent parent #:write? #f))])
    (check-equal? (ev st 'draft) before)
    (set-box! calls '())
    ;; Cancel a later prompt after a failed submission; echo and answer survive.
    (def! st 'later '(done execute-command (AloemacsCommand SaveAs) "ignored"))
    (same st '(later handle-key "escape") (rebuild 'later #:prompt no-prompt #:waiting no-command))
    (check-equal? (unbox calls) '()))
  (define-values (st calls disk) (state))
  (rich! st)
  (for* ([token '("" "saved" "failed")]
         [answer (list no-submission '(Option Some "previous"))])
    (def! st 'source (rebuild 'source #:echo token #:submission answer))
    (def! st 'active '(source execute-command (AloemacsCommand SaveAs) "ignored"))
    (for ([cancel '((active handle-key "escape") (active cancel-prompt))])
      (same st cancel 'source))
    (def! st 'orphan (rebuild 'source #:waiting waiting))
    (same st '(orphan submit-prompt) 'orphan)
    (same st '(orphan cancel-prompt) 'source))
  (check-equal? (unbox calls) '()))

