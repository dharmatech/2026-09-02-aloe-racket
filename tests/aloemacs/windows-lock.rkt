  (same-session st '(quit-s toggle-window-lock) (rebuild 'quit-s #:windows locked))
  (same-session st '(quit-s execute-command (AloemacsCommand ToggleWindowLock) "ignored")
    (rebuild 'quit-s #:windows locked))
