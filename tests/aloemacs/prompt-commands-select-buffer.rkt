    (same st `(quit handle-key ,key) 'quit))
  (check-equal? (unbox calls) '()))

(test-case "idle command-name misses, remaining consumed prefix misses and old plain keys"
  (define-values (st calls disk) (state))
  (rich! st)
  (for ([key '("select-buffer" "switch-buffer" "kill-buffer" "find-file" "save-as")])
    (same st `(source handle-key ,key) (rebuild 'source #:echo "")))
  (def! st 'armed '(source handle-key "ctrl-x"))
  (for ([key '("escape" "x" "s" "left" "undo" "return" "mark" "unknown" ""
              "ctrl-x" "kill-line" "yank" "select-buffer" "switch-buffer")])
    (same st `(armed handle-key ,key) (rebuild 'source #:echo "")))
  (same st '(source handle-key "find")
    (rebuild 'source #:searching #t #:query "" #:origin '(source point) #:wrapped #f #:failing #f))
  (def! st 'killed '(source handle-key "kill"))
  (check-equal? (ev st '((killed text) to-string)) "first\nsd-long\nfourth\nfifth")
  (same st '(killed kill-ring) '(List of "econd\nthir" "newest" "older"))
  (check-equal? (unbox calls) '())
  (for ([send '((source handle-key "save") (armed handle-key "save"))])
    (set-box! calls '())
    (same st send (rebuild 'source #:echo "saved"))
    (check-equal? (all-calls calls)
      '((kind "/cwd/b.txt") (resolve "/cwd/b.txt")
        (write "/cwd/b.txt" "first\nsecond\nthird-long\nfourth\nfifth")))))

;; Production runner, fixed host call shapes, exact full event order. Capture
;; all Fs calls at every key boundary to isolate both selection segments.
(define (scripted-run keys columns rows expected)
  (define-values (fs calls disk) (counted-fs))
  (define events (box '()))
  (define snapshots (box '()))
  (define remaining keys)
  (define (record x) (set-box! events (cons x (unbox events))))
  (define term
    (make-host-receiver
      (make-host-interface 'Term
        (list
          (make-host-method 'read-key '() 'String (lambda (state)
            (when (null? remaining) (error 'scripted-run "exhausted"))
            (define key (car remaining))
            (set! remaining (cdr remaining))
            (record (list 'key key))
            (set-box! snapshots (cons (all-calls calls) (unbox snapshots)))
            key))
          (make-host-method 'write-line '(String) 'String (lambda (state s) (error 'scripted-run "unexpected write-line")))
          (make-host-method 'write '(String) 'String (lambda (state s) (record (list 'write s)) s))
          (make-host-method 'columns '() 'Int (lambda (state) (record 'columns) columns))
          (make-host-method 'rows '() 'Int (lambda (state) (record 'rows) rows)))) #f))
  (run-aloemacs-with-hosts term fs "/cwd/a.txt")
  (check-equal? remaining '())
  (check-equal? (reverse (unbox events))
    (append-map (lambda (key painted) (list 'columns 'rows (list 'write painted) (list 'key key))) keys expected))
  (values calls disk (reverse (unbox snapshots))))

(test-case "runner opens neighbor, selects original, edits/saves there and retains neighbor at one or three rows"
  (for* ([rows '(3 1)] [columns '(20 2)])
    (define keys
      (append '("right" "right" "ctrl-x" "find" "b" "." "t" "x" "t" "return" "ctrl-x" "b")
        (map string (string->list "/cwd/a.txt"))
        '("return" "!" "save" "ctrl-x" "b")
        (map string (string->list "/cwd/b.txt")) '("return" "escape")))
    (define narrow? (= columns 2))
    (define (paint text column label [prompt-column #f])
      (runner-frame text column label
        (and prompt-column (min columns prompt-column)) columns rows))
    (define old-visible (if narrow? "is" "disk a"))
    (define old-column (if narrow? 2 3))
    (define neighbor-visible (if narrow? "di" "disk b"))
    (define edited-visible (if narrow? "!s" "di!sk a"))
    (define edited-column (if narrow? 2 4))
    (define (typing-frames text column label input)
      (for/list ([n (in-range (add1 (string-length input)))])
        (paint text column (string-append label (substring input 0 n))
          (+ (string-length label) n 1))))
    (define frames
      (append
        (list (paint (if narrow? "di" "disk a") 1 "/cwd/a.txt")
              (paint (if narrow? "di" "disk a") 2 "/cwd/a.txt")
              (paint old-visible old-column "/cwd/a.txt")
              (paint old-visible old-column "/cwd/a.txt"))
        (typing-frames old-visible old-column "Find file: " "b.txt")
        (make-list 2 (paint neighbor-visible 1 "/cwd/b.txt"))
        (typing-frames neighbor-visible 1 "Buffer: " "/cwd/a.txt")
        (list (paint old-visible old-column "/cwd/a.txt")
              (paint edited-visible edited-column "/cwd/a.txt")
              (paint edited-visible edited-column "saved: /cwd/a.txt")
              (paint edited-visible edited-column "/cwd/a.txt"))
        (typing-frames edited-visible edited-column "Buffer: " "/cwd/b.txt")
        (list (paint neighbor-visible 1 "/cwd/b.txt"))))
    (define-values (calls disk snapshots) (scripted-run keys columns rows frames))
    (define startup
      '((resolve "/cwd/a.txt") (resolve "/cwd/a.txt")
        (kind "/cwd/a.txt") (resolve "/cwd/a.txt")
        (kind "/cwd/a.txt") (resolve "/cwd/a.txt") (read "/cwd/a.txt")))
    (define opening
      '((resolve "b.txt") (kind "/cwd/b.txt") (resolve "/cwd/b.txt")
        (kind "/cwd/b.txt") (resolve "/cwd/b.txt") (read "/cwd/b.txt")))
    (define saving '((kind "/cwd/a.txt") (resolve "/cwd/a.txt") (write "/cwd/a.txt" "di!sk a")))
    (check-equal? (all-calls calls) (append startup opening saving))
    (check-equal? (take snapshots 10) (make-list 10 startup))
    ;; Includes both prefix keys, every typed name key, Return and following edit/save.
    (check-equal? (take (drop snapshots 10) 15) (make-list 15 (append startup opening)))
    (check-equal? (drop snapshots 25) (make-list 14 (append startup opening saving)))
    (check-equal? (map (lambda (op) (length (effects calls op))) '(resolve kind read write)) '(8 5 2 1))
    (check-equal? (host-receiver-send disk 'read '("/cwd/a.txt")) "di!sk a")
    (check-equal? (host-receiver-send disk 'read '("/cwd/b.txt")) "disk b")))
