(test-case "both add arities, selected-buffers, switches, sparse IDs and duplicate names"
  (define-values (st calls) (state))
  (fixture! st)
  (define original (ev st 'source))
  (for ([path (list #f '(Path new "/new"))])
    (define added (buffer 42 (fresh "added") (if path `(Option Some ,path) no-path)))
    (same-session st `(source add-buffer "added" ,@(if path (list path) '()))
      (selection 'source (zipper (list 'a 'b added 'c) 2)
        (config (selected-views views 55 42 0 0)))))
  (same-session st '(source switch-buffer)
    (selection 'source (zipper '(a b c) 2) (config (selected-views views 55 27 1 2))))
  (same-session st '(source selected-buffers (source buffers))
    (selection 'source (zipper '(a b c) 1) (config)))
  (same-session st '(source selected-buffers (AloemacsBuffers new (List empty) a (List of b c)))
    (selection 'source (zipper '(a b c) 0) (config (selected-views views 55 41 1 1))))
  (for ([name '("/cwd/b.txt" "/cwd/a.txt" "untitled")]
        [focus '(1 0 2)] [id '(9 41 27)] [row '(2 1 1)] [col '(3 1 2)])
    (same-session st `(source select-buffer-submitted ,name)
      (selection 'source (zipper '(a b c) focus) (config (selected-views views 55 id row col)))))
  (for ([name '("" "missing" "b.txt")])
    (same-session st `(source select-buffer-submitted ,name) (rebuild 'source #:echo "failed")))
  (def! st 'duplicate (buffer 73 'rich '(Option Some (Path new "/cwd/b.txt"))))
  (def! st 'dups (session (zipper '(a duplicate b c) 2)))
  (same-session st '(dups select-buffer-submitted "/cwd/b.txt")
    (selection 'dups (zipper '(a duplicate b c) 2) (config)))
  (same-session st '(dups find-file-submitted "b.txt")
    (selection 'dups (zipper '(a duplicate b c) 2) (config)))
  (assert-effects calls '((resolve "b.txt")))
  ;; A scan from c wraps to the earlier duplicate, keeping logical order.
  (define cviews (selected-views views 55 27 1 2))
  (def! st 'last (session (zipper '(a duplicate b c) 3) (config cviews)))
  (same-session st '(last select-buffer-submitted "/cwd/b.txt")
    (selection 'last (zipper '(a duplicate b c) 1) (config (selected-views cviews 55 73 2 3))))
  (define added (buffer 74 (fresh "added")))
  (same-session st '(dups add-buffer "added")
    (selection 'dups (zipper (list 'a 'duplicate 'b added 'c) 3)
      (config (selected-views views 55 74 0 0))))
  (check-equal? (ev st 'source) original)
  (assert-effects calls '()))

(test-case "visit/find-file, direct save, save-as and refusals have exact counted effects"
  (define-values (st calls) (state))
  (fixture! st)
  (define original (ev st 'source))
  (define reset (config (selected-views views 55 9 0 0)))
  (same-session st '(source visited "visit" (Path new "/visit"))
    (visited 'source "visit" '(Path new "/visit") reset))
  (same st '(source visit (Path new "a.txt"))
    `(Option Some ,(visited 'source "λ\r\nb\n" '(Path new "/cwd/a.txt") reset)))
  (assert-effects calls (read-calls "a.txt" "/cwd/a.txt"))
  (same st '(source visit (Path new "missing"))
    `(Option Some ,(visited 'source "" '(Path new "/cwd/missing") reset)))
  (assert-effects calls '((resolve "missing") (kind "/cwd/missing") (resolve "/cwd/missing")))
  (for ([path '("dir" "link" "other")])
    (same st `(source visit (Path new ,path)) '(if #t (Option None) (Option Some source)))
    (assert-effects calls `((resolve ,path) (kind ,(string-append "/cwd/" path))
                           (resolve ,(string-append "/cwd/" path))))
    (same-session st `(source find-file-submitted ,path) (rebuild 'source #:echo "failed"))
    (assert-effects calls `((resolve ,path) (kind ,(string-append "/cwd/" path))
                           (resolve ,(string-append "/cwd/" path)))))
  (for ([name '("a.txt" "b.txt")] [focus '(0 1)] [id '(41 9)] [row '(1 2)] [col '(1 3)])
    (same-session st `(source find-file-submitted ,name)
      (selection 'source (zipper '(a b c) focus) (config (selected-views views 55 id row col))))
    (assert-effects calls `((resolve ,name))))
  (for ([name '("new.txt" "missing")] [contents '("" "")])
    (define path (string-append "/cwd/" name))
    (define added (buffer 42 (fresh contents) `(Option Some (Path new ,path))))
    (same-session st `(source find-file-submitted ,name)
      (selection 'source (zipper (list 'a 'b added 'c) 2)
        (config (selected-views views 55 42 0 0))))
    (assert-effects calls `((resolve ,name) (kind ,path) (resolve ,path))))
  ;; Existing regular file absent from the live collection is read and inserted.
  (def! st 'unbound-a (buffer 41 '(a editor)))
  (def! st 'no-a (session (zipper '(unbound-a b c) 1)))
  (same-session st '(no-a find-file-submitted "a.txt")
    (selection 'no-a
      (zipper (list 'unbound-a 'b (buffer 42 (fresh "λ\r\nb\n") '(Option Some (Path new "/cwd/a.txt"))) 'c) 2)
      (config (selected-views views 55 42 0 0))))
  (assert-effects calls (read-calls "a.txt" "/cwd/a.txt"))
  (same-session st '(source find-file-submitted "") (rebuild 'source #:echo "failed"))
  (same-session st '(source save-as-submitted "") (rebuild 'source #:echo "failed"))
  (assert-effects calls '())
  (same st '(source save) '(Option Some source))
  (assert-effects calls (cdr (write-calls "/cwd/b.txt" "/cwd/b.txt" rich-string)))
  (same-session st '(source save-as-submitted "a.txt")
    (rebuild 'source #:buffers (replacement 'source 'rich '(Option Some (Path new "/cwd/a.txt")))
      #:echo "saved"))
  (assert-effects calls (write-calls "a.txt" "/cwd/a.txt" rich-string))
  (same-session st '(source save-as-submitted "dir") (rebuild 'source #:echo "failed"))
  (assert-effects calls '((resolve "dir") (kind "/cwd/dir") (resolve "/cwd/dir")))
  (def! st 'untitled (rebuild 'source #:buffers (replacement 'source 'rich no-path)))
  (same st '(untitled save) '(if #t (Option None) (Option Some untitled)))
  (assert-effects calls '())
  (check-equal? (ev st 'source) original)
  (define-values (failed fcalls) (state #:fail 'write))
  (fixture! failed)
  (define before (ev failed 'source))
  (check-exn exn:fail? (lambda () (ev failed '(source save-as-submitted "a.txt"))))
  (check-equal? (ev failed 'source) before)
  (assert-effects fcalls (write-calls "a.txt" "/cwd/a.txt" rich-string)))

(test-case "kill retargets every matching ID with captured successor or predecessor origin"
  (define-values (st calls) (state))
  (fixture! st)
  (define original (ev st 'source))
  (for ([vs (list views '((71 9 7 11 #t) (3 27 5 6 #f) (55 9 2 3 #t)
                        (8 41 9 13 #t) (24 9 4 8 #f)))])
    (def! st 's (session (zipper '(a b c) 1) (config vs)))
    (same-session st '(s kill-buffer)
      (selection 's (zipper '(a c) 1) (config (removed-views vs 9 27 1 2)))))
  (define last-views '((71 27 7 11 #t) (3 9 5 6 #f) (55 27 1 2 #t)
                      (8 41 9 13 #t) (24 27 4 8 #f)))
  (def! st 'last (session (zipper '(a b c) 2) (config last-views)))
  (same-session st '(last kill-buffer)
    (selection 'last (zipper '(a b) 1) (config (removed-views last-views 27 9 2 3))))
  ;; Removed maximum 42 can legally be reused. Every old view already names c.
  (define reuse-views (removed-views views 9 42 2 3))
  (def! st 'maximum (buffer 42 'rich '(b path)))
  (def! st 'reuse (session (zipper '(a maximum c) 1) (config reuse-views)))
  (define survivor-views (removed-views reuse-views 42 27 1 2))
  (def! st 'killed '(reuse kill-buffer))
  (same-session st 'killed (selection 'reuse (zipper '(a c) 1) (config survivor-views)))
  (same-session st '(killed add-buffer "new")
    (selection 'killed (zipper (list 'a 'c (buffer 42 (fresh "new"))) 2)
      (config (selected-views survivor-views 55 42 0 0))))
  (for ([id '(71 24)])
    (same st `(((actual windows) tree) find-view ,id)
      `(Option Some (AloemacsView new ,id 27 1 2 ,(if (= id 71) #t #f)))))
  (check-equal? (ev st 'source) original)
  (assert-effects calls '()))

