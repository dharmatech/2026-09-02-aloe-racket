(test-case "waiting prompt selection/kill/add preserves line and slot; Return targets current then"
  (define-values (st calls) (state))
  (fixture! st)
  (def! st 'waiting (rebuild 'source #:searching #f #:pending no-pending
    #:prompt '(Option Some (AloemacsPrompt new "Save as: " "a.txt" 5 "" (List empty) (List empty) 0))))
  (define added (buffer 42 (fresh "inserted")))
  (for ([send '((select-buffer-submitted "untitled") (switch-buffer) (kill-buffer)
                (add-buffer "inserted") (select-buffer-submitted "/cwd/b.txt"))]
        [buffers (list (zipper '(a b c) 2) (zipper '(a b c) 2) (zipper '(a c) 1)
                       (zipper (list 'a 'b added 'c) 2) (zipper '(a b c) 1))]
        [vs (list (selected-views views 55 27 1 2) (selected-views views 55 27 1 2)
                  (removed-views views 9 27 1 2) (selected-views views 55 42 0 0) views)]
        [ed (list '(c editor) '(c editor) '(c editor) (fresh "inserted") 'rich)]
        [contents (list "one\nthree\nlast" "one\nthree\nlast" "one\nthree\nlast" "inserted" rich-string)])
    (def! st 'changed `(waiting ,@send))
    (same-session st 'changed (selection 'waiting buffers (config vs)))
    (same-session st '(changed handle-key "return")
      (rebuild 'changed #:buffers (replacement 'changed ed '(Option Some (Path new "/cwd/a.txt")))
        #:echo "saved" #:prompt no-prompt #:submission '(Option Some "a.txt") #:waiting no-command))
    (assert-effects calls (write-calls "a.txt" "/cwd/a.txt" contents)))
  ;; Find-file completion adds relative to the new current after direct kill.
  (def! st 'finding (rebuild 'waiting
    #:prompt '(Option Some (AloemacsPrompt new "Find file: " "new.txt" 7 "" (List empty) (List empty) 0))
    #:waiting '(Option Some (AloemacsCommand FindFile))))
  (def! st 'removed '(finding kill-buffer))
  (define killed-views (removed-views views 9 27 1 2))
  (same-session st 'removed (selection 'finding (zipper '(a c) 1) (config killed-views)))
  (same-session st '(removed handle-key "return")
    (rebuild 'removed
      #:buffers (zipper (list 'a 'c (buffer 42 (fresh "") '(Option Some (Path new "/cwd/new.txt")))) 2)
      #:prompt no-prompt #:submission '(Option Some "new.txt") #:waiting no-command
      #:windows (config (selected-views killed-views 55 42 0 0))))
  (assert-effects calls '((resolve "new.txt") (kind "/cwd/new.txt") (resolve "/cwd/new.txt")))
  ;; Selection completion reuses current-name after selection changed current.
  (def! st 'selecting (rebuild 'waiting
    #:prompt '(Option Some (AloemacsPrompt new "Buffer: " "untitled" 8 "" (List empty) (List empty) 0))
    #:waiting '(Option Some (AloemacsCommand SelectBuffer))))
  (def! st 'changed '(selecting switch-buffer))
  (same-session st '(changed handle-key "return")
    (rebuild 'changed #:prompt no-prompt #:submission '(Option Some "untitled") #:waiting no-command))
  (assert-effects calls '()))

(test-case "selected-rectangle/fallback fit, resize, repeated fit, unknown sizes and frame purity"
  (define-values (st calls) (state))
  (fixture! st)
  (for ([size '((1 2) (2 1) (12 4) (80 24))]
        [row '(2 2 2 2)] [col '(4 3 3 3)] [text-rows '(1 1 2 4)])
    (define ed (editor #:row row #:left col #:rows text-rows))
    (same-session st `(source ensure-visible ,@size)
      (rebuild 'source #:buffers (replacement 'source ed)
        #:windows (config (selected-views views 55 9 row col) 55 (car size) (cadr size))))
    (def! st 'fitted `(source ensure-visible ,@size))
    (same-session st `(fitted ensure-visible ,@size) (rebuild 'fitted)))
  (def! st 'small '(source ensure-visible 1 2))
  (same-session st '(small ensure-visible 12 4)
    (rebuild 'small #:buffers (replacement 'small (editor #:left 4 #:rows 2))
      #:windows (config (selected-views views 55 9 2 4) 55 12 4)))
  (for ([size '((0 0) (1 2))])
    (def! st 's (session (zipper '(a b c) 1) (config views 55 (car size) (cadr size))))
    (for ([send '((with-echo "failed") (move-left) (switch-buffer) (kill-buffer)
                  (add-buffer "new") (visited "new" (Path new "new")))])
      (same st `(((s ,@send) windows) columns) (car size))
      (same st `(((s ,@send) windows) rows) (cadr size))))
  ;; Retain the complete one-view golden and its purity proof. Multi-view
  ;; geometry/composition is owned by windows-layout-and-rendering.rkt.
  (define single `(AloemacsWindows new ,(leaf '(55 9 2 3 #t)) 55 0 0))
  (def! st 'one (rebuild 'source #:windows single))
  (define snapshot (ev st 'one))
  (check-equal? (ev st '(one frame 8 3))
    (string-append "\e[?25l\e[2J\e[Hrd-long\e[1;2H\e[?25h"
                   "\e[?25l\e[2;1H/cwd/b.t\e[3;1Hdraft: i\e[3;8H\e[?25h"))
  (check-equal? (ev st 'one) snapshot)
  (assert-effects calls '()))

(test-case "class/field/constructor shapes, commands and maps stay exact; no window entry"
  (define source (call-with-input-file file-path (lambda (in) (port->list read in))))
  (define classes (filter (lambda (d) (eq? (car d) 'define-class)) source))
  (define (decl name) (findf (lambda (d) (equal? (cadr d) name)) classes))
  (check-equal? (take source 2) '((load "editor.aloe") (load "../../lib/fs.aloe")))
  (check-equal? (map cadr classes)
    '(AloemacsPrompt AloemacsCompletionScan AloemacsBuffer AloemacsBuffers AloemacsModeLine AloemacsView AloemacsWindowTree
      AloemacsWindowRect AloemacsWindows AloemacsCommand (AloemacsKeymap B)
      AloemacsBinding AloemacsSearchScan (AloemacsSession H)))
  (for ([entry
         '((AloemacsView (fields (id Int) (buffer-id Int) (scroll-row Int) (scroll-col Int) (locked Bool)))
           (AloemacsWindowTree (constructors (Leaf (fields (view AloemacsView)))
             (Below (fields (top AloemacsWindowTree) (bottom AloemacsWindowTree)))
             (Right (fields (left AloemacsWindowTree) (right AloemacsWindowTree)))))
           (AloemacsWindowRect (fields (x Int) (y Int) (columns Int) (rows Int)))
           (AloemacsWindows (fields (tree AloemacsWindowTree) (selected Int) (columns Int) (rows Int)))
           (AloemacsBuffer (fields (editor AloemacsEditor) (path (Option Path)) (id Int)))
           ((AloemacsSession H) (fields (buffers AloemacsBuffers) (fs (Fs H)) (echo String)
             (searching Bool) (query String) (origin Position) (wrapped Bool) (failing Bool)
             (kill-ring (List String)) (pending (Option (AloemacsKeymap AloemacsBinding)))
             (prompt (Option AloemacsPrompt)) (last-submission (Option String))
             (waiting-command (Option AloemacsCommand)) (windows AloemacsWindows))))])
    (check-equal? (caddr (decl (car entry))) (cadr entry)))
  (check-equal? (map car (cdr (caddr (decl 'AloemacsCommand))))
    '(Newline BackwardDelete MoveLeft MoveRight MoveUp MoveDown LineStart LineEnd
      PageUp PageDown BufferStart BufferEnd RequestQuit Undo SetMark Kill KillLine
      Yank Find Save SelfInsert SwitchBuffer KillBuffer FindFile SaveAs SelectBuffer
      SplitBelow SplitRight DeleteWindow OtherWindow ToggleWindowLock))
  (define-values (st calls) (state))
  (fixture! st)
  (same st '((aloemacs-ctrl-x-keymap bindings) map (fn (binding) (binding key)))
    '(List of "save" "find" "kill" "b" "2" "3" "0" "o" "l"))
  (same st '((aloemacs-global-keymap bindings) map (fn (binding) (binding key)))
    '(List of "return" "backspace" "left" "right" "up" "down" "line-start" "line-end"
       "page-up" "page-down" "buffer-start" "buffer-end" "escape" "undo" "mark" "kill"
       "kill-line" "yank" "find" "save" "ctrl-x"))
  (for ([bad '((source select-view 3) (source lock-window))])
    (check-exn exn:fail:aloe-type? (lambda () (ev st bad))))
  (assert-effects calls '()))
