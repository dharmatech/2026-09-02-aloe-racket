#lang racket/base

;; aloemacs-window-point 000: each window keeps its own cursor in the buffer
;; it shows. The editor point is the selected window's cursor.

(require racket/list racket/runtime-path racket/string rackunit
         "../../aloe/driver.rkt" "../../aloe/parse.rkt"
         (only-in "../../aloe/type.rkt" exn:fail:aloe-type? type-of type->datum)
         "../../host/racket/fs.rkt" "../../host/racket/term.rkt"
         "../../host/racket/aloemacs-run.rkt")

(define-runtime-path file-path "../../examples/aloemacs/file.aloe")
(define-runtime-path main-path "../../examples/aloemacs/main.aloe")

(define lines100 (for/list ([n (in-range 100)]) (format "line ~a" n)))
(define contents100 (string-join lines100 "\n"))
(define b-contents (string-join (for/list ([n (in-range 40)]) (format "b ~a" n)) "\n"))
(define (fs-double)
  (make-fs-double "/cwd"
    (hash "/cwd" 'directory "/cwd/lines.txt" 'file "/cwd/b.txt" 'file)
    (hash "/cwd/lines.txt" contents100 "/cwd/b.txt" b-contents)))

(define st (make-driver))
(driver-inject-host! st 'fs-host (fs-double))
(void (driver-load-file! st main-path))

(define (ev expr) (driver-eval! st expr))
(define (def! name expr) (ev `(define ,name ,expr)))
(define (same actual expected)
  (check-not-exn (lambda () (ev `(check ,actual ,expected)))
                 (format "~s equals ~s" actual expected)))
(define (dtype expr)
  (type->datum (type-of (parse-datum expr) (driver-type-environment st))))
(define (rejects bad)
  (check-exn exn:fail:aloe-type? (lambda () (ev bad)) (format "reject ~s" bad)))

;; One check for the invariant: the selected view stores the editor point,
;; the editor origin and the current buffer's id.
(define (invariant! name)
  (check-true
    (ev `((((,name windows) tree) find-view ((,name windows) selected)) case
           (None () #f)
           (Some (view)
             (if ((view point) = (,name point))
                 (if ((view scroll-row) = ((,name editor) scroll-row))
                     (if ((view scroll-col) = ((,name editor) scroll-col))
                         ((view buffer-id) = ((,name current-buffer) id))
                         #f)
                     #f)
                 #f))))
    (format "invariant holds for ~a" name)))
;; Every program step in this file goes through step!.
(define (step! name expr)
  (def! name expr)
  (invariant! name))

;; Expected values use raw constructors and selectors only.
(define (pos p) `(Position new ,(car p) ,(cadr p)))
(define (view id bid point origin)
  `(AloemacsView new ,id ,bid ,(car origin) ,(cadr origin) ,(pos point) #f (Option None)))
(define (leaf id bid point origin) `(AloemacsWindowTree Leaf ,(view id bid point origin)))
(define (below a b) `(AloemacsWindowTree Below ,a ,b))
(define (right a b) `(AloemacsWindowTree Right ,a ,b))
(define (rect x y columns rows) `(AloemacsWindowRect new ,x ,y ,columns ,rows))
(define (indexed lines focus)
  `(Text indexed (List of ,@(reverse (take lines focus))) ,(list-ref lines focus)
     (List of ,@(drop lines (add1 focus))) ,focus))

(define (at! s point origin)
  (same `(,s point) (pos point))
  (check-equal? (list (ev `((,s editor) scroll-row)) (ev `((,s editor) scroll-col))) origin
                (format "~a origin" s)))
(define (stores! s id bid point origin)
  (same `(((,s windows) tree) find-view ,id) `(Option Some ,(view id bid point origin))))
(define (selected! s id) (check-equal? (ev `((,s windows) selected)) id))
(define (focus-line s) (ev `(((,s editor) text) focus-line)))
;; A fit that moves neither point, origin, Text nor any view. It may still
;; record the selected leaf's text rows on the editor.
(define (fit-keeps! s)
  (def! 'fitted `(,s ensure-visible 80 24))
  (invariant! 'fitted)
  (same '(fitted point) `(,s point))
  (same '((fitted editor) scroll-row) `((,s editor) scroll-row))
  (same '((fitted editor) scroll-col) `((,s editor) scroll-col))
  (same '((fitted editor) text) `((,s editor) text))
  (same '(fitted windows) `(,s windows)))

(define prefix "\e[?25l\e[2J\e[H")
(define LIGHT "\e[38;5;16;48;5;250m")
(define PLAIN "\e[0m")
(define (cursor row col) (format "\e[~a;~aH" row col))
(define (frame-of s) (ev `(,s frame 80 24)))
(define (frame-rows f) (string-split (substring f (string-length prefix)) "\r\n" #:trim? #f))
(define (final-cursor f)
  (define m (regexp-match #px"\e\\[([0-9]+);([0-9]+)H\e\\[\\?25h$" f))
  (and m (list (string->number (cadr m)) (string->number (caddr m)))))
(define (pad s w) (string-append s (make-string (- w (string-length s)) #\space)))
;; A mode row at least seven wide is the name row at width - 6, then the group.
(define (mode-row name width)
  (define (name-row width)
    (define label (string-append name " "))
    (string-append label (make-string (- width (string-length label)) #\-)))
  (if (>= width 7) (string-append (name-row (- width 6)) " ↕ ↔ ×") (name-row width)))
;; The one-view frame at 80 by 24: 22 text rows, the bar, then the echo row.
(define (one-view lines top line column [name "/cwd/lines.txt"])
  (define at (cursor (+ 1 (- line top)) (+ 1 column)))
  (string-append prefix
    (string-join (for/list ([i (in-range top (+ top 22))])
                   (if (< i (length lines)) (list-ref lines i) "")) "\r\n")
    at "\e[?25h\e[?25l" (cursor 23 1) LIGHT (mode-row name 80) PLAIN
    (cursor 24 1) at "\e[?25h"))

;; The 100-line buffer, one view 0 at (0, 0), fitted once at 80 by 24.
(def! 's0 `((aloemacs-editor visited ,contents100 (Path new "/cwd/lines.txt"))
            ensure-visible 80 24))
(invariant! 's0)
(selected! 's0 0)
(same '((s0 windows) tree) (leaf 0 0 '(0 0) '(0 0)))

;; Nearby lines: two views from split-below, view 0 selected at (0, 0),
;; view 1 storing (3, 0) and origin (0, 0).
(define (nearby! name)
  (step! name '(s0 split-below))
  (step! name `(,name other-window))
  (for ([_ (in-range 3)]) (step! name `(,name move-down)))
  (step! name `(,name other-window)))

(test-case "types: seven view fields, install, split and retarget arities"
  (define source (call-with-input-file file-path
                   (lambda (in) (for/list ([d (in-port read in)]) d))))
  (check-equal? (findf (lambda (d) (and (eq? (car d) 'define-class)
                                        (eq? (cadr d) 'AloemacsView))) source)
    '(define-class AloemacsView
       (fields
         (id Int)
         (buffer-id Int)
         (scroll-row Int)
         (scroll-col Int)
         (point Position)
         (locked Bool)
         (picture (Option AloemacsLeafPicture)))
       (methods)))
  (check-equal? (dtype '(AloemacsView new 0 0 0 0 (Position new 0 0) #f (Option None)))
                'AloemacsView)
  (for ([bad '((AloemacsView new 0 0 0 0 #f (Option None))
               (AloemacsView new 0 0 0 0 (Position new 0 0) #f (Option None) 0)
               (AloemacsView new 0 0 0 0 0 #f (Option None)))])
    (rejects bad))
  (def! 'ed '(s0 editor))
  (check-equal? (dtype '(ed install (Position new 0 0) 0 0)) 'AloemacsEditor)
  (for ([bad '((ed install)
               (ed install (Position new 0 0))
               (ed install (Position new 0 0) 0)
               (ed install (Position new 0 0) 0 0 0)
               (ed install 0 0 0)
               (ed install (Position new 0 0) "0" 0)
               (ed install (Position new 0 0) 0 #f)
               ((ed text) install (Position new 0 0) 0 0)
               ((s0 windows) install (Position new 0 0) 0 0)
               (s0 install (Position new 0 0) 0 0)
               (0 install (Position new 0 0) 0 0)
               ("x" install (Position new 0 0) 0 0))])
    (rejects bad))
  (def! 'tree '((s0 windows) tree))
  (def! 'ws '(s0 windows))
  (check-equal? (dtype '(tree with-split 0 1 0 0 (Position new 0 0) #t)) 'AloemacsWindowTree)
  (check-equal? (dtype '(ws with-split 0 0 (Position new 0 0) #t)) 'AloemacsWindows)
  (check-equal? (dtype '(tree retarget-buffer 0 1 0 0 (Position new 0 0))) 'AloemacsWindowTree)
  (for ([bad '((tree with-split 0 1 0 0 #t)
               (tree with-split 0 1 0 0 (Position new 0 0) #t 0)
               (tree with-split 0 1 0 0 0 #t)
               (ws with-split 0 0 #t)
               (ws with-split 0 0 (Position new 0 0) #t 0)
               (ws with-split 0 0 0 #t)
               (tree retarget-buffer 0 1 0 0)
               (tree retarget-buffer 0 1 0 0 (Position new 0 0) 0)
               (tree retarget-buffer 0 1 0 0 0))])
    (rejects bad)))

(test-case "install clamps into the text, focuses its line and keeps the rest"
  (define abc '("alpha" "be" "c"))
  (define history '(List of (UndoFrame new (Text from-string "previous") (Position new 0 2) 1 2)))
  (define (raw text point origin)
    `(AloemacsEditor new ,text ,(pos point) #t ,(car origin) ,(cadr origin)
       ,history (Option Some (Position new 0 1)) 9))
  (for ([receiver (list (indexed abc 0) '(Text from-string "alpha\nbe\nc"))])
    (def! 'ed (raw receiver '(0 0) '(4 5)))
    ;; Send, installed point, focused line, origin.
    (for ([row '(((0 5) (1 2) (0 5) 0 (1 2))
                 ((2 0) (0 0) (2 0) 2 (0 0))
                 ((1 4) (0 0) (1 2) 1 (0 0))
                 ((7 1) (0 0) (2 1) 2 (0 0))
                 ((0 0) (40 50) (0 0) 0 (40 50)))])
      (define sent `(ed install ,(pos (list-ref row 0)) ,@(list-ref row 1)))
      (same sent (raw (indexed abc (list-ref row 3)) (list-ref row 2) (list-ref row 4)))
      (same `((,sent text) to-string) "alpha\nbe\nc")))
  ;; A focus already on the installed line returns the same Text value.
  (def! 'ed (raw (indexed abc 0) '(0 0) '(4 5)))
  (check-eq? (ev '((ed install (Position new 0 5) 1 2) text)) (ev '(ed text))))

(test-case "four columns: each window keeps its own place in one buffer"
  (step! 'four 's0)
  (for ([_ (in-range 3)]) (step! 'four '(four split-right)))
  (same '((((four windows) tree) leaves) map (fn (v) (v id))) '(List of 0 3 2 1))
  (for ([id '(0 3 2 1)]
        [r (list (rect 0 0 10 23) (rect 11 0 9 23) (rect 21 0 19 23) (rect 41 0 39 23))])
    (same `(((four windows) tree) rect-for ,id ,(rect 0 0 80 23)) `(Option Some ,r))
    (stores! 'four id 0 '(0 0) '(0 0)))
  (step! 'end '(four buffer-end))
  (step! 'end '(end ensure-visible 80 24))
  (at! 'end '(99 7) '(78 0))
  (stores! 'end 0 0 '(99 7) '(78 0))
  (step! 'second '(end other-window))
  (selected! 'second 3)
  (at! 'second '(0 0) '(0 0))
  (stores! 'second 0 0 '(99 7) '(78 0))
  (stores! 'second 3 0 '(0 0) '(0 0))
  (step! 'second-fit '(second ensure-visible 80 24))
  (same 'second-fit 'second)
  (define f (frame-of 'second-fit))
  (check-equal? (final-cursor f) '(1 12))
  (check-equal? (substring (car (frame-rows f)) 11 20) "line 0   ")
  (check-equal? (substring (car (frame-rows f)) 0 10) "line 78   ")
  (step! 'w 'second-fit)
  (for ([id '(2 1)])
    (step! 'w '(w other-window))
    (fit-keeps! 'w)
    (step! 'w '(w ensure-visible 80 24))
    (selected! 'w id)
    (at! 'w '(0 0) '(0 0))
    (stores! 'w 0 0 '(99 7) '(78 0)))
  (step! 'w '(w other-window))
  (fit-keeps! 'w)
  (selected! 'w 0)
  (at! 'w '(99 7) '(78 0))
  (check-equal? (focus-line 'w) 99)
  (check-equal? (final-cursor (frame-of 'w)) '(22 8))
  (for ([id '(3 2 1)]) (stores! 'w id 0 '(0 0) '(0 0))))

(test-case "nearby lines: both cursors and both origins are kept"
  (step! 'n '(s0 split-below))
  (for ([id '(0 1)] [r (list (rect 0 0 80 12) (rect 0 12 80 11))])
    (same `(((n windows) tree) rect-for ,id ,(rect 0 0 80 23)) `(Option Some ,r)))
  (step! 'n '(n other-window))
  (fit-keeps! 'n)
  (step! 'n '(n ensure-visible 80 24))
  (for ([_ (in-range 3)]) (step! 'n '(n move-down)) (fit-keeps! 'n))
  (at! 'n '(3 0) '(0 0))
  (step! 'n '(n other-window))
  (fit-keeps! 'n)
  (selected! 'n 0)
  (at! 'n '(0 0) '(0 0))
  (check-equal? (final-cursor (frame-of 'n)) '(1 1))
  (stores! 'n 1 0 '(3 0) '(0 0))
  (step! 'n '(n other-window))
  (fit-keeps! 'n)
  (selected! 'n 1)
  (at! 'n '(3 0) '(0 0))
  (check-equal? (final-cursor (frame-of 'n)) '(16 1))
  (stores! 'n 0 0 '(0 0) '(0 0)))

(test-case "sticky numbers across newline, a joining backward-delete and undo"
  (nearby! 'n)
  (selected! 'n 0)
  (stores! 'n 1 0 '(3 0) '(0 0))
  (step! 'nl '(n newline))
  (at! 'nl '(1 0) '(0 0))
  (stores! 'nl 0 0 '(1 0) '(0 0))
  (stores! 'nl 1 0 '(3 0) '(0 0))
  (define rows (frame-rows (frame-of 'nl)))
  (check-equal? (take (drop rows 12) 4)
                (map (lambda (s) (pad s 80)) '("" "line 0" "line 1" "line 2")))
  (step! 'back '(nl other-window))
  (selected! 'back 1)
  (at! 'back '(3 0) '(0 0))
  (same '((back text) current-line) "line 2")
  (step! 'back '(back ensure-visible 80 24))
  (check-equal? (final-cursor (frame-of 'back)) '(16 1))
  (step! 'undone '(back undo))
  (same '((undone text) to-string) contents100)
  (at! 'undone '(0 0) '(0 0))
  (stores! 'undone 1 0 '(0 0) '(0 0))
  (stores! 'undone 0 0 '(1 0) '(0 0))
  ;; A deletion above the other view leaves its numbers alone.
  (step! 'joined '(n move-down))
  (step! 'joined '(joined backward-delete))
  (at! 'joined '(0 6) '(0 0))
  (same '((joined text) current-line) "line 0line 1")
  (stores! 'joined 1 0 '(3 0) '(0 0)))

(test-case "clamp on entry, before any fit"
  (step! 'c `((aloemacs-editor visited "abc\ndefgh\nij" (Path new "/cwd/c.txt"))
              ensure-visible 80 24))
  (step! 'c '(c split-below))
  ;; View 1 stores the end of "defgh"; view 0 empties that line.
  (step! 'k '(c other-window))
  (step! 'k '(k move-down))
  (step! 'k '(k line-end))
  (step! 'k '(k other-window))
  (step! 'k '(k move-down))
  (stores! 'k 1 0 '(1 5) '(0 0))
  (step! 'k '(k kill-line))
  (same '((k text) to-string) "abc\n\nij")
  (selected! 'k 0)
  (stores! 'k 1 0 '(1 5) '(0 0))
  (check-equal? (take (drop (frame-rows (frame-of 'k)) 12) 4)
                (map (lambda (s) (pad s 80)) '("abc" "" "ij" "")))
  (step! 'entered '(k other-window))
  (selected! 'entered 1)
  (at! 'entered '(1 0) '(0 0))
  (stores! 'entered 1 0 '(1 0) '(0 0))
  (check-equal? (focus-line 'entered) 1)
  ;; View 1 stores the end of "ij"; view 0 joins the last two lines.
  (step! 'j '(c other-window))
  (step! 'j '(j move-down))
  (step! 'j '(j move-down))
  (step! 'j '(j line-end))
  (step! 'j '(j other-window))
  (step! 'j '(j move-down))
  (step! 'j '(j line-end))
  (stores! 'j 1 0 '(2 2) '(0 0))
  (step! 'j '(j kill-line))
  (same '((j text) to-string) "abc\ndefghij")
  (stores! 'j 1 0 '(2 2) '(0 0))
  (step! 'entered '(j other-window))
  (at! 'entered '(1 7) '(0 0))
  (stores! 'entered 1 0 '(1 7) '(0 0))
  (same '((entered editor) text) (indexed '("abc" "defghij") 1)))

(test-case "split copies point and origin; the cursors then diverge"
  (step! 'deep '(s0 buffer-end))
  (step! 'deep '(deep ensure-visible 80 24))
  (for ([_ (in-range 10)]) (step! 'deep '(deep move-up)))
  (at! 'deep '(89 7) '(78 0))
  ;; Below: the post-split fit moves only the selected original.
  (step! 'b '(deep split-below))
  (same '((b windows) tree)
        (below (leaf 0 0 '(89 7) '(79 0)) (leaf 1 0 '(89 7) '(78 0))))
  (step! 'b '(b move-down))
  (step! 'b '(b ensure-visible 80 24))
  (stores! 'b 0 0 '(90 7) '(80 0))
  (stores! 'b 1 0 '(89 7) '(78 0))
  (step! 'r '(deep split-right))
  (same '((r windows) tree)
        (right (leaf 0 0 '(89 7) '(78 0)) (leaf 1 0 '(89 7) '(78 0))))
  (step! 'r '(r move-down))
  (stores! 'r 0 0 '(90 7) '(78 0))
  (stores! 'r 1 0 '(89 7) '(78 0)))

(test-case "delete enters the survivor at its stored point and origin"
  ;; Same buffer: four columns, delete view 3; view 0 stored the end.
  (step! 'four 's0)
  (for ([_ (in-range 3)]) (step! 'four '(four split-right)))
  (step! 'four '(four buffer-end))
  (step! 'four '(four ensure-visible 80 24))
  (step! 'four '(four other-window))
  (at! 'four '(0 0) '(0 0))
  (step! 'del '(four delete-window))
  (selected! 'del 0)
  (at! 'del '(99 7) '(78 0))
  (check-equal? (focus-line 'del) 99)
  (same '((del windows) tree)
        (right (right (leaf 0 0 '(99 7) '(78 0)) (leaf 2 0 '(0 0) '(0 0)))
               (leaf 1 0 '(0 0) '(0 0))))
  ;; Different buffer: view 1 stores B's end; B's editor has moved since.
  (step! 'd `(s0 add-buffer ,b-contents (Path new "/cwd/b.txt")))
  (check-equal? (ev '((d current-buffer) id)) 1)
  (step! 'd '(d ensure-visible 80 24))
  (step! 'd '(d split-below))
  (step! 'd '(d other-window))
  (step! 'd '(d buffer-end))
  (step! 'd '(d ensure-visible 80 24))
  (at! 'd '(39 4) '(30 0))
  (step! 'd '(d other-window))
  (at! 'd '(0 0) '(0 0))
  (step! 'd '(d switch-buffer))
  (check-equal? (ev '((d current-buffer) id)) 0)
  (for ([_ (in-range 4)]) (step! 'd '(d move-down)))
  (at! 'd '(4 0) '(0 0))
  (stores! 'd 1 1 '(39 4) '(30 0))
  (same '(((((d buffers) after) first) editor) point) (pos '(0 0)))
  (step! 'gone '(d delete-window))
  (selected! 'gone 1)
  (check-equal? (ev '((gone current-buffer) id)) 1)
  (at! 'gone '(39 4) '(30 0))
  (check-equal? (focus-line 'gone) 39)
  (same '((gone windows) tree) (leaf 1 1 '(39 4) '(30 0)))
  (same '(((((gone buffers) before) first) editor) point) (pos '(4 0))))

(test-case "buffer identity: switch, select, find, visit and kill"
  ;; A is the 100-line buffer (id 0); B is the 40-line buffer (id 1) at (1, 3).
  (step! 'ab `(s0 add-buffer ,b-contents (Path new "/cwd/b.txt")))
  (step! 'ab '(ab move-down))
  (step! 'ab '(ab line-end))
  (at! 'ab '(1 3) '(0 0))
  (step! 'ab '(ab switch-buffer))
  (check-equal? (ev '((ab current-buffer) id)) 0)
  (step! 'ab '(ab ensure-visible 80 24))
  (step! 'ab '(ab split-below))
  ;; The switch return.
  (step! 'sw 'ab)
  (for ([_ (in-range 5)]) (step! 'sw '(sw move-down)))
  (step! 'sw '(sw switch-buffer))
  (check-equal? (ev '((sw current-buffer) id)) 1)
  (at! 'sw '(1 3) '(0 0))
  (stores! 'sw 0 1 '(1 3) '(0 0))
  (stores! 'sw 1 0 '(0 0) '(0 0))
  (same '(((((sw buffers) before) first) editor) point) (pos '(5 0)))
  (step! 'sw '(sw other-window))
  (selected! 'sw 1)
  (at! 'sw '(0 0) '(0 0))
  (step! 'sw '(sw move-down))
  (step! 'sw '(sw move-down))
  (at! 'sw '(2 0) '(0 0))
  (step! 'sw '(sw other-window))
  (selected! 'sw 0)
  (check-equal? (ev '((sw current-buffer) id)) 1)
  (at! 'sw '(1 3) '(0 0))
  (step! 'sw '(sw switch-buffer))
  (check-equal? (ev '((sw current-buffer) id)) 0)
  (at! 'sw '(2 0) '(0 0))
  (stores! 'sw 0 0 '(2 0) '(0 0))
  (stores! 'sw 1 0 '(2 0) '(0 0))
  ;; Select and find-file reuse take the arriving editor's point.
  (for ([send '((ab select-buffer-submitted "/cwd/b.txt") (ab find-file-submitted "b.txt"))])
    (step! 'arrived send)
    (check-equal? (ev '((arrived current-buffer) id)) 1)
    (at! 'arrived '(1 3) '(0 0))
    (stores! 'arrived 0 1 '(1 3) '(0 0))
    (stores! 'arrived 1 0 '(0 0) '(0 0)))
  ;; Visit writes (0, 0) on the selected view only; entering the other clamps.
  (step! 'v '(s0 split-below))
  (step! 'v '(v other-window))
  (step! 'v '(v buffer-end))
  (step! 'v '(v ensure-visible 80 24))
  (at! 'v '(99 7) '(90 0))
  (step! 'v '(v other-window))
  (for ([_ (in-range 3)]) (step! 'v '(v move-down)))
  (stores! 'v 0 0 '(3 0) '(0 0))
  (step! 'v '(v visited "short\ntext" (Path new "/cwd/lines.txt")))
  (at! 'v '(0 0) '(0 0))
  (stores! 'v 0 0 '(0 0) '(0 0))
  (stores! 'v 1 0 '(99 7) '(90 0))
  (step! 'v '(v other-window))
  (at! 'v '(1 4) '(90 0))
  (stores! 'v 1 0 '(1 4) '(90 0))
  (same '((v editor) text) (indexed '("short" "text") 1))
  ;; Kill: views 0 and 2 show A at different points, view 1 shows B.
  (step! 'kb `(s0 add-buffer ,b-contents (Path new "/cwd/b.txt")))
  (step! 'kb '(kb ensure-visible 80 24))
  (step! 'kb '(kb split-below))
  (step! 'kb '(kb buffer-end))
  (step! 'kb '(kb ensure-visible 80 24))
  (at! 'kb '(39 4) '(29 0))
  (step! 'kb '(kb switch-buffer))
  (step! 'kb '(kb split-right))
  (for ([_ (in-range 3)]) (step! 'kb '(kb move-down)))
  (same '((kb windows) tree)
        (below (right (leaf 0 0 '(3 0) '(0 0)) (leaf 2 0 '(0 0) '(0 0)))
               (leaf 1 1 '(0 0) '(0 0))))
  (step! 'killed '(kb kill-buffer))
  (check-equal? (ev '((killed current-buffer) id)) 1)
  (at! 'killed '(39 4) '(29 0))
  (same '((killed windows) tree)
        (below (right (leaf 0 1 '(39 4) '(29 0)) (leaf 2 1 '(39 4) '(29 0)))
               (leaf 1 1 '(0 0) '(0 0))))
  ;; Killing the only buffer puts every view of it at (0, 0).
  (step! 'only '(s0 split-below))
  (step! 'only '(only other-window))
  (step! 'only '(only buffer-end))
  (step! 'only '(only ensure-visible 80 24))
  (step! 'only '(only other-window))
  (step! 'only '(only move-down))
  (stores! 'only 1 0 '(99 7) '(90 0))
  (step! 'only '(only kill-buffer))
  (check-equal? (ev '((only current-buffer) id)) 0)
  (same '((only text) to-string) "")
  (same '((only windows) tree) (below (leaf 0 0 '(0 0) '(0 0)) (leaf 1 0 '(0 0) '(0 0)))))

(test-case "search: a direct entry keeps the match; ctrl-x ends the search first"
  ;; Views 0, 1 and 2 of one buffer; view 1 stores (4, 0), view 2 (6, 0).
  (step! 'q '(s0 split-below))
  (step! 'q '(q other-window))
  (for ([_ (in-range 4)]) (step! 'q '(q move-down)))
  (step! 'q '(q split-right))
  (step! 'q '(q other-window))
  (step! 'q '(q move-down))
  (step! 'q '(q move-down))
  (step! 'q '(q other-window))
  (selected! 'q 0)
  (same '((((q windows) tree) leaves) map (fn (v) (v id))) '(List of 0 1 2))
  (stores! 'q 1 0 '(4 0) '(0 0))
  (stores! 'q 2 0 '(6 0) '(0 0))
  (step! 'q '(q find))
  (for ([key '("n" "e" " " "2")]) (step! 'q `(q handle-key ,key)))
  (check-true (ev '(q searching)))
  (at! 'q '(2 2) '(0 0))
  (stores! 'q 0 0 '(2 2) '(0 0))
  ;; A direct send while searching installs the match.
  (step! 'direct '(q other-window))
  (selected! 'direct 1)
  (check-true (ev '(direct searching)))
  (check-equal? (ev '(direct query)) "ne 2")
  (same '(direct origin) '(q origin))
  (at! 'direct '(2 2) '(0 0))
  (stores! 'direct 0 0 '(2 2) '(0 0))
  (stores! 'direct 1 0 '(2 2) '(0 0))
  (stores! 'direct 2 0 '(6 0) '(0 0))
  ;; ctrl-x ends the search on view 0; o then enters view 1's own place.
  (step! 'chord '(q handle-key "ctrl-x"))
  (check-false (ev '(chord searching)))
  (stores! 'chord 0 0 '(2 2) '(0 0))
  (step! 'chord '(chord handle-key "o"))
  (selected! 'chord 1)
  (check-false (ev '(chord searching)))
  (at! 'chord '(4 0) '(0 0))
  (stores! 'chord 0 0 '(2 2) '(0 0))
  (stores! 'chord 1 0 '(4 0) '(0 0))
  (stores! 'chord 2 0 '(6 0) '(0 0)))

(test-case "kill uses the entered window's cursor and the one mark"
  (nearby! 'm)
  (step! 'm '(m move-right))
  (step! 'm '(m set-mark))
  (step! 'm '(m other-window))
  (at! 'm '(3 0) '(0 0))
  (same '((m editor) mark) '(Option Some (Position new 0 1)))
  (step! 'm '(m kill))
  (check-equal? (ev '((m kill-ring) first)) "ine 0\nline 1\nline 2\n")
  (at! 'm '(0 1) '(0 0))
  ;; Inserting above the mark in either view leaves it at (2, 0).
  (nearby! 'x)
  (step! 'x '(x move-down))
  (step! 'x '(x move-down))
  (step! 'x '(x set-mark))
  (step! 'x '(x buffer-start))
  (step! 'x '(x insert "X"))
  (same '((x editor) mark) '(Option Some (Position new 2 0)))
  (step! 'x '(x other-window))
  (at! 'x '(3 0) '(0 0))
  (step! 'x '(x buffer-start))
  (step! 'x '(x insert "Y"))
  (same '((x editor) mark) '(Option Some (Position new 2 0)))
  (same '((x text) current-line) "YXline 0"))

(test-case "a direct entry during a prompt keeps the cursor on the echo row"
  (nearby! 'p)
  (step! 'p '(p handle-key "ctrl-x"))
  (step! 'p '(p handle-key "find"))
  (check-true (ev '((p prompt) present?)))
  (step! 'p '(p other-window))
  (selected! 'p 1)
  (at! 'p '(3 0) '(0 0))
  (check-true (ev '((p prompt) present?)))
  (step! 'p '(p ensure-visible 80 24))
  ;; The echo row holds "Find file: /cwd/", 16 cells.
  (check-equal? (final-cursor (frame-of 'p)) '(24 17))
  (step! 'p '(p handle-key "escape"))
  (check-false (ev '((p prompt) present?)))
  (check-equal? (final-cursor (frame-of 'p)) '(16 1)))

(test-case "one view frames and edits as before"
  (define inserted (append '("line 0" "line 1" "line 2!") (drop lines100 3)))
  (define edited (append '("line 0" "line 1" "line 2!" "") (drop lines100 3)))
  (check-equal? (frame-of 's0) (one-view lines100 0 0 0))
  (step! 'o 's0)
  (for ([send '(move-down move-down line-end)])
    (step! 'o `(o ,send))
    (step! 'o '(o ensure-visible 80 24)))
  (check-equal? (frame-of 'o) (one-view lines100 0 2 6))
  (step! 'o '(o insert "!"))
  (step! 'o '(o ensure-visible 80 24))
  (check-equal? (frame-of 'o) (one-view inserted 0 2 7))
  (step! 'o '(o newline))
  (step! 'o '(o page-down))
  (step! 'o '(o ensure-visible 80 24))
  (at! 'o '(24 0) '(3 0))
  (check-equal? (frame-of 'o) (one-view edited 3 24 0))
  (step! 'o '(o undo))
  (step! 'o '(o ensure-visible 80 24))
  (at! 'o '(2 7) '(0 0))
  (check-equal? (frame-of 'o) (one-view inserted 0 2 7))
  (same '((o windows) tree) (leaf 0 0 '(2 7) '(0 0))))

(test-case "runner: C-x o shows the second column at its own top"
  (define keys '("ctrl-x" "3" "ctrl-x" "3" "ctrl-x" "3" "buffer-end" "ctrl-x" "o" "escape"))
  (define writes '())
  (define remaining keys)
  (define out (make-output-port 'window-point always-evt
    (lambda (bytes start end _non-block? _breakable?)
      (unless (= start end)
        (set! writes (append writes (list (bytes->string/utf-8 (subbytes bytes start end))))))
      (- end start)) void))
  (define term (make-term-receiver out
    (lambda () (define key (car remaining)) (set! remaining (cdr remaining)) key)
    (lambda () (values 80 24))))
  (run-aloemacs-with-hosts term (fs-double) "/cwd/lines.txt")
  (check-equal? remaining '())
  (check-equal? (length writes) (length keys))
  ;; Before C-x o the first column shows the end; after it, the second
  ;; column shows the top with the cursor there.
  (check-equal? (final-cursor (list-ref writes 7)) '(22 8))
  (define after-o (list-ref writes 9))
  (check-equal? (substring (car (frame-rows after-o)) 0 10) "line 78   ")
  (check-equal? (substring (car (frame-rows after-o)) 11 20) "line 0   ")
  (check-equal? (final-cursor after-o) '(1 12)))
