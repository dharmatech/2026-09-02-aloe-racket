;; examples/mpl/session.aloe
;; Expected output is what the REPL prints after show (checkpoint 51).
;; Load examples/mpl/core.aloe first; x and y are (Sym new "x") / "y".

(load "examples/mpl/core.aloe")
(define x (Sym new "x"))
(define y (Sym new "y"))

x
; => x

y
; => y

(x + 2)
; => (x + 2)

(x + y)
; => (x + y)

((x + 2) + 3)
; => (x + 5)

((x + 2) + x)
; => ((x * 2) + 2)

(((x + 2) + x) + x)
; => ((x * 3) + 2)

((x + 2) + y)
; => ((y + x) + 2)

(x * 2)
; => (x * 2)

((x * 2) * 3)
; => (x * 6)

(x * y)
; => (x * y)

((x * 2) * y)
; => ((y * x) * 2)

(x ^ 2)
; => (x ^ 2)

(x * x)
; => (x ^ 2)

((x ^ 2) * (x ^ 3))
; => (x ^ 5)

(x ^ 0)
; => 1

(x + 0)
; => x

(x * 0)
; => 0

(x * 1)
; => x

(x ^ 1)
; => x

((x * 2) + (x * 3))
; => (x * 5)

((x ^ 2) * x)
; => (x ^ 3)

((x * y) * x)
; => ((x ^ 2) * y)

((x + 2) + (x + 3))
; => ((x * 2) + 5)

((x * -3) + (x * 3))
; => 0

((x ^ 2) * (x ^ -2))
; => 1

